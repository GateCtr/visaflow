modules = ["nodejs-20", "web", "bash", "python-base-3.13"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/slot-hunter: Slot Hunter"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/captcha-service: Captcha Service"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/proxy-service: Proxy Service"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/joventy: web"

[[workflows.workflow]]
name = "artifacts/slot-hunter: Slot Hunter"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "redis-server --daemonize yes --logfile /tmp/redis.log; cd artifacts/slot-hunter && node_modules/.bin/tsx watch src/index.ts"

[[workflows.workflow]]
name = "artifacts/captcha-service: Captcha Service"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/captcha-service && PORT=3001 node_modules/.bin/tsx watch src/index.ts"

[[workflows.workflow]]
name = "artifacts/proxy-service: Proxy Service"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/proxy-service && PORT=3002 node_modules/.bin/tsx watch src/index.ts"

[[workflows.workflow]]
name = "artifacts/joventy: web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/joventy && pnpm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

