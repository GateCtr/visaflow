modules = ["nodejs-20", "web", "bash"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/slot-hunter: Slot Hunter"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/captcha-service: Captcha Service"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/proxy-service: Proxy Service"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/joventy: web"

[[workflows.workflow]]
name = "artifacts/slot-hunter: Slot Hunter"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "export LD_LIBRARY_PATH=\"/nix/store/wilz94hzz4q3fss6qvv625zvww4a6s4s-mesa-libgbm-25.0.1/lib:/nix/store/x4dg7qhdg1yvnz1cwavs4r29ij8vfx23-libudev-zero-1.0.3/lib:$LD_LIBRARY_PATH\"; /nix/store/pnc74r60iz1g5bpqv4qh76a8cc3g0n97-redis-7.2.10/bin/redis-server --bind 127.0.0.1 --daemonize yes --logfile /tmp/redis.log; sleep 2 && cd artifacts/slot-hunter && (ls /home/runner/.cache/puppeteer/chrome/linux-149.0.7827.22/chrome-linux64/chrome 2>/dev/null || node_modules/.bin/puppeteer browsers install chrome) && node_modules/.bin/tsx watch src/index.ts"

[[workflows.workflow]]
name = "artifacts/captcha-service: Captcha Service"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/captcha-service && PORT=3001 node_modules/.bin/tsx watch src/index.ts"

[[workflows.workflow]]
name = "artifacts/proxy-service: Proxy Service"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/proxy-service && PORT=3002 node_modules/.bin/tsx watch src/index.ts"

[[workflows.workflow]]
name = "artifacts/joventy: web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/joventy && pnpm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

