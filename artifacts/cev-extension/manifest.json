{
  "manifest_version": 3,
  "name": "CEV Slot Hunter",
  "version": "4.0.0",
  "description": "Round-robin multi-dossiers · 1 min + jitter humain · Anti-shadowban · Non détectable.",
  "permissions": [
    "storage",
    "notifications",
    "activeTab",
    "tabs",
    "alarms",
    "offscreen",
    "scripting"
  ],
  "host_permissions": [
    "https://visaonweb.diplomatie.be/*",
    "https://appointment.cloud.diplomatie.be/*",
    "https://api.anti-captcha.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://visaonweb.diplomatie.be/*"],
      "js": ["content-vowint.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://appointment.cloud.diplomatie.be/*"],
      "js": ["content-cev.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
