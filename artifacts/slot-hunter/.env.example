# === REQUIRED ===
# Base URL of your Convex HTTP deployment (e.g. https://famous-albatross-420.convex.site)
CONVEX_SITE_URL=https://famous-albatross-420.convex.site

# API key set in Convex via: npx convex env set HUNTER_API_KEY <your-key>
HUNTER_API_KEY=your_hunter_api_key_here

# === OPTIONAL ===
# Residential proxy URL (Bright Data, Smartproxy, etc.)
# Format: http://user:password@proxy-host:port
# PROXY_URL=http://user:pass@proxy.example.com:8000

# ── SOAX Residential Proxy ─────────────────────────────────────────────────
# Format: http://username:password@proxy.soax.com:9000
# Les paramètres de ciblage (country, city, session) sont ajoutés automatiquement au password.
# SOAX_PROXY_URL=http://your_username:your_password@proxy.soax.com:9000
# SOAX_COUNTRY=cd
# SOAX_CITY=kinshasa
# SOAX_SESSION_TIME=5
# SOAX_FALLBACK_COUNTRIES=za,ke,ng

# ── IPRoyal Residential Proxy ──────────────────────────────────────────────
# Format: http://user:pass_country-cd_city-kinshasa@geo.iproyal.com:12321
# IPROYAL_PROXY_URL=http://user:pass@geo.iproyal.com:12321
# IPROYAL_API_TOKEN=your_iproyal_api_token
# IPROYAL_USER_HASH=your_iproyal_user_hash

# ── BrightData Residential Proxy ──────────────────────────────────────────
# Format: http://brd-customer-XXX-zone-YYY:PASSWORD@brd.superproxy.io:33335
# BRIGHTDATA_RESIDENTIAL_PROXY_URL=http://brd-customer-xxx-zone-yyy:pass@brd.superproxy.io:33335
# BRIGHTDATA_PROXY_URL=http://brd-customer-xxx-zone-yyy:pass@brd.superproxy.io:33335
# BRIGHTDATA_API_KEY=your_brightdata_api_key
# BRIGHTDATA_ZONE_NAME=residential_proxy1
# BRIGHTDATA_COUNTRY=cd
# BRIGHTDATA_FALLBACK_COUNTRIES=za,ke,ng

# Redis Cloud — persistance des sessions USA (évite re-login au restart)
# Option 1: URL complète
# REDIS_URL=redis://default:password@host:port
# Option 2: Variables séparées
# REDIS_HOST=redis-13995.c9.us-east-1-4.ec2.cloud.redislabs.com
# REDIS_PORT=13995
# REDIS_USERNAME=default
# REDIS_PASSWORD=your_redis_password_here

# ── Scrape.do (test bypass CF citaconsular.es) ───────────────────────────────
# SCRAPE_DO_TOKEN=your_scrape_do_api_token
# SCRAPE_DO_SUPER=1          # proxy résidentiel (recommandé pour Cloudflare)
# SCRAPE_DO_GEO=es           # géo cible

# ── Spain HTTP-Only Mode (SOAX + CapSolver) ────────────────────────────────
# Active le scan Espagne 100% HTTP (pas de Playwright).
# Proxy recommandé : Decodo ISP (IP fixe) via DECODO_PROXY_URL.
# Fallback : SOAX_PROXY_URL + SPAIN_SOAX_COUNTRY=es.
# Prérequis : DECODO_PROXY_URL (ou SOAX_PROXY_URL) + CAPSOLVER_API_KEY
# SPAIN_HTTP_MODE=1
# DECODO_PROXY_URL=http://username:password@gate.decodo.com:10000
# En HTTP-only, CapSolver est utilisé par défaut avec ce même proxy.
# Option de diagnostic uniquement : SPAIN_HTTP_SESSION_MODE=playwright
# SPAIN_SOAX_COUNTRY=es
# SPAIN_SOAX_CITY=

# ── Spain — Mode meute / éclaireur (spain-eclaireur) ────────────────────────
# Optimisation ADDITIVE, OFF par défaut → prod historique strictement inchangée.
# Prérequis : Redis PARTAGÉ entre tous les workers (coordination via NX/snapshot).
#   - Redis indisponible → dégradé sûr : tous redeviennent éclaireur (aucun gain, pas de casse).
#   - Plusieurs dossiers sur le MÊME portail pour qu'une meute existe (1 seul dossier = éclaireur).
#
# SPAIN_MEUTE_MODE=1 : l'orchestrateur désigne 1 éclaireur par portail (claimSentinelRole,
#   Redis NX, TTL 30 min) ; les autres dossiers du portail deviennent "meute". L'éclaireur
#   détecte les créneaux (datetime/) et publie un snapshot Redis ; la meute lit le snapshot,
#   SAUTE datetime/, et booke directement. Réduit fortement le travail des workers meute.
# SPAIN_MEUTE_MODE=1
#
# SPAIN_ECLAIREUR_SHORTSCAN=1 : les cycles de scan de l'éclaireur passent par GET widget →
#   datetime/ direct (IDs connus via getKnownIdsForPortal) au lieu du cycle complet. Cycle
#   de scan ~1,8 s au lieu de ~8,6 s. Fallback auto sur le cycle complet si IDs inconnus.
# SPAIN_ECLAIREUR_SHORTSCAN=1
#
# Note : le captcha obligatoire (Kinshasa, Cuba) est géré automatiquement en mode réduit via
# portalRequiresCaptcha (pas de flag) — le gct reste envoyé au signin/.
#
# ── SPAIN_SCOUT_POOL — Pool d'éclaireurs DÉDIÉS (recommandé pour la meute) ──────
# SPAIN_SCOUT_POOL=1 : démarre un pool d'éclaireurs dédiés, INDÉPENDANTS des dossiers
#   clients. Ils ne bookent JAMAIS : ils scannent datetime/ en continu et sont l'écrivain
#   UNIQUE du snapshot Redis (la meute ne republie plus → plus de snapshot figé sur des
#   créneaux déjà pris). Quand ce flag est actif, TOUS les dossiers deviennent "meute".
#   Redondance anti-panne : plusieurs scouts sur des proxies distincts → si un proxy meurt,
#   les autres maintiennent la fraîcheur du snapshot (pas de trou pendant un re-solve CF).
# SPAIN_SCOUT_POOL=1
#
# SPAIN_SCOUT_COUNT       : nombre d'éclaireurs dédiés (défaut 3, borné [1,10]).
# SPAIN_SCOUT_PORTAL_URL  : portail cible (défaut = Kinshasa). Un seul portail pour l'instant.
# SPAIN_SCOUT_FAST_TICK_MS: cadence de scan en fenêtre de publication (défaut 2500 ms).
# SPAIN_SCOUT_IDLE_TICK_MS: borne max du sommeil hors fenêtre (défaut 45000 ms). Les scouts ne
#   scannent PLUS hors fenêtre (arrêt total) ; cette valeur ne sert qu'à re-vérifier l'arrêt du pool.
# SPAIN_SCOUT_FAST_START_MIN / SPAIN_SCOUT_FAST_END_MIN : bornes minute-dans-l'heure de la
#   fenêtre rapide (Europe/Madrid). Début aligné sur le worker : défaut = SPAIN_WINDOW_START_MIN
#   (HH:03). Fin = HH:15 (exclue) : les scouts s'ARRÊTENT TOTALEMENT à HH:15 (pic HH:13 passé) et
#   dorment jusqu'au prochain HH:03 — ils ne vont jamais jusqu'à la fin de fenêtre worker (HH:18).
#
# SPAIN_SNAPSHOT_FRESH_MAX_SEC : âge max (s) d'un snapshot encore digne de confiance côté
#   meute. Au-delà (les scouts ont cessé de publier → créneaux épuisés/pris), la meute refait
#   son propre datetime/ au lieu de booker sur des données mortes. Défaut 8.

# Set to "true" to simulate sessions without actually booking slots
# DRY_RUN=true

# ── Bird (MessageBird) — Notifications WhatsApp ────────────────────────────
# Clé API Bird pour l'envoi de messages WhatsApp (templates pré-approuvés).
# Format : bk_xxxxxxxxx (US) ou bk_eu1_xxxxxxxxx (EU) — la région est déduite du préfixe.
# Obtenir la clé dans le dashboard Bird → Settings → API Keys.
# BIRD_API_KEY=bk_xxxxxxxxx

# ── CEV Belgique — scan synchronisé (coordination inter-comptes) ────────────
# Ces réglages sont OPTIONNELS (valeurs par défaut sûres). Ils pilotent la
# synchronisation des comptes CEV sur grille d'horloge murale + le mode RACE.
#
# Pourcentage de jitter appliqué au front de grille (fraction du tick), borné [0, 0.5].
# Casse le pattern régulier sans casser l'alignement des comptes. Défaut: 0.15.
# CEV_GRID_JITTER_PCT=0.15
#
# Seuil du mode RACE : si le nombre de créneaux distincts détectés est <= ce seuil,
# le claim Redis est contourné et tous les comptes foncent (le serveur CEV arbitre).
# Évite qu'un compte attende pendant qu'un concurrent rafle le seul créneau.
# Borné [1, 10000]. Défaut: 5.
# CEV_RACE_MODE_SLOT_THRESHOLD=5
