# === REQUIRED ===
# Base URL of your Convex HTTP deployment (e.g. https://famous-albatross-420.convex.site)
CONVEX_SITE_URL=https://famous-albatross-420.convex.site

# API key set in Convex via: npx convex env set HUNTER_API_KEY <your-key>
HUNTER_API_KEY=your_hunter_api_key_here

# === OPTIONAL ===
# Residential proxy URL (Bright Data, Smartproxy, etc.)
# Format: http://user:password@proxy-host:port
# PROXY_URL=http://user:pass@proxy.example.com:8000

# ── SOAX Residential Proxy ─────────────────────────────────────────────────
# Format: http://username:password@proxy.soax.com:9000
# Les paramètres de ciblage (country, city, session) sont ajoutés automatiquement au password.
# SOAX_PROXY_URL=http://your_username:your_password@proxy.soax.com:9000
# SOAX_COUNTRY=cd
# SOAX_CITY=kinshasa
# SOAX_SESSION_TIME=5
# SOAX_FALLBACK_COUNTRIES=za,ke,ng

# ── IPRoyal Residential Proxy ──────────────────────────────────────────────
# Format: http://user:pass_country-cd_city-kinshasa@geo.iproyal.com:12321
# IPROYAL_PROXY_URL=http://user:pass@geo.iproyal.com:12321
# IPROYAL_API_TOKEN=your_iproyal_api_token
# IPROYAL_USER_HASH=your_iproyal_user_hash

# ── BrightData Residential Proxy ──────────────────────────────────────────
# Format: http://brd-customer-XXX-zone-YYY:PASSWORD@brd.superproxy.io:33335
# BRIGHTDATA_RESIDENTIAL_PROXY_URL=http://brd-customer-xxx-zone-yyy:pass@brd.superproxy.io:33335
# BRIGHTDATA_PROXY_URL=http://brd-customer-xxx-zone-yyy:pass@brd.superproxy.io:33335
# BRIGHTDATA_API_KEY=your_brightdata_api_key
# BRIGHTDATA_ZONE_NAME=residential_proxy1
# BRIGHTDATA_COUNTRY=cd
# BRIGHTDATA_FALLBACK_COUNTRIES=za,ke,ng

# Redis Cloud — persistance des sessions USA (évite re-login au restart)
# Option 1: URL complète
# REDIS_URL=redis://default:password@host:port
# Option 2: Variables séparées
# REDIS_HOST=redis-13995.c9.us-east-1-4.ec2.cloud.redislabs.com
# REDIS_PORT=13995
# REDIS_USERNAME=default
# REDIS_PASSWORD=your_redis_password_here

# ── Spain HTTP-Only Mode (SOAX + CapSolver) ────────────────────────────────
# Active le scan Espagne 100% HTTP (pas de Playwright).
# Prérequis : SOAX_PROXY_URL + CAPSOLVER_API_KEY
# SPAIN_HTTP_MODE=1
# SPAIN_SOAX_COUNTRY=es
# SPAIN_SOAX_CITY=

# Set to "true" to simulate sessions without actually booking slots
# DRY_RUN=true
