{
  "name": "@workspace/slot-hunter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "postinstall": "node -e \"if (process.env.VERCEL) process.exit(0); const cmd = process.env.REPL_ID ? 'playwright install chromium' : 'playwright install chromium --with-deps'; require('child_process').execSync(cmd, {stdio: 'inherit'})\"",
    "security:check": "tsx src/securityCheck.ts",
    "security:check:full": "FULL_CHECK=true tsx src/securityCheck.ts",
    "es:citaconsular:discover": "tsx src/citaconsularDiscovery.ts"
  },
  "dependencies": {
    "@workspace/proxy-service": "workspace:*",
    "dotenv": "^16.4.5",
    "playwright": "^1.49.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "undici": "^7.24.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
