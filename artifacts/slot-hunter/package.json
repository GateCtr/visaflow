{
  "name": "@workspace/slot-hunter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "prepare:browsers": "node -e \"if (process.env.VERCEL) process.exit(0); const cmd = process.env.REPL_ID ? 'playwright install chromium' : 'playwright install chromium --with-deps'; require('child_process').execSync(cmd, {stdio: 'inherit'})\"",
    "security:check": "tsx src/securityCheck.ts",
    "security:check:full": "FULL_CHECK=true tsx src/securityCheck.ts",
    "es:citaconsular:discover": "tsx src/citaconsularDiscovery.ts",
    "cloudflare:test": "tsx test-cloudflare-strategies.ts",
    "cloudflare:integrate": "tsx test-cloudflare-integration.ts",
    "cloudflare:solution": "tsx final-solution-spain.ts",
    "cloudflare:capture": "tsx final-solution-spain.ts --capture",
    "cloudflare:test-proxy": "tsx test-proxy-formats.ts",
    "cloudflare:test-capsolver": "tsx test-capsolver-iproyal.ts",
    "cloudflare:test-brightdata": "tsx test-capsolver-cloudflare.ts",
    "cloudflare:setup-fixed-ip": "tsx setup-fixed-ip-proxy.ts",
    "cloudflare:test-fixed-ip": "tsx test-brightdata-fixed-ip.ts",
    "cloudflare:test-isp": "tsx test-isp-proxy-capsolver.ts",
    "cloudflare:test-simple-isp": "tsx test-simple-isp.ts",
    "cloudflare:setup": "tsx setup-fixed-ip-proxy.ts",
    "cloudflare:test-datacenter": "tsx test-datacenter-fixed.ts",
    "cloudflare:test-fixed-format": "tsx test-capsolver-fixed-format.ts",
    "cloudflare:test-unified": "tsx test-unified-cloudflare.ts",
    "cloudflare:capture-manual": "tsx capture-manual-cookie.ts",
    "cloudflare:test-hybrid": "tsx test-hybrid-solution.ts",
    "spain:capture": "tsx scripts/spain-manual-capture.ts",
    "spain:capture:manual": "tsx scripts/spain-manual-capture.ts",
    "spain:analyze": "tsx scripts/analyze-spain-capture.ts",
    "spain:analyze:latest": "tsx scripts/analyze-spain-capture.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "impit": "^0.14.0",
    "playwright": "^1.49.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "undici": "^7.24.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
