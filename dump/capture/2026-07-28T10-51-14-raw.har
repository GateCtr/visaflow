unction(){\n            if(typeof oClientValues_248295.signedInData !== 'undefined'){\n                return true;\n            }\n            \n            return false;\n        },\n        checkShowFooter: function(){\n            this.widgetconfiguration = new WidgetConfiguration();\n            \n            var bFirstAppointment = (typeof oClientValues_248295.widgetconfiguration.registration_type !== 'undefined' && parseInt(oClientValues_248295.widgetconfiguration.registration_type) === this.widgetconfiguration.iFirstAppointment) ? true : false;\n            \n            if(bFirstAppointment){\n                this.$el.hide();\n            }\n        }\n    });\n    \n    return AccountContainer;\n});\n"},"headersSize":0,"bodySize":1346,"redirectURL":"","_transferSize":1346},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":133.707,"receive":7.904},"serverIPAddress":"104.21.33.147","_serverPort":443,"_securityDetails":{"protocol":"QUIC","subjectName":"citaconsular.es","issuer":"YE1","validFrom":1782411374,"validTo":1790187373}},{"pageref":"page@4c8482ae0c152ace4fc1275d34cb3f97","startedDateTime":"2026-07-28T10:47:47.901Z","time":143.224,"request":{"method":"GET","url":"https://www.citaconsular.es/js/backbone/underscore.js?v=4","httpVersion":"h3","cookies":[{"name":"PHPSESSID","value":"kbJgrwkUzB97mXXLa9SC4iJm"},{"name":"cf_chl_rc_ni","value":"1"},{"name":"cf_clearance","value":"OA_9FecTs0x5m6Ela.VYni1aOxDmUND1zFfQEJ1h4cI-1785235664-1.2.1.1-y4wNbvM1YjN6YolMglcw0qzTm5jYWvKgYMq_mXMqeHTt7OKPglz_73urRtP_7yHTmuQmM214b0xZg45rDQOtA.pXikDTTJLxKD.3BSvul16Caop4KjEzZjGjo0DqERV8T5XIVu3PIeXJe87YWl6EDrv7lBErbDyyiMRGITPpWMOOy7U09HrJQ03IgqaND2xPWZBF427N5AW46UNdEHQXA7LTNiQDG6VMWT5apocT8e1CLeH8eAwlNkfpcv9ij.jdIKPHeXarKwWMKrjSdggKGHpDxrMRIUyKgFGOzqkXWT7hQp.xp566pwlBIzfaADvRgAqsgYTSw9ZYnJT3_ioyB7zBdr0vbZKU1iBsm9YSKHMpffTyfJVc_x7lkeI0OQDLElIBQvcgWEhoExS6dlXR537oKwgv3s2FqKDh81UpfUkp92ZPEMeHigZaJCIlTyGSjhsTaLof_aNkuIhLSPQDBQ"}],"headers":[{"name":":authority","va