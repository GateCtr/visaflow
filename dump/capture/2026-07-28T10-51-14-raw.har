ents);}\\r\\n  gtag('js', new Date());\\r\\n\\r\\n  gtag('config', 'G-6XR9R9RBSH');\\r\\n<\\/script>      \\r\\n-->\\r\\n\\r\\n\\r\\n    <!-- Google Tag Manager PONER EN EL HEAD-->\\r\\n    <script>\\r\\n        (function(w,d,s,l,i){\\r\\n            w[l]=w[l]||[];\\r\\n            w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});\\r\\n            var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';\\r\\n            j.async=true;\\r\\n            j.src='https:\\/\\/www.googletagmanager.com\\/gtm.js?id='+i+dl;\\r\\n            f.parentNode.insertBefore(j,f); \\r\\n        })(window,document,'script','dataLayer', 'GTM-K4N8R5C');\\r\\n    <\\/script>\\r\\n    <!-- End Google Tag Manager -->\\r\\n\\r\\n    <!-- Google Tag Manager (noscript) PONER EN EL BODY-->\\r\\n    <noscript>\\r\\n        <iframe src='https:\\/\\/www.googletagmanager.com\\/ns.html?id=GTM-K4N8R5C' height='0' width='0' style='display:none;visibility:hidden'><\\/iframe>\\r\\n    <\\/noscript>\\r\\n    <!-- End Google Tag Manager (noscript) -->        \\r\\n\\r\\n    <script type=\\\"text\\/javascript\\\">\\r\\n        sBktWidgetGoogleAnalyticsId = \\\"G-F3TYSDL945\\\";\\r\\n    <\\/script>\\r\\n        \\r\\n    <script src=\\\"https:\\/\\/hcaptcha.com\\/1\\/api.js\\\" async defer><\\/script>\\r\\n    \\r\\n    <script type=\\\"text\\/javascript\\\">\\r\\n        var widgetBktHCaptchaSignUp;\\r\\n        var widgetBktHCaptchaSignIn;\\r\\n        \\r\\n        var onLoadBktHCaptchaSignUp = function(){\\r\\n            if(jQuery('#idDivHCaptchaSignUp').length){\\r\\n                widgetBktHCaptchaSignUp = hcaptcha.render('idDivHCaptchaSignUp', {\\r\\n                    'sitekey' : '38663b6a-85dc-4346-965e-f066cd8e7d26',\\r\\n                    'callback' : onHCaptchaSubmitedSignUp\\r\\n                });                \\r\\n            }\\r\\n        };\\r\\n\\r\\n        var onHCaptchaSubmitedSignUp = function(){\\r\\n            $('#idDivHCaptchaSignUp').click();\\r\\n        };\\r\\n\\r\\n        var onLoadBktHCaptchaSignIn = function(){\\r\\n            if(jQuery('#idDivHCaptchaSignIn').length){\\r\\n                widgetBktHCaptchaSignIn = hcaptcha.render('idDivHCaptchaSignIn', {\\r\\n                    'sitekey' : '38663b6a-85dc-4346-965e-f066cd8e7d26',\\r\\n                    'callback' : onHCaptchaSubmitedSignIn\\r\\n                });                \\r\\n            }\\r\\n        };\\r\\n        \\r\\n        var onHCaptchaSubmitedSignIn = function(){\\r\\n            $('#idDivHCaptchaSignIn').click();\\r\\n        };\\r\\n        \\r\\n        \\/\\/# sourceURL=captcha.js\\r\\n    <\\/script>\\r\\n        \\r\\n<div id=\\\"idBktWidgetDefaultBodyContainer\\\" style=\\\"display: none\\\" class=\\\"clsBktWidgetVersion4\\\" data-template=\\\"1\\\">\\r\\n    <div id=\\\"idBktWidgetDefaultHeader\\\">\\n        \\n    \\n    <div id=\\\"idBktWidgetDefaultHeaderCenterName\\\">\\n        <div id=\\\"idBktWidgetDefaultHeaderCenterNameText\\\">\\n            Consulado General de Espa\\u00f1a en La Habana (Cuba) - V3 - Visados A\\/C    \\n        <\\/div>\\n    <\\/div>\\n    \\n    <div id=\\\"idBktWidgetDefaultHeaderLanguageSelector\\\" style=\\\"display:none;\\\" >\\n    <div id=\\\"idBktWidgetDefaultHeaderLanguageSelectorText\\\">\\n        <select id=\\\"idBktWidgetDefaultLanguageSel\\\">\\n                         <option class=\\\"clsOptionLanguageBorder\\\" value=\\\"en\\\">EN - English<\\/option>\\n                         <option class=\\\"clsOptionLanguageBorder\\\" value=\\\"es\\\">ES - Spanish<\\/option>\\n                         <option class=\\\"clsOptionLanguageBorder\\\" value=\\\"it\\\">IT - Italian<\\/option>\\n                         <option class=\\\"clsOptionLanguageBorder\\\" value=\\\"pt\\\">PT - Portuguese<\\/option>\\n                         <option class=\\\"clsOptionLanguageBorder\\\" value=\\\"ca\\\">CA - Catalan<\\/option>\\n                         <option class=\\\"clsOptionLanguageBorder\\\" value=\\\"uk\\\">UK - Ukrainian<\\/option>\\n                         <option class=\\\"clsOptionLanguageBorder\\\" value=\\\"de\\\">DE - German<\\/option>\\n                         <option class=\\\"clsOptionLanguageBorder\\\" value=\\\"ko\\\">KO - Korean<\\/option>\\n                         <option class=\\\"clsOptionLanguageBorder\\\" value=\\\"fr\\\">FR - French<\\/option>\\n                         <option class=\\\"clsOptionLanguageBorder\\\" value=\\\"eu\\\">EU - Basque<\\/option>\\n                \\n        <\\/select>\\n    <\\/div>\\n\\n    <div class=\\\"clsCB\\\"><\\/div>\\n<\\/div>\\n    \\n    <div class=\\\"clsCB\\\"><\\/div>\\n<\\/div>    \\r\\n    <div id=\\\"idBktWidgetDefaultContainer\\\">\\r\\n        <div id=\\\"idBktWidgetDefaultContent\\\">\\r\\n            <script type='text\\/template' id='idTemFieldCustomSelect'>\\n    <div class=\\\"clsDivFieldCustomContainer\\\">\\n        <div class=\\\"clsDivFieldCustomLabel\\\">\\n            <%= attributes.text %>\\n        <\\/div>\\n\\n        <div class=\\\"clsDivFieldCustomInput\\\">\\n            <select class=\\\"clsFieldCustomInputSelect\\\" id=\\\"<%= attributes.id %>\\\">\\n                <%\\n                if(typeof attributes.select_min_text !== 'undefined'){ %>\\n                    <option value=\\\"-1\\\"><%= attributes.select_min_text %><\\/option>\\n                <%\\n                }\\n                \\n                for(var i = attributes.select_min ; i <= attributes.select_max ; i = i + attributes.select_increment){ %>\\n                    <option value=\\\"<%= i %>\\\"><%= i %><\\/option>\\n                <%\\n                } %>\\n            <\\/select>        \\n        <\\/div>\\n    <\\/div>\\n<\\/script>\\n\\n<div id='idBktDefaultCustomContainer' class='clsBktDefaultWindow' style='display:none;'>   \\n    <div id=\\\"idBktDefaultCustomContent\\\">\\n        <div id=\\\"idDivBktDefaultCustomFieldsContent\\\"><\\/div>\\n\\n        <div id='idDivBktButtonCustomContinueContainer'>\\n            <div id=\\\"idDivBktCustomContinueButton\\\" class='clsDivContinueButton'>\\n                Continuar            <\\/div>\\n        <\\/div>\\n    <\\/div>\\n<\\/div><script type='text\\/template' id='idTemSelectPeople'>\\r\\n    <option value='<%= value %>'><%= people %><\\/option>\\r\\n<\\/script>\\r\\n\\r\\n<script type='text\\/template' id='idTemSelectServices'>\\r\\n    <% if(showGroup === true){ %>\\r\\n        <div class=\\\"clsBktServiceGroupName clsBktServiceAttGroup-<%= attributes.groups_id %>\\\" data-service-group=\\\"<%= attributes.groups_id %>\\\">\\r\\n            <%= attributes.groupname %>\\r\\n        <\\/div>\\r\\n    <% } %>\\r\\n    \\r\\n    <%\\r\\n    if(attributes.show_description_class !== 'undefined' && attributes.show_description_class.length > 0){ %>\\r\\n        <a href='#selectservice\\/<%= attributes.id %>' class=\\\"<%= attributes.show_extraservice_class %>\\\">\\r\\n            <div class=\\\"clsBktServiceDataContainer clsBktServiceAttMultiserviceNumber-<%= attributes.multiservice_number %> clsBktServiceAttMultiservice-<%= attributes.multiservice %> clsBktServiceAttParentGroup-<%= attributes.groups_id %> <%= attributes.show_description_class %>\\\" data-min-people = \\\"<%= parseInt(attributes.multiservice_number_min) %>\\\">\\r\\n                <% if(attributes.multiselect == 1){ %>\\r\\n                    <div class=\\\"clsBktServiceCheckbox clsHP\\\">\\r\\n                        <input id='idCheckBox<%= attributes.id %>' type='checkbox' name='services[]' value='<%= attributes.id %>' \\/>\\r\\n                        <label for='idCheckBox<%= attributes.id %>'>\\r\\n                    <\\/div>\\r\\n                <% } %>\\r\\n\\r\\n                <% if(attributes.video_call != 0){ %>\\r\\n                    <div class=\\\"clsBktServiceVideoCall clsHP\\\"><\\/div>\\r\\n                <% } %>\\r\\n\\r\\n                <div class=\\\"clsBktServiceName clsHP\\\">\\r\\n                    <%= attributes.name %>\\r\\n                <\\/div>\\r\\n\\r\\n                <% if(attributes.public_price == 1){ %>\\r\\n                    <div class=\\\"clsBktServicePublicPrice clsHP clsTextGreen\\\">\\r\\n                        <% if(attributes.price_conf_type == 2 && attributes.min_price !== null){ %>\\r\\n                            Desde <%= attributes.min_price %><%\\/\\/= attributes.symbol %>\\r\\n                        <% }\\r\\n                        else{ %>\\r\\n                                                            <%= attributes.price_no_prepay %><%\\/\\/= attributes.symbol %>\\r\\n                                                    <% } %>\\r\\n                    <\\/div>\\r\\n                <% } %>\\r\\n\\r\\n                <div class='clsCB'><\\/div>\\r\\n                \\r\\n                <% if(attributes.description !== null && attributes.description.length > 0){ %>\\r\\n                    <div class=\\\"clsBktServiceDescription\\\">\\r\\n                        <%= attributes.description %>\\r\\n                    <\\/div>\\r\\n                <% } %>\\r\\n            <\\/div>\\r\\n        <\\/a>\\r\\n    <%\\r\\n    }\\r\\n    else{ %>\\r\\n        <div class=\\\"clsBktServiceDataContainer clsBktServiceAttMultiserviceNumber-<%= attributes.multiservice_number %> clsBktServiceAttMultiservice-<%= attributes.multiservice %> clsBktServiceAttParentGroup-<%= attributes.groups_id %>\\\" data-min-people = \\\"<%= parseInt(attributes.multiservice_number_min) %>\\\">\\r\\n            <% if(attributes.multiselect == 1){ %>\\r\\n                <div class=\\\"clsBktServiceCheckbox clsHP\\\">\\r\\n                    <input id='idCheckBox<%= attributes.id %>' type='checkbox' name='services[]' value='<%= attributes.id %>' \\/>\\r\\n                    <label for='idCheckBox<%= attributes.id %>'>\\r\\n                <\\/div>\\r\\n            <% } %>\\r\\n\\r\\n            <% if(attributes.video_call != 0){ %>\\r\\n                <div class=\\\"clsBktServiceVideoCall clsHP\\\"><\\/div>\\r\\n            <% } %>\\r\\n\\r\\n            <div class=\\\"clsBktServiceName clsHP\\\">\\r\\n                <a href='#selectservice\\/<%= attributes.id %>' class=\\\"<%= attributes.show_extraservice_class %>\\\">\\r\\n                    <%= attributes.name %>\\r\\n                <\\/a>\\r\\n            <\\/div>\\r\\n\\r\\n            <% if(attributes.public_price == 1){ %>\\r\\n                <div class=\\\"clsBktServicePublicPrice clsHP clsTextGreen\\\">\\r\\n                    <% if(attributes.price_conf_type == 2 && attributes.min_price !== null){ %>\\r\\n                        Desde <%= attributes.min_price %><%\\/\\/= attributes.symbol %>\\r\\n                    <% }\\r\\n                       else{ %>\\r\\n                        <%= attributes.price_no_prepay %><%\\/\\/= attributes.symbol %>\\r\\n                    <% } %>\\r\\n                <\\/div>\\r\\n            <% } %>\\r\\n               \\r\\n            <div class='clsCB'><\\/div>\\r\\n        <\\/div>\\r\\n    <%\\r\\n    } %>\\r\\n<\\/script>\\r\\n\\r\\n<script type='text\\/template' id='idTemContinue'>\\r\\n    <a href='#selectservices'>\\r\\n        <div id=\\\"idDivBktServicesContinueButton\\\" class='clsDivContinueButton clsHPR'>\\r\\n            Continuar        <\\/div>\\r\\n\\r\\n        <div class='clsCB'><\\/div>\\r\\n    <\\/a>\\r\\n<\\/script>\\r\\n\\r\\n<script type='text\\/template' id='idTemBackToCustom'>\\r\\n    <div id='idBktServicesBackToCustomContainer'>\\r\\n        <a href='#custom'>\\r\\n            <div id='idBktServicesBackToCustomImage'><\\/div><div id='idBktServicesBackToCustomText'>Volver<\\/div>\\r\\n        <\\/a>\\r\\n    <\\/div>\\r\\n<\\/script>\\r\\n\\r\\n<script type='text\\/template' id='idTemSelectExtraServices'>\\r\\n    <div class=\\\"clsBktExtraServiceContainer\\\" data-service=\\\"<%= attributes.service %>\\\" data-extra=\\\"<%= attributes.id %>\\\">\\r\\n        <div class=\\\"clsBktExtraServiceContent\\\">\\r\\n            <% if(attributes.multiselect == 1){ %>\\r\\n                <div class=\\\"clsBktExtraServiceCheckboxContainer\\\">\\r\\n                    <input id='idCheckBox<%= attributes.id %>' type='checkbox' \\/>\\r\\n                    <label for='idCheckBox<%= attributes.id %>'>\\r\\n                <\\/div>\\r\\n            <% } %>\\r\\n\\r\\n            <div class=\\\"clsBktExtraServiceInfoContainer\\\">\\r\\n                <span class=\\\"clsBktExtraServiceName\\\">\\r\\n                    <%= attributes.name %>\\r\\n                <\\/span>\\r\\n\\r\\n                <% if(typeof attributes.price !== 'undefined' && attributes.price.length > 0){ %>\\r\\n                    <span class=\\\"clsBktExtraServicePrice\\\">\\r\\n                        <%= attributes.price %>\\r\\n                    <\\/span>\\r\\n                <% } %>                                        \\r\\n            <\\/div>\\r\\n        <\\/div>\\r\\n\\r\\n        <% if(attributes.description !== null && attributes.description.length > 0){ %>\\r\\n            <div class=\\\"clsBktExtraServiceDescription\\\">\\r\\n                <%= attributes.description %>\\r\\n            <\\/div>\\r\\n        <% } %>\\r\\n    <\\/div>\\r\\n<\\/script>\\r\\n\\r\\n<script type='text\\/template' id='idTemSelectSelectedService'>\\r\\n    <% if(attributes.separator === true){ %>\\r\\n        <span class=\\\"clsBktSummaryTextGrey clsBktSummaryTextBold\\\"> | <\\/span>\\r\\n    <% } %>    \\r\\n    \\r\\n    <span class=\\\"clsBktSummaryTextGrey\\\"><%= attributes.name %><\\/span>\\r\\n        \\r\\n    <% if(attributes.price !== null && attributes.price.length > 0){ %>\\r\\n        <span class=\\\"clsBktSummaryTextBlue\\\"><%= attributes.price %><\\/span>\\r\\n    <% } %>\\r\\n<\\/script>\\r\\n\\r\\n<!--<script type=\\\"text\\/javascript\\\">\\r\\n    var bUseAccordionServiceGroup = ;\\r\\n<\\/script>-->\\r\\n\\r\\n<div id='idBktDefaultServicesContainer' class='clsBktDefaultWindow' style='display:none;'>   \\r\\n    <div id='idBktDefaultServicesErrorContainer' class=\\\"clsBktDefaultErrorContainer\\\" style='display:none'>\\r\\n        <div id=\\\"idDivBktDefaultErrorServicesLoadingData\\\" class=\\\"clsBktDefaultErrorText\\\">\\r\\n            Se ha producido un error al cargar los datos        <\\/div>\\r\\n\\r\\n        <a href=''>\\r\\n            <div class='clsDivContinueButton clsDivBackErrorButton clsHPR'>\\r\\n                Volver            <\\/div>\\r\\n        <\\/a>\\r\\n\\r\\n        <div class='clsCB'><\\/div>\\r\\n    <\\/div>\\r\\n    \\r\\n    <div id=\\\"idBktDefaultServicesContent\\\">\\r\\n        <div id=\\\"idDivBktDefaultServicesMainContent\\\">\\r\\n            <div id='idDivBktNumberOfPeopleContainer' style='display:none'>\\r\\n                <div id='idDivBktNumberOfPeopleContainerText'>\\r\\n                    <span class='clsTextOrange'>\\r\\n                        N\\u00famero de asistentes                    <\\/span>\\r\\n                <\\/div>\\r\\n\\r\\n                <div id='idDivBktNumberOfPeopleContainerSelect'>\\r\\n                    <select id='idSelNumberOfPeople'><\\/select>\\r\\n                <\\/div>\\r\\n            <\\/div>\\r\\n\\r\\n            <div id='idDivBktServicesContainer'>                   \\r\\n\\t\\t\\t\\t<div style='display: none; text-align: center; font-size: 1.500em; font-weight: bold;'>No hay horas disponibles.<br>Int\\u00e9ntelo de nuevo dentro de unos d\\u00edas.<\\/div>\\t\\t\\t\\t\\r\\n                                    <div id=\\\"idBktDefaultServicesTextBeforeServicesList\\\">\\r\\n                        \\r\\n<div id='dialog-confirm' style='font-size: 16px; background-color: #f3f5f7; height: 100%; width: 100%; box-sizing: border-box; color: black !important; padding: 10px;' title='Importante \\/ Important'>\\r\\n<div style='text-align: center;'><span style='color: #ff0000; font-weight: bold; background-color: #ffff99;'><span style='color: #ff0000;'><strong>POR FAVOR:&nbsp; LEA ATENTAMENTE ESTE MENSAJE<\\/strong><\\/span><\\/span><\\/div>\\r\\n<br \\/>\\r\\n<div style='text-align: justify;'>\\r\\n<div style='font-weight: bold; line-height: 20px; font-size: 13px;'>1) Esta agenda est&aacute; destinada para la solicitud de citas de VISADOS SCHENGEN (Visados de Estancia).&nbsp;<br \\/><br \\/>2) Debido a dificultades t&eacute;cnicas en estos momentos no es posible cancelar las citas una vez las establezca. Estamos trabajando en mejorar el sistema.&nbsp;El sistema abrir&aacute; sus citas de viernes a lunes de cada semana. (durante el fin de semana)<\\/div>\\r\\n<div style='font-weight: bold; line-height: 20px; font-size: 13px;'>&nbsp;<\\/div>\\r\\n<div style='font-weight: bold; line-height: 20px; font-size: 13px;'>3) Si no puede acudir a una cita, tendr&aacute; que iniciar su solicitud de nuevo, siempre que haya transcurrido dos meses de su anterior solicitud por correo. Cualquier abuso detectado en el sistema provocar&aacute; su deshabilitaci&oacute;n en el sistema.<\\/div>\\r\\n<div style='font-weight: bold; line-height: 20px; font-size: 13px;'>&nbsp;<\\/div>\\r\\n<div style='font-weight: bold; line-height: 20px; font-size: 13px;'>4) Dispondr&aacute; de muchos d&iacute;as y horas, donde solicitar su cita. Busque la que sea mas adecuada para Ud.<\\/div>\\r\\n<div style='font-weight: bold; line-height: 20px; font-size: 13px;'>&nbsp;<\\/div>\\r\\n<div style='font-weight: bold; line-height: 20px; font-size: 13px;'>5) No olvide traer toda la documentaci&oacute;n el d&iacute;a de la cita, para lo que le recomendamos que lea lo que debe traer en la p&aacute;gina web del consulado (<a title='Pagina del consulado' href='https:\\/\\/www.exteriores.gob.es\\/Consulados\\/lahabana\\/es\\/ServiciosConsulares\\/Paginas\\/index.aspx?scco=Cuba&amp;scd=166&amp;scca=Visados&amp;scs=Visado+de+estancia+(visado+Schengen)'>&gt;&gt;&gt; AQUI &lt;&lt;&lt;<\\/a>)<\\/div>\\r\\n<div style='font-weight: bold; line-height: 20px; font-size: 13px;'>&nbsp;<\\/div>\\r\\n<div style='font-weight: bold; line-height: 20px; font-size: 13px;'>&nbsp;<\\/div>\\r\\n<div style='font-weight: bold; line-height: 20px; font-size: 13px;'><br \\/> Mediante la pulsaci&oacute;n del bot&oacute;n ACEPTAR Ud. declara aceptar, sin reserva, estas condiciones.<br \\/><br \\/>Muchas gracias por su colaboraci&oacute;n.<\\/div>\\r\\n<br \\/>\\r\\n<div id='bktContinue' style='text-align: center;'>\\r\\n<div style='color: #ffffff; padding: 5px 10px; background-color: #5185ed; display: inline-block;'>&nbsp; ACEPTAR &nbsp;<\\/div>\\r\\n<\\/div>\\r\\n<\\/div>\\r\\n<\\/div>\\r\\n\\r\\n<script type='text\\/javascript'>\\r\\n    jQuery(document).ready(function(){\\r\\n        jQuery('#idListServices').hide();\\r\\n\\r\\n        jQuery('#bktContinue').click(function(){\\r\\n            jQuery('#idBktDefaultServicesTextBeforeServicesList').hide();\\r\\n            jQuery('#idListServices').show();\\r\\n\\/\\/            jQuery('#idDivBktDefaultServicesMainContent').append('NO HAY HORAS DISPONIBLES, INT\\u221a\\u00e2NTELO DE NUEVO DENTRO DE UNOS D\\u221a\\u00e7AS. Si desea cancelar una cita haga clic en Historial y cancelaciones');\\r\\n        });\\r\\n    });\\r\\n<\\/script>\\r\\n                    <\\/div>                    \\r\\n                                \\r\\n                <div id='idListServices'><\\/div>\\r\\n                \\r\\n                <div id=\\\"idBktDefaultServicesTextAfterServicesList\\\">\\r\\n                                    <\\/div>\\r\\n            <\\/div>\\r\\n        <\\/div>\\r\\n\\r\\n        <div id='idDivBktButtonContinueContainer' style='display:none'><\\/div>\\r\\n    <\\/div>\\r\\n<\\/div>\\r\\n\\r\\n<div id='idBktDefaultExtraServicesContainer' class='clsBktDefaultWindow' style='display:none;'>\\r\\n    <div id=\\\"idBktDefaultExtraServicesContent\\\">\\r\\n        <div id='idBktExtraServicesSummaryContainer'>            \\r\\n            <div id=\\\"idBktExtraServicesBackButtonContainer\\\">\\r\\n                <div id=\\\"idBktExtraServicesBackButtonIcon\\\"><\\/div>\\r\\n            <\\/div>\\r\\n            \\r\\n            <div id=\\\"idBktExtraServicesSummary\\\">\\r\\n                <div id=\\\"idBktExtraServicesSummaryTitle\\\">\\r\\n                    Resumen de servicios seleccionados                <\\/div>\\r\\n                \\r\\n                <div id=\\\"idBktExtraServicesSummaryInfo\\\">\\r\\n                    <div id=\\\"idBktExtraServiceSelectedServiceContainer\\\">\\r\\n                        <span class=\\\"clsBktSummaryTextGrey clsBktSummaryTextBold\\\">Servicio:<\\/span>\\r\\n                        <span id=\\\"idBktExtraServiceSelectedServiceInfo\\\"><\\/span>\\r\\n                    <\\/div>\\r\\n                    \\r\\n                    <div id=\\\"idBktExtraServiceSelectedExtrasContainer\\\" style=\\\"display: none\\\">\\r\\n                        <span class=\\\"clsBktSummaryTextGrey clsBktSummaryTextBold\\\">Extras:<\\/span>\\r\\n                        <span id=\\\"idBktExtraServiceSelectedExtraInfo\\\"><\\/span>\\r\\n                    <\\/div>\\r\\n                <\\/div>\\r\\n            <\\/div>\\r\\n            \\r\\n            <div id=\\\"idBktExtraServicesTotalContainer\\\">\\r\\n                <span id=\\\"idBktExtraServiceSelectedTotalText\\\">Total<\\/span>\\r\\n                <span id=\\\"idBktExtraServiceSelectedTotal\\\"><\\/span>                    \\r\\n            <\\/div>            \\r\\n        <\\/div>\\r\\n        \\r\\n        <div id='idBktExtraServicesListContainer'>\\r\\n            <div id='idBktExtraServicesListTitle'>\\r\\n                \\u00bfQuieres a\\u00f1adir alg\\u00fan servicio extra?            <\\/div>        \\r\\n\\r\\n            <div id='idListExtraServices'><\\/div>\\r\\n        <\\/div>\\r\\n\\r\\n        <div id=\\\"idBktExtraServicesContinueButtonContainer\\\">\\r\\n            <div id=\\\"idBktExtraServicesContinueButton\\\" class='clsDivContinueButton'>\\r\\n                Continuar            <\\/div>            \\r\\n        <\\/div>\\r\\n    <\\/div>\\r\\n<\\/div><script type=\\\"text\\/template\\\" id=\\\"idTemSelectAgendas\\\">\\n    <a href='#selectagenda\\/<%= attributes.id %>'>\\n        <div class=\\\"clsDivBktAgendaContent <% if(typeof attributes.cls !== 'undefined'){ print(attributes.cls); } %>\\\">\\n            <div class=\\\"clsDivBktAgendaContentData\\\">\\n                <div class=\\\"clsDivBktAgendaDataImageContainer\\\">\\n                    <div class=\\\"clsDivBktAgendaContentImage\\\">\\n                    <%\\n                    if(attributes.photo.length > 0){ %>\\n                        <div class=\\\"clsDivBktAgendaContentImageCell\\\">\\n                            <div class=\\\"clsDivBktAgendaImage\\\" alt=\\\"<%= attributes.name %>\\\" style=\\\"background-image: url('<%= attributes.photo %>')\\\"><\\/div>\\n                        <\\/div>\\n                    <%\\n                    } %>\\n                    <\\/div>\\n                <\\/div>\\n        \\n                <div class=\\\"clsDivBktAgendaDataNameContainer\\\">\\n                    <div class=\\\"clsDivBktAgendaContentName\\\">\\n                        <div class=\\\"clsDivBktAgendaContentNameText\\\">\\n                            <%= attributes.name %>\\n                        <\\/div>\\n                    <\\/div>\\n                <\\/div>\\n\\n                <div class='clsCB'><\\/div>\\n            <\\/div>\\n        <\\/div>\\n    <\\/a>\\n<\\/script>\\n\\n<script type=\\\"text\\/template\\\" id=\\\"idTemBackToServices\\\">\\n    <a href=\\\"#services\\\">\\n        <div class=\\\"clsDivSubHeaderBackButton\\\"><\\/div>\\n    <\\/a>\\n<\\/script>\\n\\n<div id=\\\"idBktDefaultAgendasContainer\\\" class=\\\"clsBktDefaultWindow\\\" style=\\\"display:none;\\\">\\n    <div class=\\\"clsDivSubHeader\\\">\\n        <div class=\\\"clsDivSubHeaderBreadcrumbs\\\">\\n            <div class=\\\"clsDivSubHeaderBreadcrumbsText\\\" title=\\\"\\\"><\\/div>\\n        <\\/div>\\n        \\n        <div class='clsCB'><\\/div>\\n    <\\/div>\\n    \\n    <div id='idDivBktAgendasContainer'>      \\n        <div id=\\\"idBktDefaultAgendaTextBeforeAgendasList\\\">\\n                    <\\/div>\\t\\t\\n\\t\\t\\n        <div id='idBktDefaultAgendasErrorContainer' class=\\\"clsBktDefaultErrorContainer\\\" style='display:none'>\\n            <div id=\\\"idDivBktDefaultErrorAgendasLoadingData\\\" class=\\\"clsBktDefaultErrorText\\\">\\n                Se ha producido un error al cargar los datos            <\\/div>\\n            \\n            <div id=\\\"idDivBktDefaultErrorAgendasNoAvailable\\\" class=\\\"clsBktDefaultErrorText\\\">\\n                No hay agendas disponibles para este servicio            <\\/div>\\n\\n            <a href='#services'>\\n                <div class='clsDivContinueButton clsDivBackErrorButton clsHPR'>\\n                    Volver                <\\/div>\\n            <\\/a>\\n\\n            <div class='clsCB'><\\/div>\\n        <\\/div>\\n        \\n        <div id='idListAgendas' class=\\\"clsDivBktCards\\\"><\\/div>\\n        \\n        <div class='clsCB'><\\/div>\\n    <\\/div>\\n<\\/div><script type=\\\"text\\/template\\\" id=\\\"idTemAvailableTime\\\">\\r\\n    <a href='#selecttime\\/<%= date %>\\/<%= time %>\\/<%= agenda %>'>\\r\\n        <div class=\\\"clsDivDatetimeSlot\\\" <% if(typeof timestamp !== 'undefined'){ %> data-datetime=\\\"<%= timestamp %>\\\" <% } %> >\\r\\n            <%\\r\\n            if(typeof time_text !== 'undefined'){ %>\\r\\n                <span class=\\\"clsDivDatetimeSlotTime\\\"><%= time_text %><\\/span>\\r\\n            <%\\r\\n            }\\r\\n            else{ %>\\r\\n                <span class=\\\"clsDivDatetimeSlotTime\\\"><%= time %><\\/span>\\r\\n            <%        \\r\\n            } %>            \\r\\n            \\r\\n            <%\\r\\n            if(typeof freeslots !== 'undefined'){ %>\\r\\n                <div class=\\\"clsDivDatetimeSlotFree\\\">\\r\\n                    <%\\r\\n                    if(freeslots <= 1){ %>\\r\\n                        <%= freeslots %> Hueco libre                    <%\\r\\n                    }\\r\\n                    else{ %>\\r\\n                        <%= freeslots %> Huecos libres                    <%\\r\\n                    } %>\\r\\n                <\\/div>\\r\\n            <%\\r\\n            } %>            \\r\\n            \\r\\n            <%\\r\\n            if(typeof price !== 'undefined'){ %>\\r\\n                <div class=\\\"clsDivDatetimeSlotPrice\\\">\\r\\n                    <%= price %><%\\/\\/= currency %>\\r\\n                <\\/div>\\r\\n            <%\\r\\n            } %>\\r\\n        <\\/div>\\r\\n    <\\/a>\\r\\n<\\/script>\\r\\n\\r\\n<script type=\\\"text\\/template\\\" id=\\\"idTemAvailableWaitingList\\\">\\r\\n    <div class=\\\"clsDivDatetimeSlot clsDivDatetimeSlotWaitingList\\\" data-date=\\\"<%= date %>\\\" data-time=\\\"<%= time %>\\\" <% if(typeof timestamp !== 'undefined'){ %> data-datetime=\\\"<%= timestamp %>\\\" <% } %>>\\r\\n        <span class=\\\"clsDivDatetimeSlotTime\\\"><%= time %><\\/span>\\r\\n\\r\\n        <%\\r\\n        if(typeof freeslots !== 'undefined'){ %>\\r\\n            <div class=\\\"clsDivDatetimeSlotFree\\\">\\r\\n                <%\\r\\n                if(freeslots <= 1){ %>\\r\\n                    <%= freeslots %> Hueco libre                <%\\r\\n                }\\r\\n                else{ %>\\r\\n                    <%= freeslots %> Huecos libres                <%\\r\\n                } %>\\r\\n            <\\/div>\\r\\n        <%\\r\\n        } %>            \\r\\n\\r\\n        <%\\r\\n        if(typeof price !== 'undefined'){ %>\\r\\n            <div class=\\\"clsDivDatetimeSlotPrice\\\">\\r\\n                <%= price %><%\\/\\/= currency %>\\r\\n            <\\/div>\\r\\n        <%\\r\\n        } %>\\r\\n        \\r\\n        <div class=\\\"clsDivDatetimeWaitListText\\\">\\r\\n            Ap\\u00fantate en lista de espera aqu\\u00ed        <\\/div>\\r\\n    <\\/div>\\r\\n<\\/script>\\r\\n\\r\\n<script type=\\\"text\\/template\\\" id=\\\"idTemNotAvailableSlots\\\">\\r\\n    <div id=\\\"idDivNotAvailableSlotsContainer\\\">\\r\\n        <div id=\\\"idDivNotAvailableSlotsTextTop\\\">\\r\\n            No hay horas disponibles. Int\\u00e9ntelo de nuevo dentro de unos d\\u00edas.        <\\/div>\\r\\n        \\r\\n        <div id=\\\"idDivNotAvailableSlotsTextBottom\\\">\\r\\n                           \\r\\n        <\\/div>\\r\\n    <\\/div>\\r\\n<\\/script>\\r\\n\\r\\n<script type=\\\"text\\/template\\\" id=\\\"idTemNotAvailableSlotsWaitingList\\\">\\r\\n    <div id=\\\"idDivWaitingListContainer\\\" style=\\\"display: none\\\">\\r\\n        <div id=\\\"idDivWaitingListTextTop\\\">\\r\\n            <div id=\\\"idDivWaitingListTextTop\\\">\\u00bfQuieres apuntarte a la lista de espera?<\\/div>\\r\\n        <\\/div>\\r\\n        \\r\\n        <div id=\\\"idDivWaitingListOptions\\\">\\r\\n            <div style=\\\"display: table-row\\\">\\r\\n                <div style=\\\"display: table-cell; color: #e7522d; padding-right: 20px;\\\">Fecha<\\/div>\\r\\n                <div id=\\\"idDivWaitingListDatetime\\\" style=\\\"display: table-cell\\\"><\\/div>\\r\\n            <\\/div>\\r\\n            <div style=\\\"display: table-row\\\">\\r\\n                <div style=\\\"display: table-cell; color: #e7522d; padding-right: 20px;\\\">Servicio<\\/div>\\r\\n                <div id=\\\"idDivWaitingListService\\\" style=\\\"display: table-cell\\\"><\\/div>\\r\\n            <\\/div>\\r\\n            <div style=\\\"display: table-row\\\">\\r\\n                <div style=\\\"display: table-cell; color: #e7522d; padding-right: 20px;\\\">Agenda<\\/div>\\r\\n                <div id=\\\"idDivWaitingListAgenda\\\" style=\\\"display: table-cell\\\"><\\/div>\\r\\n            <\\/div>\\r\\n        <\\/div>\\r\\n        \\r\\n        <div id=\\\"idDivWaitingListSubmit\\\" class=\\\"clsDivContinueButton\\\">\\r\\n            Apuntarme en la lista de espera        <\\/div>\\r\\n        \\r\\n        <div id=\\\"idDivWaitingListBack\\\">\\r\\n            o selecciona <span id='idSpanWaitingListOtherTime'>otra hora<\\/span>        <\\/div>\\r\\n    <\\/div>\\r\\n<\\/script>\\r\\n\\r\\n<script type=\\\"text\\/template\\\" id=\\\"idTemSlotColumns\\\">\\r\\n    <% if(lastColumn === true){ %>\\r\\n        <div id=\\\"idDivSlotColumnContainer-<%= column %>\\\" class=\\\"clsDivSlotColumnContainerLast\\\"><\\/div>\\r\\n        <div class='clsCB'><\\/div>\\r\\n    <% }\\r\\n    else{%>\\r\\n        <div id=\\\"idDivSlotColumnContainer-<%= column %>\\\" class=\\\"clsDivSlotColumnContainer\\\"><\\/div>\\r\\n    <% } %>\\r\\n<\\/script>\\r\\n\\r\\n<script type=\\\"text\\/template\\\" id=\\\"idTemBackToAgendas\\\">\\r\\n    <a href=\\\"#agendas\\\">\\r\\n        <div class=\\\"clsDivSubHeaderBackButton\\\"><\\/div>\\r\\n    <\\/a>\\r\\n<\\/script>\\r\\n\\r\\n<div id=\\\"idBktDefaultDatetimeContainer\\\" class=\\\"clsBktDefaultWindow\\\" style=\\\"display:none;\\\">\\r\\n    <div class=\\\"clsDivSubHeader\\\">\\r\\n        <div class=\\\"clsDivSubHeaderBreadcrumbs\\\">\\r\\n            <div class=\\\"clsDivSubHeaderBreadcrumbsText\\\"><\\/div>\\r\\n        <\\/div>\\r\\n        \\r\\n        <div class='clsCB'><\\/div>\\r\\n    <\\/div>\\r\\n    \\r\\n    <div id=\\\"idDivBktDatetimeContainer\\\">        \\r\\n        <div id='idDivBktNumberOfPeopleContainerDatetime' style='display:none'>\\r\\n            <div id='idDivBktNumberOfPeopleContainerTextDatetime'>\\r\\n                <span class='clsTextOrange'>\\r\\n                    N\\u00famero de asistentes                <\\/span>\\r\\n            <\\/div>\\r\\n\\r\\n            <div id='idDivBktNumberOfPeopleContainerSelectDatetime'>\\r\\n                <select id='idSelNumberOfPeopleDatime'><\\/select>\\r\\n            <\\/div>\\r\\n        <\\/div>\\r\\n        \\r\\n  