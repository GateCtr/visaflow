inueButton clsDivBackErrorButton clsHPR'>\\r\\n                        Volver                    <\\/div>\\r\\n                <\\/a>\\r\\n\\r\\n                <div class='clsCB'><\\/div>\\r\\n            <\\/div>\\r\\n            \\r\\n            <div id='idBktDefaultDatetimeDataErrorContainer' class=\\\"clsBktDefaultErrorContainer\\\" style='display:none'><\\/div>\\r\\n                \\r\\n            <div id=\\\"idTimeListTable\\\"><\\/div>\\r\\n\\r\\n            <div class='clsCB'><\\/div>\\r\\n        <\\/div>\\r\\n    <\\/div>\\r\\n<\\/div><script type=\\\"text\\/template\\\" id=\\\"idTemSignupInputFieldsRowContainer\\\">\\r\\n    <div id=\\\"idBktDefaultSignUpRow-<%= iRow %>\\\" class=\\\"<%= sClass %>\\\"><\\/div>\\r\\n<\\/script>\\r\\n\\r\\n<script type=\\\"text\\/template\\\" id=\\\"idTemSignupInputSelectOption\\\">\\r\\n    <% if(bOptionSelected === true){ %>\\r\\n        <option selected = \\\"selected\\\" value=\\\"<%= iOptionValue %>\\\"><%= sOptionText %><\\/option>\\r\\n    <% }\\r\\n    else { %>\\r\\n        <option value=\\\"<%= iOptionValue %>\\\"><%= sOptionText %><\\/option>\\r\\n    <% } %>\\r\\n<\\/script>\\r\\n\\r\\n<script type=\\\"text\\/template\\\" id=\\\"idTemSignupInputFieldsText\\\">\\r\\n    <div class=\\\"clsDivBktSignupFormInput\\\">\\r\\n        <%\\r\\n        if(typeof attributes.before_text !== 'undefined'){ %>\\r\\n            <div id=\\\"idBktDefaultSignUpTextBeforeFieldText<%= attributes.input_text %>\\\">\\r\\n                <%= attributes.before_text %>\\r\\n            <\\/div>\\r\\n        <%            \\r\\n        } %>\\r\\n\\r\\n        <input id=\\\"idIptBkt<%= attributes.input_text %>\\\" type=\\\"text\\\" name=\\\"<%= attributes.input_text %>\\\" placeholder=\\\"<%= sShowText %>\\\" value=\\\"<%= sValue %>\\\" \\/>\\r\\n        \\r\\n        <div id=\\\"idDivBktFieldError<%= attributes.input_text %>\\\" class=\\\"clsDivBktDefaultFieldError\\\"><\\/div>\\r\\n\\r\\n        <%\\r\\n        if(typeof attributes.after_text !== 'undefined'){ %>\\r\\n            <div id=\\\"idBktDefaultSignUpTextAfterFieldText<%= attributes.input_text %>\\\">\\r\\n                <%= attributes.after_text %>\\r\\n            <\\/div>\\r\\n        <%            \\r\\n        } %>\\r\\n    <\\/div>\\r\\n<\\/script>\\r\\n\\r\\n<script type=\\\"text\\/template\\\" id=\\\"idTemSignupInputFieldsPassword\\\">\\r\\n    <div class=\\\"clsDivBktSignupFormInput\\\">\\r\\n        <input id=\\\"idIptBkt<%= attributes.input_text %>\\\" type=\\\"password\\\" name=\\\"<%= attributes.input_text %>\\\" placeholder=\\\"<%= sShowText %>\\\" value=\\\"<%= sValue %>\\\" \\/>\\r\\n        \\r\\n        <div id=\\\"idDivBktFieldError<%= attributes.input_text %>\\\" class=\\\"clsDivBktDefaultFieldError\\\"><\\/div>\\r\\n    <\\/div>\\r\\n<\\/script>\\r\\n\\r\\n<script type=\\\"text\\/template\\\" id=\\\"idTemSignupInputFieldsCheckBox\\\">\\r\\n    <div class=\\\"clsDivBktSignupFormInput\\\">\\r\\n        <%\\r\\n        if(typeof attributes.before_text !== 'undefined'){ %>\\r\\n            <div id=\\\"idBktDefaultSignUpTextBeforeFieldCheckbox<%= attributes.input_text %>\\\">\\r\\n                <%= attributes.before_text %>\\r\\n            <\\/div>\\r\\n        <%            \\r\\n        } %>\\r\\n        \\r\\n        <div class=\\\"clsDivBktSignupFormInputCheckboxContainer\\\">\\r\\n            <div class=\\\"clsDivBktSignupFormInputCheckboxInput\\\">\\r\\n                <input id=\\\"idIptBkt<%= attributes.input_text %>\\\" type=\\\"checkbox\\\" value=\\\"1\\\" name=\\\"<%= attributes.input_text %>\\\" \\/>\\r\\n                <label for=\\\"idIptBkt<%= attributes.input_text %>\\\">\\r\\n            <\\/div>\\r\\n\\r\\n            <div class=\\\"clsDivBktSignupFormInputCheckboxLabel\\\">\\r\\n                <%= sShowText %>\\r\\n            <\\/div>\\r\\n        <\\/div>\\r\\n        \\r\\n        <div id=\\\"idDivBktFieldError<%= attributes.input_text %>\\\" class=\\\"clsDivBktDefaultFieldError\\\"><\\/div>\\