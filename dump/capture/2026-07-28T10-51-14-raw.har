n                <%= attributes.before_text %>\\r\\n            <\\/div>\\r\\n        <%            \\r\\n        } %>    \\r\\n    \\r\\n        <div class=\\\"clsDivBktSignupFormInputDropAndTextContainer\\\">\\r\\n            <div class=\\\"clsDivBktSignupFormInputDropAndTextField clsDivBktSignupFormInputDropAndTextFieldSelect\\\">\\r\\n                <select id=\\\"idIptBktInternationalCode<%= attributes.input_text %>\\\" onChange=\\\"this.blur()\\\" name=\\\"<%= attributes.input_text %>_countries_id\\\"><\\/select>\\r\\n            <\\/div>\\r\\n            \\r\\n            <div class=\\\"clsDivBktSignupFormInputDropAndTextField clsDivBktSignupFormInputDropAndTextFieldInput\\\">\\r\\n                <input id=\\\"idIptBkt<%= attributes.input_text %>\\\" type=\\\"tel\\\" name=\\\"<%= attributes.input_text %>\\\" placeholder=\\\"<%= sShowText %>\\\" value=\\\"<%= sValue %>\\\" \\/>\\r\\n            <\\/div>\\r\\n        <\\/div>\\r\\n        \\r\\n        <div id=\\\"idDivBktFieldError<%= attributes.input_text %>\\\" class=\\\"clsDivBktDefaultFieldError\\\"><\\/div>\\r\\n    <\\/div>\\r\\n<\\/script>\\r\\n\\r\\n<script type=\\\"text\\/template\\\" id=\\\"idTemSignupVoucherInputField\\\">\\r\\n    <div id=\\\"idBktDefaultSignUpRowVoucher\\\" class=\\\"clsDivBktDefaultSignUpRow\\\">\\r\\n        <div class=\\\"clsDivBktSignupFormInput\\\">\\r\\n            <input id=\\\"idIptBktvoucher\\\" type=\\\"text\\\" name=\\\"voucher\\\" placeholder=\\\"C\\u00f3digo de bono\\\" value=\\\"\\\" \\/>\\r\\n        <\\/div>\\r\\n    <\\/div>\\r\\n\\t\\r\\n\\t<div id=\\\"idDivBktFieldErrorvoucher\\\" class=\\\"clsDivBktDefaultFieldError\\\"><\\/div>\\r\\n<\\/script>\\r\\n\\r\\n<div id=\\\"idBktDefaultSignUpContainer\\\" class=\\\"clsBktDefaultWindow\\\" style=\\\"display:none;\\\">\\r\\n    <div class=\\\"clsDivSubHeader\\\">\\r\\n        <a href=\\\"#datetime\\\">\\r\\n            <div class=\\\"clsDivSubHeaderBackButton\\\"><\\/div>\\r\\n        <\\/a>\\r\\n        \\r\\n      