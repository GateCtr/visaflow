":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":220.109,"receive":290.842},"serverIPAddress":"104.19.229.21","_serverPort":443,"_securityDetails":{"protocol":"QUIC","subjectName":"hcaptcha.com","issuer":"WE1","validFrom":1781823983,"validTo":1789603567}},{"pageref":"page@4c8482ae0c152ace4fc1275d34cb3f97","startedDateTime":"2026-07-28T10:47:48.106Z","time":193.19799999999998,"request":{"method":"GET","url":"https://newassets.hcaptcha.com/captcha/v1/494ae5ee0caca30cfa99514c266b501a90fa268a/static/i18n/es.json","httpVersion":"h3","cookies":[],"headers":[{"name":"sec-ch-ua-platform","value":"\"Windows\""},{"name":"Referer","value":"https://www.citaconsular.es/"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/137.0.0.0 Safari/537.36"},{"name":"sec-ch-ua","value":"\"Google Chrome\";v=\"137\", \"Chromium\";v=\"137\", \"Not/A)Brand\";v=\"24\""},{"name":"Accept-Language","value":"es-ES,es;q=0.9,en;q=0.8"},{"name":"sec-ch-ua-mobile","value":"?0"}],"queryString":[],"headersSize":424,"bodySize":0},"response":{"status":200,"statusText":"","httpVersion":"h3","cookies":[],"headers":[{"name":"access-control-max-age","value":"3000"},{"name":"content-encoding","value":"gzip"},{"name":"cf-cache-status","value":"HIT"},{"name":"etag","value":"\"e31f7415467ba33f8a705882e2b2aeac\""},{"name":"x-content-type-options","value":"nosniff"},{"name":"access-control-allow-methods","value":"GET, HEAD"},{"name":"expires","value":"Tue, 28 Jul 2026 11:47:47 GMT"},{"name":"alt-svc","value":"h3=\":443\"; ma=86400"},{"name":"server-timing","value":"cfExtPri"},{"name":"date","value":"Tue, 28 Jul 2026 10:47:47 GMT"},{"name":"content-type","value":"application/json"},{"name":"vary","value":"Origin,Access-Control-Request-Headers,Access-Control-Request-Method, accept-encoding"},{"name":"priority","value":"u=1,i"},{"name":"cache-control","value":"public, max-age=3600"},{"name":"cf-ray","value":"a2234ecbbedd09d6-CPT"},{"name":"accept-ranges","value":"bytes"},{"name":"access-control-allow-origin","value":"*"},{"name":"content-length","value":"5140"},{"name":"server","value":"cloudflare"}],"content":{"size":15972,"mimeType":"application/json","compression":16617,"text":"{\n  \"'I am human' is now checked. You are verified\": \"\\\"Soy humano\\\" ya está marcado. Estás verificado.\",\n  \"'I am human', Select in order to trigger the challenge, or to bypass it if you have an accessibility cookie\": \"'Soy humano', seleccione para activar el desafío o para omitirlo si tiene una cookie de accesibilidad\",\n  \"A new SMS will open with a one time code for you to send.\": \"Se abrirá un nuevo SMS con un código de un solo uso que deberás enviar.\",\n  \"About hCaptcha & Accessibility Options\": \"Acerca de hCaptcha y las opciones de accesibilidad\",\n  \"Accessibility\": \"Accesibilidad\",\n  \"Accessibility Challenge\": \"Desafío de accesibilidad\",\n  \"Accessibility Cookie\": \"Cookie de accesibilidad\",\n  \"Accessibility cookie is not set. {{retrieve-cookie}}\": \"La cookie de accesibilidad no está configurada. {{retrieve-cookie}}\",\n  \"Accessibility cookie is set. For help, please email {{support}}\": \"La cookie de accesibilidad está configurada. Para obtener ayuda, envíe un correo electrónico a {{support}}\",\n  \"Accessibility: Retrieve Cookie\": \"Accesibilidad: Recuperar Cookie\",\n  \"Back\": \"atrás\",\n  \"Back to previous verification option\": \"Volver a la opción de verificación anterior\",\n  \"Brand\": \"Marca\",\n  \"Can't Click\": \"No puedo hacer clic\",\n  \"Can't Solve\": \"No se puede resolver\",\n  \"Cancel\": \"Cancelar\",\n  \"Cancel Navigation\": \"Cancelar navegación\",\n  \"Cancel Response\": \"Cancelar respuesta\",\n  \"Cannot contact hCaptcha. Check your connection and try again.\": \"No puedo contactar con hCaptcha. Verifique su conexión y vuelva a intentarlo.\",\n  \"Challenge Image {{id}}\": \"Imagen de desafío {{id}}\",\n  \"Challenge refreshed.\": \"Desafío renovado.\",\n  \"Challenge Text Input\": \"Entrada de texto de desafío\",\n  \"Check\": \"Verificar\",\n  \"Check mark\": \"Marca de verificación\",\n  \"Close\": \"Cerca\",\n  \"Close Modal\": \"Modal cerrado\",\n  \"Code\": \"Código\",\n  \"collapsed\": \"colapsó\",\n  \"Confirm\": \"Confirmar\",\n  \"Confirm Code\": \"Confirmar código\",\n  \"Confirm Navigation\": \"Confirmar navegación\",\n  \"Confirming code {{code}}\": \"Código de confirmación {{code}}\",\n  \"Cookies are disabled or the accessibility cookie is not set. {{enable-cookies}}\": \"Las cookies están deshabilitadas o la cookie de accesibilidad no está configurada. {{enable-cookies}}\",\n  \"Copied\": \"Copiado\",\n  \"Copy Code\": \"Copiar código\",\n  \"Copy Phone Number\": \"Copiar número de teléfono\",\n  \"Copy phone number: {{phone}}\": \"Copiar número de teléfono: {{phone}}\",\n  \"Copy verification code: {{code}}\": \"Copiar código de verificación: {{code}}\",\n  \"Couldn't verify the code, please try again\": \"No se pudo verificar el código, por favor inténtalo nuevamente\",\n  \"Describe why you are reporting an image.\": \"Describe por qué estás reportando una imagen.\",\n  \"Didn't get the code?\": \"¿No recibiste el código?\",\n  \"Display hCaptcha Accessibility Challenge\": \"Mostrar desafío de accesibilidad hCaptcha\",\n  \"Display hCaptcha Visual Challenge\": \"Mostrar desafío visual hCaptcha\",\n  \"Drag the item\": \"Arrastre el elemento\",\n  \"Email\": \"Correo electrónico\",\n  \"Enable cross-site cookies.\": \"Habilite las cookies entre sitios.\",\n  \"Enter code\": \"Introducir código\",\n  \"Enter the two words in the image.\": \"Ingrese las dos palabras en la imagen.\",\n  \"Enter verification code\": \"Introduzca el código de verificación\",\n  \"Enter your email address\": \"Introduzca su dirección de correo electrónico\",\n  \"Enter your phone number\": \"Introduce tu número de teléfono\",\n  \"Error fetching captcha.\": \"Error al recuperar captcha.\",\n  \"Error submitting captcha.\": \"Error al enviar captcha.\",\n  \"Example image {{id}}\": \"Imagen de ejemplo {{id}}\",\n  \"expanded\": \"expandido\",\n  \"Feedback\": \"Retroalimentación\",\n  \"Having a problem?\": \"¿Tiene un problema?\",\n  \"hCaptcha challenge\": \"desafío hCaptcha\",\n  \"hCaptcha is a service that reduces bots and spam by asking simple questions. Please follow the instructions at the top of the screen for each challenge. For more info visit\": \"hCaptcha es un servicio que reduce los bots y el spam haciendo preguntas simples. Sigue las instrucciones en la parte superior de la pantalla para cada prueba. Para más información visite\",\n  \"hCaptcha is a service that reduces bots and spam by asking simple questions. Please follow the instructions at the top of the screen for each challenge. For more information visit {{site-url}}\": \"hCaptcha es un servicio que reduce los bots y el spam mediante preguntas sencillas. Siga las instrucciones en la parte superior de la pantalla para cada desafío. Para obtener más información, visita {{site-url}}\",\n  \"hCaptcha logo, opens new window with more information\": \"Logotipo de hCaptcha, abre una nueva ventana con más información\",\n  \"hCaptcha Privacy Policy, opens in a new tab\": \"Política de privacidad de hCaptcha, se abre en una nueva pestaña\",\n  \"hCaptcha security token has expired. Please complete the challenge again.\": \"El token de seguridad de hCaptcha ha expirado. Completa el desafío nuevamente.\",\n  \"hCaptcha Terms of Service, opens in a new tab\": \"Condiciones del servicio de hCaptcha, se abre en una nueva pestaña\",\n  \"hCaptcha window closed due to timeout.\": \"Ventana de hCaptcha cerrada debido al tiempo de espera.\",\n  \"hcaptcha.com. Opens in a new tab.\": \"hcaptcha.com. Se abre en una nueva pestaña.\",\n  \"Hide examples.\": \"Ocultar ejemplos.\",\n  \"Hold an item to unlock\": \"Sostenga un objeto para desbloquearlo\",\n  \"Hold to unlock\": \"Mantenga presionado para desbloquear\",\n  \"I am human\": \"Soy humano\",\n  \"If there are None, click Skip\": \"Si no hay ninguna, haz clic en Omitir\",\n  \"Image-based CAPTCHA challenge. Please use the 'Accessibility: Retrieve Cookie' or 'Accessibility: Text Challenge' options if available in the challenge menu.\": \"Desafío CAPTCHA con imagen. Utilice las opciones «Accesibilidad: Recuperar Cookie» o «Accesibilidad: Desafío de Texto» si están disponibles en el menú del desafío.\",\n  \"Inappropriate\": \"Inapropiado\",\n  \"Info\": \"Informacion\",\n  \"Information\": \"Información\",\n  \"Information About hCaptcha\": \"Información sobre hCaptcha\",\n  \"Information about hCaptcha's accessibility options.\": \"Información sobre las opciones de accesibilidad de hCaptcha.\",\n  \"Information about the hCaptcha service.\": \"Información sobre el servicio hCaptcha.\",\n  \"Invalid challenge.\": \"Desafío no válido.\",\n  \"Invalid email address\": \"Dirección de correo electrónico no válida\",\n  \"Invalid phone number\": \"Número de teléfono inválido\",\n  \"Learn about accessibility options.\": \"Conozca las opciones de accesibilidad.\",\n  \"Learn more about hCaptcha Accessibility.\": \"Obtén más información sobre la accesibilidad de hCaptcha.\",\n  \"Learn more about hCaptcha Accessibility. Opens in a new tab.\": \"Más información sobre la accesibilidad de hCaptcha. Se abre en una nueva pestaña.\",\n  \"Loading\": \"Cargando\",\n  \"Locked\": \"Bloqueado\",\n  \"Move\": \"Mover\",\n  \"Multiple Choice Option\": \"Opción de opción múltiple\",\n  \"New Challenge\": \"Nuevo desafío\",\n  \"Next\": \"Siguiente\",\n  \"Next Challenge\": \"Siguiente reto\",\n  \"Next Challenge, page {{current}} of {{total}}\": \"Próximo desafío, página {{current}} de {{total}}\",\n  \"No SMS received yet, please retry\": \"Aún no hemos recibido ningún SMS, inténtelo de nuevo.\",\n  \"Off Screen\": \"Fuera de la pantalla\",\n  \"Only SMS is supported, do not use WhatsApp.\": \"Solo se admiten SMS, no utilice WhatsApp.\",\n  \"Open SMS\": \"Abrir SMS\",\n  \"Open SMS with verification code. Send the message, then return and press Confirm.\": \"Abre el SMS con el código de verificación. Envía el mensaje, regresa y pulsa Confirmar.\",\n  \"Other\": \"Otro\",\n  \"Our accessibility option may help\": \"Nuestra opción de accesibilidad puede ayudar\",\n  \"Our accessibility option may help.\": \"Nuestra opción de accesibilidad puede ayudar.\",\n  \"Phone\": \"Teléfono\",\n  \"Phone number copied to clipboard\": \"Número de teléfono copiado al portapapeles\",\n  \"Please also try turning off your ad blocker. Our accessibility option may help.\": \"Intenta también desactivar tu bloqueador de anuncios. Nuestra opción de accesibilidad podría ayudarte.\",\n  \"Please also try turning off your ad blocker.‍\": \"Intenta también desactivar tu bloqueador de anuncios.\",\n  \"Please describe your issue.\": \"Describe el problema.\",\n  \"Please enter a valid code\": \"Por favor, introduzca un código válido\",\n  \"Please enter your email to receive a verification code.\": \"Ingrese su correo electrónico para recibir un código de verificación.\",\n  \"Please provide your phone number to generate a verification code.\": \"Proporcione su número de teléfono para generar un código de verificación.\",\n  \"Please select an image to report.\": \"Seleccione una imagen para reportar.\",\n  \"Please select an option to send response.\": \"Seleccione una opción para enviar respuesta.\",\n  \"Please select Confirm to follow the link, or Cancel to stay on the current screen.\": \"Seleccione Confirmar para seguir el enlace o Cancelar para permanecer en la pantalla actual.\",\n  \"Please try again.\": \"Inténtalo de nuevo.\",\n  \"Press and hold to zoom. {{icon}}\": \"Mantenga presionado para hacer zoom. {{icon}}\",\n  \"Privacy\": \"Privacidad\",\n  \"Provide details\": \"Proporcionar detalles\",\n  \"Provide feedback for hCaptcha.\": \"Proporcione comentarios para hCaptcha.\",\n  \"Provide Feedback.\": \"Proporcionar retroalimentación.\",\n  \"QR Code\": \"Código QR\",\n  \"QR code to open SMS app with verification message pre-filled. Press 'Show Details' button below for alternative method.\": \"Código QR para abrir la app de SMS con el mensaje de verificación precargado. Pulsa el botón \\\"Mostrar detalles\\\" a continuación para ver el método alternativo.\",\n  \"Rate limited or network error. Please retry.\": \"Tasa limitada o error de red. Por favor, intenta de nuevo.\",\n  \"Refresh Challenge.\": \"Actualizar prueba.\",\n  \"Report\": \"Reporte\",\n  \"Report Bug\": \"Reportar un error\",\n  \"Report Bug to hCaptcha\": \"Informar de un error a hCaptcha\",\n  \"Report Image\": \"Reportar imagen\",\n  \"Report Image to hCaptcha\": \"Reportar imagen a hCaptcha\",\n  \"Reporting a functionality issue?\": \"¿Informar un problema de funcionalidad?\",\n  \"Reporting a functionality issue? See how to report issues with detailed logs.\": \"¿Necesitas informar un problema de funcionalidad? Consulta cómo informar problemas con registros detallados.\",\n  \"Resend\": \"Reenviar\",\n  \"Resend code is now available.\": \"El código de reenvío ya está disponible.\",\n  \"Resend verification code\": \"Reenviar código de verificación\",\n  \"Resend verification code. Available after timer completes.\": \"Reenviar código de verificación. Disponible al finalizar el temporizador.\",\n  \"Reset zoom\": \"Restablecer zoom\",\n  \"Retrieve accessibility cookie.\": \"Recuperar cookie de accesibilidad.\",\n  \"Retrieve accessibility cookie. Opens in a new tab.\": \"Recuperar cookie de accesibilidad. Se abre en una nueva pestaña.\",\n  \"Return to the app and press Confirm after sending this message. Do not edit or share the code: {{code}}\": \"Regresa a la app y pulsa \\\"Confirmar\\\" después de enviar este mensaje. No edites ni compartas el código: {{code}}\",\n  \"Scan QR code\": \"Escanee el código QR\",\n  \"See how to report issues with detailed logs.\": \"Mira cómo informar problemas con registros detallados.\",\n  \"Select a country code. Currently selected {{cc}}\": \"Selecciona un código de país. Actualmente seleccionado {{cc}}\",\n  \"Select a language\": \"Seleccione un idioma\",\n  \"Select {{icon}} to enable Zoom.\": \"Seleccione {{icon}} para habilitar Zoom.\",\n  \"Send\": \"Enviar\",\n  \"Send code via SMS\": \"Enviar código por SMS\",\n  \"Send prefilled message\": \"Enviar mensaje precargado\",\n  \"Send Response\": \"Enviar respuesta\",\n  \"Send this code to the phone number below.\": \"Envía este código al número de teléfono que aparece a continuación.\",\n  \"Send To\": \"Enviar a\",\n  \"Send Us Feedback\": \"Envianos tus comentarios\",\n  \"Show Details\": \"Mostrar detalles\",\n  \"Show Details. Get verification code and phone number to copy manually\": \"Mostrar detalles. Obtener el código de verificación y el número de teléfono para copiarlos manualmente.\",\n  \"Sign up for accessibility access to bypass the hCaptcha challenge.\": \"Regístrese para acceder a la accesibilidad para evitar el desafío hCaptcha.\",\n  \"Skip\": \"Omitir\",\n  \"Skip Challenge\": \"Omitir prueba.\",\n  \"Skip Challenge, page {{current}} of {{total}}\": \"Saltar desafío, página {{current}} de {{total}}\",\n  \"Software Bug\": \"Error de programación\",\n  \"Sorry to hear that!\": \"Lamento escuchar eso!\",\n  \"Standard SMS rates may apply.\": \"Pueden aplicarse tarifas de SMS estándar.\",\n  \"Status:\": \"Estado:\",\n  \"Submit Email\": \"Enviar correo electrónico\",\n  \"Tell Us Why\": \"Dinos por qué\",\n  \"Terms\": \"Condiciones\",\n  \"Thank you for your feedback.\": \"Gracias por sus comentarios.\",\n  \"The sitekey for this hCaptcha is incorrect. Please contact the site admin if you see this.\": \"La clave de sitio para este hCaptcha es incorrecta. Póngase en contacto con el administrador del sitio si ve esto.\",\n  \"This hCaptcha is for testing only. Please contact the site admin if you see this.\": \"Este hCaptcha es solo para pruebas. Póngase en contacto con el administrador del sitio si ve esto.\",\n  \"This lets you avoid future questions by registering and setting a cookie.\": \"Esto le permite evitar futuras preguntas al registrarse y configurar una cookie.\",\n  \"This organization has been flagged for violating hCaptcha's terms of service, [learn more](https://www.hcaptcha.com/service-abuse-information).\": \"Esta organización ha sido marcada por violar los términos de servicio de hCaptcha, [más información](https://www.hcaptcha.com/service-abuse-information).\",\n  \"To bypass our visual challenge, we offer an accessibility cookie.\": \"Para evitar nuestra prueba visual, ofrecemos una cookie de accesibilidad.\",\n  \"Too Difficult\": \"Demasiado difícil\",\n  \"Verification code copied to clipboard\": \"Código de verificación copiado al portapapeles\",\n  \"Verification code: {{text}}\": \"Código de verificación: {{text}}\",\n  \"Verify Answers\": \"Verificar respuestas\",\n  \"Verify it's you. Get verification code, then hit **Confirm**.\": \"Verifica que eres tú. Obtén el código de verificación y haz clic en **Confirmar**.\",\n  \"Verify it's you. Get verification code, then hit Confirm.\": \"Verifica que eres tú. Obtén el código de verificación y pulsa \\\"Confirmar\\\".\",\n  \"Verify it's you. Input your mobile number, send SMS then Confirm\": \"Verifica que eres tú. Introduce tu número de móvil, envía un SMS y confirma.\",\n  \"Verify it's you. Send SMS, then hit Confirm.\": \"Verifica que eres tú. Envía un SMS y pulsa \\\"Confirmar\\\".\",\n  \"Verify it’s you. Send SMS, then hit **Confirm**.\": \"Verifica que eres tú. Envía un SMS y pulsa **Confirmar**.\",\n  \"Verify Phone Number\": \"Verificar número de teléfono\",\n  \"View more examples.\": \"Ver más ejemplos.\",\n  \"Violent\": \"Violento\",\n  \"Visit this menu entry to open a visual challenge.\": \"Visite esta entrada del menú para abrir un desafío visual.\",\n  \"We will look into the issue immediately.\": \"Analizaremos el problema de inmediato.\",\n  \"We'll resolve your issue as quickly as we can.\": \"Resolveremos tu problema lo más rápido posible.\",\n  \"We've sent a 6-digit to your email. Please enter it below to verify your identity.\": \"Te hemos enviado un código de 6 dígitos a tu correo electrónico. Introdúcelo a continuación para verificar tu identidad.\",\n  \"Widget containing checkbox for hCaptcha security challenge\": \"Widget que contiene una casilla de verificación para el desafío de seguridad de hCaptcha\",\n  \"widget error message text\": \"texto del mensaje de error del widget\",\n  \"widget warning message text\": \"texto del mensaje de advertencia del widget\",\n  \"Your computer or network has sent too many requests.\": \"Su computadora o red ha enviado demasiadas solicitudes.\",\n  \"Zoom in\": \"Acercarse\",\n  \"Zoom out\": \"Disminuir el zoom\",\n  \"{{locale}} - {{language}}, Select a language\": \"{{locale}} - {{language}}, Seleccione un idioma\"\n}"},"headersSize":645,"bodySize":-645,"redirectURL":"","_transferSize":0},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":190.736,"receive":2.462},"serverIPAddress":"104.19.229.21","_serverPort":443,"_securityDetails":{"protocol":"QUIC","subjectName":"hcaptcha.com","issuer":"WE1","validFrom":1781823983,"validTo":1789603567}},{"pageref":"page@4c8482ae0c152ace4fc1275d34cb3f97","startedDateTime":"2026-07-28T10:47:48.106Z","time":227.291,"request":{"method":"GET","url":"https://www.citaconsular.es/js/jquery/jquery-2.1.1.min.js?v=4","httpVersion":"h3","cookies":[{"name":"PHPSESSID","value":"kbJgrwkUzB97mXXLa9SC4iJm"},{"name":"cf_chl_rc_ni","value":"1"},{"name":"cf_clearance","value":"OA_9FecTs0x5m6Ela.VYni1aOxDmUND1zFfQEJ1h4cI-1785235664-1.2.1.1-y4wNbvM1YjN6YolMglcw0qzTm5jYWvKgYMq_mXMqeHTt7OKPglz_73urRtP_7yHTmuQmM214b0xZg45rDQOtA.pXikDTTJLxKD.3BSvul16Caop4KjEzZjGjo0DqERV8T5XIVu3PIeXJe87YWl6EDrv7lBErbDyyiMRGITPpWMOOy7U09HrJQ03IgqaND2xPWZBF427N5AW46UNdEHQXA7LTNiQDG6VMWT5apocT8e1CLeH8eAwlNkfpcv9ij.jdIKPHeXarK