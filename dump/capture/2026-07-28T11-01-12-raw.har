    --primary: #64adb7;\r\n    --title: #7e868a;\r\n    --secondary: #e2eaec;\r\n    --ternary: #f1f3f5;\r\n    --back: url(\"../../../images/widgets/default/agendas/atras.svg\");\r\n    --calendar: url(\"../../../images/widgets/default/datetime/calendar_widget.svg\");\r\n    --uncheck: url(\"../../../images/widgets/default/agendas/check_02.png\") 0px 0px no-repeat;\r\n    --check: url(\"../../../images/widgets/default/agendas/check_02.png\") 0px -16px no-repeat;\r\n    --input: #f5f6f7;\r\n    --hover: #4799A4;\r\n    --notification: #d9fff8;\r\n    --warning: #ffe5d4;\r\n    --warningText: #bf5814;\r\n    --errorBack: #F4DBD0;\r\n    --errorFont: #B4571A;\r\n    --head: #7C8589;\r\n    --okBack:#DAE8E8;\r\n    --okFont:#63ACB6;\r\n    --heightInput:32px;\r\n}\r\n\r\n#idBktWidgetBody #idBktWidgetDefaultBodyContainer{\r\n    width: 750px;\r\n    margin: 0 auto;\r\n    position: relative;\r\n    border: 1.5px solid var(--secondary);\r\n    border-radius: 5px;\r\n    background-color: white;\r\n}\r\n\r\n#idBktWidgetBody #idBktWidgetDefaultBodyContainer #idBktWidgetDefaultHeader{\r\n    margin-top: 15px;\r\n    margin-bottom: 15px;\r\n    background-color: white;\r\n    font-size: 1.8rem;\r\n    color: var(--primary);\r\n    font-weight: bold;\r\n}\r\n\r\n#idBktWidgetBody #idBktWidgetDefaultBodyContainer #idDivBktServicesContainer #idListServices .clsBktServiceName a{\r\n    font-weight: bold;\r\n}\r\n\r\n#idBktWidgetBody #idBktWidgetDefaultBodyContainer #idBktWidgetDefaultHeader #idBktWidgetDefaultHeaderCenterName #idBktWidgetDefaultHeaderCenterNameText{\r\n    color: var(--primary);\r\n    font-size: 1.4rem;\r\n}\r\n\r\n#idBktWidgetBody #idBktWidgetDefaultBodyContainer #idBktWidgetDefaultContainer{\r\n    background-color: white;\r\n    padding-bottom: 20px;\r\n}\r\n\r\n#idBktWidgetBody #idBktWidgetDefaultBodyContainer #idBktWidgetDefaultFooter{\r\n    background-color: white;\r\n    border-top: 1.5px solid var(--secondary);\r\n}\r\n\r\n#idBktWidgetBody #idBktWidgetD