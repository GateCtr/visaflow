r'>\\n            <div id=\\\"idDivBktCustomContinueButton\\\" class='clsDivContinueButton'>\\n                Continuar            <\\/div>\\n        <\\/div>\\n    <\\/div>\\n<\\/div><script type='text\\/template' id='idTemSelectPeople'>\\r\\n    <option value='<%= value %>'><%= people %><\\/option>\\r\\n<\\/script>\\r\\n\\r\\n<script type='text\\/template' id='idTemSelectServices'>\\r\\n    <% if(showGroup === true){ %>\\r\\n        <div class=\\\"clsBktServiceGroupName clsBktServiceAttGroup-<%= attributes.groups_id %>\\\" data-service-group=\\\"<%= attributes.groups_id %>\\\">\\r\\n            <%= attributes.groupname %>\\r\\n        <\\/div>\\r\\n    <% } %>\\r\\n    \\r\\n    <%\\r\\n    if(attributes.show_description_class !== 'undefined' && attributes.show_description_class.length > 0){ %>\\r\\n        <a href='#selectservice\\/<%= attributes.id %>' class=\\\"<%= attributes.show_extraservice_class %>\\\">\\r\\n            <div class=\\\"clsBktServiceDataContainer clsBktServiceAttMultiserviceNumber-<%= attributes.multiservice_number %> clsBktServiceAttMultiservice-<%= attributes.multiservice %> clsBktServiceAttParentGroup-<%= attributes.groups_id %> <%= attributes.show_description_class %>\\\" data-min-people = \\\"<%= parseInt(attributes.multiservice_number_min) %>\\\">\\r\\n                <% if(attributes.multiselect == 1){ %>\\r\\n                    <div class=\\\"clsBktServiceCheckbox clsHP\\\">\\r\\n                        <input id='idCheckBox<%= attributes.id %>' type='checkbox' name='services[]' value='<%= attributes.id %>' \\/>\\r\\n                        <label for='idCheckBox<%= attributes.id %>'>\\r\\n                    <\\/div>\\r\\n                <% } %>\\r\\n\\r\\n                <% if(attributes.video_call != 0){ %>\\r\\n                    <div class=\\\"clsBktServiceVideoCall clsHP\\\"><\\/div>\\r\\n                <% } %>\\r\\n\\r\\n                <div class=\\\"clsBktServiceName clsHP\\\">\\r\\n                    <%= attributes.name %>\\r\\n                <\\/div>\\r\\n\\r\\n                <% if(attributes.public_price == 1){ %>\\r\\n                    <div class=\\\"clsBktServicePublicPrice clsHP clsTextGreen\\\">\\r\\n                        <% if(attributes.price_conf_type == 2 && attributes.min_price !== null){ %>\\r\\n                            Desde <%= attributes.min_price %><%\\/\\/= attributes.symbol %>\\r\\n                        <% }\\r\\n                        else{ %>\\r\\n                                                            <%= attributes.price_no_prepay %><%\\/\\/= attributes.symbol %>\\r\\n                                                    <% } %>\\r\\n                    <\\/div>\\r\\n                <% } %>\\r\\n\\r\\n                <div class='clsCB'><\\/div>\\r\\n                \\r\\n                <% if(attributes.description !== null && attributes.description.length > 0){ %>\\r\\n                    <div class=\\\"clsBktServiceDescription\\\">\\r\\n                        <%= attributes.description %>\\r\\n                    <\\/div>\\r\\n                <% } %>\\r\\n            <\\/div>\\r\\n        <\\/a>\\r\\n    <%\\r\\n    }\\r\\n    else{ %>\\r\\n        <div class=\\\"clsBktServiceDataContainer clsBktServiceAttMultiserviceNumber-<%= attributes.multiservice_number %> clsBktServiceAttMultiservice-<%= attributes.multiservice %> clsBktServiceAttParentGroup-<%= attributes.groups_id %>\\\" data-min-people = \\\"<%= parseInt(attributes.multiservice_number_min) %>\\\">\\r\\n            <% if(attributes.multiselect == 1){ %>\\r\\n                <div class=\\\"clsBktServiceCheckbox clsHP\\\">\\r\\n                    <input id='idCheckBox<%= attributes.id %>' type='checkbox' name='services[]' value='<%= attributes.id %>' \\/>\\r\\n                    <label for='idCheckBox<%= attributes.id %>'>\\r\\n                <\\/div>\\r\\n            <% } %>\\r\\n\\r\\n            <% if(attributes.video_call != 0){ %>\\r\\n                <div class=\\\"clsBktServiceVideoCall clsHP\\\"><\\/div>\\r\\n            <% } %>\\r\\n\\r\\n            <div class=\\\"clsBktServiceName clsHP\\\">\\r\\n                <a href='#selectservice\\/<%= attributes.id %>' class=\\\"<%= attributes.show_extraservice_class %>\\\">\\r\\n                    <%= attributes.name %>\\r\\n                <\\/a>\\r\\n            <\\/div>\\r\\n\\r\\n            <% if(attributes.public_price == 1){ %>\\r\\n                <div class=\\\"clsBktServicePublicPrice clsHP clsTextGreen\\\">\\r\\n                    <% if(attributes.price_conf_type == 2 && attributes.min_price !== null){ %>\\r\\n                        Desde <%= attributes.min_price %><%\\/\\/= attributes.symbol %>\\r\\n                    <% }\\r\\n                       else{ %>\\r\\n                        <%= attributes.price_no_prepay %><%\\/\\/= attributes.symbol %>\\r\\n                    <% } %>\\r\\n                <\\/div>\\r\\n            <% } %>\\r\\n               \\r\\n            <div class='clsCB'><\\/div>\\r\\n        <\\/div>\\r\\n    <%\\r\\n    } %>\\r\\n<\\/script>\\r\\n\\r\\n<script type='text\\/template' id='idTemContinue'>\\r\\n    <a href='#selectservices'>\\r\\n        <div id=\\\"idDivBktServicesContinueButton\\\" class='clsDivContinueButton clsHPR'>\\r\\n            Continuar        <\\/div>\\r\\n\\r\\n        <div class='clsCB'><\\/div>\\r\\n    <\\/a>\\r\\n<\\/script>\\r\\n\\r\\n<script type='text\\/template' id='idTemBackToCustom'>\\r\\n    <div id='idBktServicesBackToCustomContainer'>\\r\\n        <a href='#custom'>\\r\\n            <div id='idBktServicesBackToCustomImage'><\\/div><div id='idBktServicesBackToCustomText'>Volver<\\/div>\\r\\n        <\\/a>\\r\\n    <\\/div>\\r\\n<\\/script>\\r\\n\\r\\n<script type='text\\/template' id='idTemSelectExtraServices'>\\r\\n    <div class=\\\"clsBktExtraServiceContainer\\\" data-service=\\\"<%= attributes.service %>\\\" data-extra=\\\"<%= attributes.id %>\\\">\\r\\n        <div class=\\\"clsBktExtraServiceContent\\\">\\r\\n            <% if(attributes.multiselect == 1){ %>\\r\\n                <div class=\\\"clsBktExtraServiceCheckboxContainer\\\">\\r\\n                    <input id='idCheckBox<%= attributes.id %>' type='checkbox' \\/>\\r\\n                    <label for='idCheckBox<%= attributes.id %>'>\\r\\n                <\\/div>\\r\\n            <% } %>\\r\\n\\r\\n            <div class=\\\"clsBktExtraServiceInfoContainer\\\">\\r\\n                <span class=\\\"clsBktExtraServiceName\\\">\\r\\n                    <%= attributes.name %>\\r\\n                <\\/span>\\r\\n\\r\\n                <% if(typeof attributes.price !== 'undefined' && attributes.price.length > 0){ %>\\r\\n                    <span class=\\\"clsBktExtraServicePrice\\\">\\r\\n                        <%= attributes.price %>\\r\\n                    <\\/span>\\r\\n                <% } %>                                        \\r\\n            <\\/div>\\r\\n        <\\/div>\\r\\n\\r\\n        <% if(attributes.description !== null && attributes.description.length > 0){ %>\\r\\n            <div class=\\\"clsBktExtraServiceDescription\\\">\\r\\n                <%= attributes.description %>\\r\\n            <\\/div>\\r\\n        <% } %>\\r\\n    <\\/div>\\r\\n<\\/script>\\r\\n\\r\\n<script type='text\\/template' id='idTemSelectSelectedService'>\\r\\n    <% if(attributes.separator === true){ %>\\r\\n        <span class=\\\"clsBktSummaryTextGrey clsBktSummaryTextBold\\\"> | <\\/span>\\r\\n    <% } %>    \\r\\n    \\r\\n    <span class=\\\"clsBktSummaryTextGrey\\\"><%= attributes.name %><\\/span>\\r\\n        \\r\\n    <% if(attributes.price !== null && attributes.price.length > 0){ %>\\r\\n        <span class=\\\"clsBktSummaryTextBlue\\\"><%= attributes.price %><\\/span>\\r\\n    <% } %>\\r\\n<\\/script>\\r\\n\\r\\n<!--<script type=\\\"text\\/javascript\\\">\\r\\n    var bUseAccordionServiceGroup = ;\\r\\n<\\/script>-->\\r\\n\\r\\n<div id='idBktDefaultServicesContainer' class='clsBktDefaultWindow' style='display:none;'>   \\r\\n    <div id='idBktDefaultServicesErrorContainer' class=\\\"clsBktDefaultErrorContainer\\\" style='display:none'>\\r\\n        <div id=\\\"idDivBktDefaultErrorServicesLoadingData\\\" class=\\\"clsBktDefaultErrorText\\\">\\r\\n            Se ha producido un error al cargar los datos        <\\/div>\\r\\n\\r\\n        <a href=''>\\r\\n            <div class='clsDivContinueButton clsDivBackErrorButton clsHPR'>\\r\\n                Volver            <\\/div>\\r\\n        <\\/a>\\r\\n\\r\\n        <div class='clsCB'><\\/div>\\r\\n    <\\/div>\\r\\n    \\r\\n    <div id=\\\"idBktDefaultServicesContent\\\">\\r\\n        <div id=\\\"idDivBktDefaultServicesMainContent\\\">\\r\\n            <div id='idDivBktNumberOfPeopleContainer' style='display:none'>\\r\\n                <div id='idDivBktNumberOfPeopleContainerText'>\\r\\n                    <span class='clsTextOrange'>\\r\\n                        N\\u00famero de asistentes                    <\\/span>\\r\\n                <\\/div>\\r\\n\\r\\n                <div id='idDivBktNumberOfPeopleContainerSelect'>\\r\\n                    <select id='idSelNumberOfPeople'><\\/select>\\r\\n                <\\/div>\\r\\n            <\\/div>\\r\\n\\r\\n            <div id='idDivBktServicesContainer'>                   \\r\\n\\t\\t\\t\\t<div style='display: none; text-align: center; font-size: 1.500em; font-weight: bold;'>No hay horas disponibles.<br>Int\\u00e9ntelo de nuevo dentro de unos d\\u00edas.<\\/div>\\t\\t\\t\\t\\r\\n                <div style='text-align: center; font-size: 1.500em; font-weight: bold;'>No hay horas disponibles.<br>Int\\u00e9ntelo de nuevo dentro de unos d\\u00edas.<\\/div>                \\r\\n                <div id='idListServices'><\\/div>\\r\\n                \\r\\n                <div id=\\\"idBktDefaultServicesTextAfterServicesList\\\">\\r\\n                                    <\\/div>\\r\\n            <\\/div>\\r\\n        <\\/div>\\r\\n\\r\\n        <div id='idDivBktButtonContinueContainer' style='display:none'><\\/div>\\r\\n    <\\/div>\\r\\n<\\/div>\\r\\n\\r\\n<div id='idBktDefaultExtraServicesContainer' class='clsBktDefaultWindow' style='display:none;'>\\r\\n    <div id=\\\"idBktDefaultExtraServicesContent\\\">\\r\\n        <div id='idBktExtraServicesSummaryContainer'>            \\r\\n            <div id=\\\"idBktExtraServicesBackButtonContainer\\\">\\r\\n                <div id=\\\"idBktExtraServicesBackButtonIcon\\\"><\\/div>\\r\\n            <\\/div>\\r\\n            \\r\\n            <div id=\\\"idBktExtraServicesSummary\\\">\\r\\n                <div id=\\\"idBktExtraServicesSummaryTitle\\\">\\r\\n                    Resumen de servicios seleccionados                <\\/div>\\r\\n                \\r\\n                <div id=\\\"idBktExtraServicesSummaryInfo\\\">\\r\\n                    <div id=\\\"idBktExtraServiceSelectedServiceContainer\\\">\\r\\n                        <span class=\\\"clsBktSummaryTextGrey clsBktSummaryTextBold\\\">Servicio:<\\/span>\\r\\n                        <span id=\\\"idBktExtraServiceSelectedServiceInfo\\\"><\\/span>\\r\\n                    <\\/div>\\r\\n                    \\r\\n                    <div id=\\\"idBktExtraServiceSelectedExtrasContainer\\\" style=\\\"display: none\\\">\\r\\n                        <span class=\\\"clsBktSummaryTextGrey clsBktSummaryTextBold\\\">Extras:<\\/span>\\r\\n                        <span id=\\\"idBktExtraServiceSelectedExtraInfo\\\"><\\/span>\\r\\n                    <\\/div>\\r\\n                <\\/div>\\r\\n            <\\/div>\\r\\n            \\r\\n            <div id=\\\"idBktExtraServicesTotalContainer\\\">\\r\\n                <span id=\\\"idBktExtraServiceSelectedTotalText\\\">Total<\\/span>\\r\\n                <span id=\\\"idBktExtraServiceSelectedTotal\\\"><\\/span>                    \\r\\n            <\\/div>            \\r\\n        <\\/div>\\r\\n        \\r\\n        <div id='idBktExtraServicesListContainer'>\\r\\n            <div id='idBktExtraServicesListTitle'>\\r\\n                \\u00bfQuieres a\\u00f1adir alg\\u00fan servicio extra?            <\\/div>        \\r\\n\\r\\n            <div id='idListExtraServices'><\\/div>\\r\\n        <\\/div>\\r\\n\\r\\n        <div id=\\\"idBktExtraServicesContinueButtonContainer\\\">\\r\\n            <div id=\\\"idBktExtraServicesContinueButton\\\" class='clsDivContinueButton'>\\r\\n                Continuar            <\\/div>            \\r\\n        <\\/div>\\r\\n    <\\/div>\\r\\n<\\/div><script type=\\\"text\\/template\\\" id=\\\"idTemSelectAgendas\\\">\\n    <a href='#selectagenda\\/<%= attributes.id %>'>\\n        <div class=\\\"clsDivBktAgendaContent <% if(typeof attributes.cls !== 'undefined'){ print(attributes.cls); } %>\\\">\\n            <div class=\\\"clsDivBktAgendaContentData\\\">\\n                <div class=\\\"clsDivBktAgendaDataImageContainer\\\">\\n                    <div class=\\\"clsDivBktAgendaContentImage\\\">\\n                    <%\\n                    if(attributes.photo.length > 0){ %>\\n                        <div class=\\\"clsDivBktAgendaContentImageCell\\\">\\n                            <div class=\\\"clsDivBktAgendaImage\\\" alt=\\\"<%= attributes.name %>\\\" style=\\\"background-image: url('<%= attributes.photo %>')\\\"><\\/div>\\n                        <\\/div>\\n                    <%\\n                    } %>\\n                    <\\/div>\\n                <\\/div>\\n        \\n                <div class=\\\"clsDivBktAgendaDataNameContainer\\\">\\n                    <div class=\\\"clsDivBktAgendaContentName\\\">\\n                        <div class=\\\"clsDivBktAgendaContentNameText\\\">\\n                            <%= attributes.name %>\\n                        <\\/div>\\n                    <\\/div>\\n                <\\/div>\\n\\n                <div class='clsCB'><\\/div>\\n            <\\/div>\\n        <\\/div>\\n    <\\/a>\\n<\\/script>\\n\\n<script type=\\\"text\\/template\\\" id=\\\"idTemBackToServices\\\">\\n    <a href=\\\"#services\\\">\\n        <div class=\\\"clsDivSubHeaderBackButton\\\"><\\/div>\\n    <\\/a>\\n<\\/script>\\n\\n<div id=\\\"idBktDefaultAgendasContainer\\\" class=\\\"clsBktDefaultWindow\\\" style=\\\"display:none;\\\">\\n    <div class=\\\"clsDivSubHeader\\\">\\n        <div class=\\\"clsDivSubHeaderBreadcrumbs\\\">\\n            <div class=\\\"clsDivSubHeaderBreadcrumbsText\\\" title=\\\"\\\"><\\/div>\\n        <\\/div>\\n        \\n        <div class='clsCB'><\\/div>\\n    <\\/div>\\n    \\n    <div id='idDivBktAgendasContainer'>      \\n        <div id=\\\"idBktDefaultAgendaTextBeforeAgendasList\\\">\\n                    <\\/div>\\t\\t\\n\\t\\t\\n        <div id='idBktDefaultAgendasErrorContainer' class=\\\"clsBktDefaultErrorContainer\\\" style='display:none'>\\n            <div id=\\\"idDivBktDefaultErrorAgendasLoadingData\\\" class=\\\"clsBktDefaultErrorText\\\">\\n                Se ha producido un error al cargar los datos            <\\/div>\\n            \\n            <div id=\\\"idDivBktDefaultErrorAgendasNoAvailable\\\" class=\\\"clsBktDefaultErrorText\\\">\\n                No hay agendas disponibles para este servicio            <\\/div>\\n\\n            <a href='#services'>\\n                <div class='clsDivContinueButton clsDivBackErrorButton clsHPR'>\\n                    Volver                <\\/div>\\n            <\\/a>\\n\\n            <div class='clsCB'><\\/div>\\n        <\\/div>\\n        \\n        <div id='idListAgendas' class=\\\"clsDivBktCards\\\"><\\/div>\\n        \\n        <div class='clsCB'><\\/div>\\n    <\\/div>\\n<\\/div><script type=\\\"text\\/template\\\" id=\\\"idTemAvailableTime\\\">\\r\\n    <a href='#selecttime\\/<%= date %>\\/<%= time %>\\/<%= agenda %>'>\\r\\n        <div class=\\\"clsDivDatetimeSlot\\\" <% if(typeof timestamp !== 'undefined'){ %> data-datetime=\\\"<%= timestamp %>\\\" <% } %> >\\r\\n            <%\\r\\n            if(typeof time_text !== 'undefined'){ %>\\r\\n                <span class=\\\"clsDivDatetimeSlotTime\\\"><%= time_text %><\\/span>\\r\\n            <%\\r\\n            }\\r\\n            else{ %>\\r\\n                <span class=\\\"clsDivDatetimeSlotTime\\\"><%= time %><\\/span>\\r\\n            <%        \\r\\n            } %>            \\r\\n            \\r\\n            <%\\r\\n            if(typeof freeslots !== 'undefined'){ %>\\r\\n                <div class=\\\"clsDivDatetimeSlotFree\\\">\\r\\n                    <%\\r\\n                    if(freeslots <= 1){ %>\\r\\n                        <%= freeslots %> Hueco libre                    <%\\r\\n                    }\\r\\n                    else{ %>\\r\\n                        <%= freeslots %> Huecos libres                    <%\\r\\n                    } %>\\r\\n                <\\/div>\\r\\n            <%\\r\\n            } %>            \\r\\n            \\r\\n            <%\\r\\n            if(typeof price !== 'undefined'){ %>\\r\\n                <div class=\\\"clsDivDatetimeSlotPrice\\\">\\r\\n                    <%= price %><%\\/\\/= currency %>\\r\\n                <\\/div>\\r\\n            <%\\r\\n            } %>\\r\\n        <\\/div>\\r\\n    <\\/a>\\r\\n<\\/script>\\r\\n\\r\\n<script type=\\\"text\\/template\\\" id=\\\"idTemAvailableWaitingList\\\">\\r\\n    <div class=\\\"clsDivDatetimeSlot clsDivDatetimeSlotWaitingList\\\" data-date=\\\"<%= date %>\\\" data-time=\\\"<%= time %>\\\" <% if(typeof timestamp !== 'undefined'){ %> data-datetime=\\\"<%= timestamp %>\\\" <% } %>>\\r\\n        <span class=\\\"clsDivDatetimeSlotTime\\\"><%= time %><\\/span>\\r\\n\\r\\n        <%\\r\\n        if(typeof freeslots !== 'undefined'){ %>\\r\\n            <div class=\\\"clsDivDatetimeSlotFree\\\">\\r\\n                <%\\r\\n                if(freeslots <= 1){ %>\\r\\n                    <%= freeslots %> Hueco libre                <%\\r\\n                }\\r\\n                else{ %>\\r\\n                    <%= freeslots %> Huecos libres                <%\\r\\n                } %>\\r\\n            <\\/div>\\r\\n        <%\\r\\n        } %>            \\r\\n\\r\\n        <%\\r\\n        if(typeof price !== 'undefined'){ %>\\r\\n            <div class=\\\"clsDivDatetimeSlotPrice\\\">\\r\\n                <%= price %><%\\/\\/= currency %>\\r\\n            <\\/div>\\r\\n        <%\\r\\n        } %>\\r\\n        \\r\\n        <div class=\\\"clsDivDatetimeWaitListText\\\">\\r\\n            Ap\\u00fantate en lista de espera aqu\\u00ed        <\\/div>\\r\\n    <\\/div>\\r\\n<\\/script>\\r\\n\\r\\n<script type=\\\"text\\/template\\\" id=\\\"idTemNotAvailableSlots\\\">\\r\\n    <div id=\\\"idDivNotAvailableSlotsContainer\\\">\\r\\n        <div id=\\\"idDivNotAvailableSlotsTextTop\\\">\\r\\n            No hay horas disponibles. Int\\u00e9ntelo de nuevo dentro de unos d\\u00edas.        <\\/div>\\r\\n        \\r\\n        <div id=\\\"idDivNotAvailableSlotsTextBottom\\\">\\r\\n                           \\r\\n        <\\/div>\\r\\n    <\\/div>\\r\\n<\\/script>\\r\\n\\r\\n<script type=\\\"text\\/template\\\" id=\\\"idTemNotAvailableSlotsWaitingList\\\">\\r\\n    <div id=\\\"idDivWaitingListContainer\\\" style=\\\"display: none\\\">\\r\\n        <div id=\\\"idDivWaitingListTextTop\\\">\\r\\n            <div id=\\\"idDivWaitingListTextTop\\\">\\u00bfQuieres apuntarte a la lista de espera?<\\/div>\\r\\n        <\\/div>\\r\\n        \\r\\n        <div id=\\\"idDivWaitingListOptions\\\">\\r\\n            <div style=\\\"display: table-row\\\">\\r\\n                <div style=\\\"display: table-cell; color: #e7522d; padding-right: 20px;\\\">Fecha<\\/div>\\r\\n                <div id=\\\"idDivWaitingListDatetime\\\" style=\\\"display: table-cell\\\"><\\/div>\\r\\n            <\\/div>\\r\\n            <div style=\\\"display: table-row\\\">\\r\\n                <div style=\\\"display: table-cell; color: #e7522d; padding-right: 20px;\\\">Servicio<\\/div>\\r\\n                <div id=\\\"idDivWaitingListService\\\" style=\\\"display: table-cell\\\"><\\/div>\\r\\n            <\\/div>\\r\\n            <div style=\\\"display: table-row\\\">\\r\\n                <div style=\\\"display: table-cell; color: #e7522d; padding-right: 20px;\\\">Agenda<\\/div>\\r\\n                <div id=\\\"idDivWaitingListAgenda\\\" style=\\\"display: table-cell\\\"><\\/div>\\r\\n            <\\/div>\\r\\n        <\\/div>\\r\\n        \\r\\n        <div id=\\\"idDivWaitingListSubmit\\\" class=\\\"clsDivContinueButton\\\">\\r\\n            Apuntarme en la lista de espera        <\\/div>\\r\\n        \\r\\n        <div id=\\\"idDivWaitingListBack\\\">\\r\\n            o selecciona <span id='idSpanWaitingListOtherTime'>otra hora<\\/span>        <\\/div>\\r\\n    <\\/div>\\r\\n<\\/script>\\r\\n\\r\\n<script type=\\\"text\\/template\\\" id=\\\"idTemSlotColumns\\\">\\r\\n    <% if(lastColumn === true){ %>\\r\\n        <div id=\\\"idDivSlotColumnContainer-<%= column %>\\\" class=\\\"clsDivSlotColumnContainerLast\\\"><\\/div>\\r\\n        <div class='clsCB'><\\/div>\\r\\n    <% }\\r\\n    else{%>\\r\\n        <div id=\\\"idDivSlotColumnContainer-<%= column %>\\\" class=\\\"clsDivSlotColumnContainer\\\"><\\/div>\\r\\n    <% } %>\\r\\n<\\/script>\\r\\n\\r\\n<script type=\\\"text\\/template\\\" id=\\\"idTemBackToAgendas\\\">\\r\\n    <a href=\\\"#agendas\\\">\\r\\n        <div class=\\\"clsDivSubHeaderBackButton\\\"><\\/div>\\r\\n    <\\/a>\\r\\n<\\/script>\\r\\n\\r\\n<div id=\\\"idBktDefaultDatetimeContainer\\\" class=\\\"clsBktDefaultWindow\\\" style=\\\"display:none;\\\">\\r\\n    <div class=\\\"clsDivSubHeader\\\">\\r\\n        <div class=\\\"clsDivSubHeaderBreadcrumbs\\\">\\r\\n            <div class=\\\"clsDivSubHeaderBreadcrumbsText\\\"><\\/div>\\r\\n        <\\/div>\\r\\n        \\r\\n        <div class='clsCB'><\\/div>\\r\\n    <\\/div>\\r\\n    \\r\\n    <div id=\\\"idDivBktDatetimeContainer\\\">        \\r\\n        <div id='idDivBktNumberOfPeopleContainerDatetime' style='display:none'>\\r\\n            <div id='idDivBktNumberOfPeopleContainerTextDatetime'>\\r\\n                <span class='clsTextOrange'>\\r\\n                    N\\u00famero de asistentes                <\\/span>\\r\\n            <\\/div>\\r\\n\\r\\n            <div id='idDivBktNumberOfPeopleContainerSelectDatetime'>\\r\\n                <select id='idSelNumberOfPeopleDatime'><\\/select>\\r\\n            <\\/div>\\r\\n        <\\/div>\\r\\n        \\r\\n        <div id=\\\"idDivBktDatetimeDatepickerContainer\\\">\\r\\n            <div id=\\\"idDivBktDatetimeDatepickerChooseContainer\\\">\\r\\n                <div id=\\\"idDivBktDatetimeDatePickerContent\\\">\\r\\n                    <div id=\\\"idDivBktDatetimeDatePickerIcon\\\">\\r\\n\\r\\n                    <\\/div>\\r\\n                    <div id=\\\"idDivBktDatetimeDatePickerText\\\">\\r\\n                        Cambiar de d\\u00eda                    <\\/div>\\r\\n                    <div class='clsCB'><\\/div>\\r\\n\\r\\n                    <div id=\\\"idDivBktDatetimeDatePicker\\\"><\\/div>\\r\\n                <\\/div>\\r\\n            <\\/div>\\r\\n            \\r\\n            <div id=\\\"idDivBktDatetimeSelectedDateContainer\\\">\\r\\n                <div id=\\\"idDivBktDatetimeSelectedDateContent\\\">\\r\\n                    <div id=\\\"idDivBktDatetimeSelectedDateRight\\\"><\\/div>\\r\\n\\r\\n                    <div id=\\\"idDivBktDatetimeSelectedDate\\\"><\\/div>\\r\\n\\r\\n                    <div id=\\\"idDivBktDatetimeSelectedDateLeft\\\"><\\/div>\\r\\n\\r\\n                    <div class='clsCB'><\\/div>\\r\\n                <\\/div>\\r\\n                \\r\\n                <div class='clsCB'><\\/div>\\r\\n            <\\/div>\\r\\n            \\r\\n            <div class='clsCB'><\\/div>\\r\\n        <\\/div>\\r\\n        \\r\\n        <div id=\\\"idBktDefaultDatetimeTextBeforeSlotsList\\\">\\r\\n                    <\\/div>         \\r\\n        \\r\\n                \\r\\n        <div id='idDivBktSlotsContainer'>    \\r\\n            <div id='idBktDefaultDatetimeErrorContainer' class=\\\"clsBktDefaultErrorContainer\\\" style='display:none'>\\r\\n                <div id=\\\"idDivBktDefaultErrorDatetimeLoadingData\\\" class=\\\"clsBktDefaultErrorText\\\">\\r\\n                    Se ha producido un error al cargar los datos                <\\/div>\\r\\n\\r\\n                <a href='#services'>\\r\\n                    <div class='clsDivContinueButton clsDivBackErrorButton clsHPR'>\\r\\n                        Volver                    <\\/div>\\r\\n                <\\/a>\\r\\n\\r\\n                <div class='clsCB'><\\/div>\\r\\n            <\\/div>\\r\\n            \\r\\n            <div id='idBktDefaultDatetimeDataErrorContainer' class=\\\"clsBktDefaultErrorContainer\\\" style='display:none'><\\/div>\\r\\n                \\r\\n            <div id=\\\"idTimeListTable\\\"><\\/div>\\r\\n\\r\\n            <div class='clsCB'><\\/div>\\r\\n        <\\/div>\\r\\n    <\\/div>\\r\\n<\\/div><script type=\\\"text\\/template\\\" id=\\\"idTemSignupInputFieldsRowContainer\\\">\\r\\n    <div id=\\\"idBktDefaultSignUpRow-<%= iRow %>\\\" class=\\\"<%= sClass %>\\\"><\\/div>\\r\\n<\\/script>\\r\\n\\r\\n<script type=\\\"text\\/template\\\" id=\\\"idTemSignupInputSelectOption\\\">\\r\\n    <% if(bOptionSelected === true){ %>\\r\\n        <option selected = \\\"selected\\\" value=\\\"<%= iOptionValue %>\\\"><%= sOptionText %><\\/option>\\r\\n    <% }\\r\\n    else { %>\\r\\n        <option value=\\\"<%= iOptionValue %>\\\"><%= sOptionText %><\\/option>\\r\\n    <% } %>\\r\\n<\\/script>\\r\\n\\r\\n<script type=\\\"text\\/template\\\" id=\\\"idTemSignupInputFieldsText\\\">\\r\\n    <div class=\\\"clsDivBktSignupFormInput\\\">\\r\\n        <%\\r\\n        if(typeof attributes.before_text !== 'undefined'){ %>\\r\\n            <div id=\\\"idBktDefaultSignUpTextBeforeFieldText<%= attributes.input_text %>\\\">\\r\\n                <%= attributes.before_text %>\\r\\n            <\\/div>\\r\\n        <%            \\r\\n        } %>\\r\\n\\r\\n        <input id=\\\"idIptBkt<%= attributes.input_text %>\\\" type=\\\"text\\\" name=\\\"<%= attributes.input_text %>\\\" placeholder=\\\"<%= sShowText %>\\\" value=\\\"<%= sValue %>\\\" \\/>\\r\\n        \\r\\n        <div id=\\\"idDivBktFieldError<%= attributes.input_text %>\\\" class=\\\"clsDivBktDefaultFieldError\\\"><\\/div>\\r\\n\\r\\n        <%\\r\\n        if(typeof attributes.after_text !== 'undefined'){ %>\\r\\n            <div id=\\\"idBktDefaultSignUpTextAfterFieldText<%= attributes.input_text %>\\\">\\r\\n                <%= attributes.after_text %>\\r\\n            <\\/div>\\r\\n        <%            \\r\\n        } %>\\r\\n    <\\/div>\\r\\n<\\/script>\\r\\n\\r\\n<script type=\\\"text\\/template\\\" id=\\\"idTemSignupInputFieldsPassword\\\">\\r\\n    <div class=\\\"clsDivBktSignupFormInput\\\">\\r\\n        <input id=\\\"idIptBkt<%= attributes.input_text %>\\\" type=\\\"password\\\" name=\\\"<%= attributes.input_text %>\\\" placeholder=\\\"<%= sShowText %>\\\" value=\\\"<%= sValue %>\\\" \\/>\\r\\n        \\r\\n        <div id=\\\"idDivBktFieldError<%= attributes.input_text %>\\\" class=\\\"clsDivBktDefaultFieldError\\\"><\\/div>\\r\\n    <\\/div>\\r\\n<\\/script>\\r\\n\\r\\n<script type=\\\"text\\/template\\\" id=\\\"idTemSignupInputFieldsCheckBox\\\">\\r\\n    <div class=\\\"clsDivBktSignupFormInput\\\">\\r\\n        <%\\r\\n        if(typeof attributes.before_text !== 'undefined'){ %>\\r\\n            <div id=\\\"idBktDefaultSignUpTextBeforeFieldCheckbox<%= attributes.input_text %>\\\">\\r\\n                <%= attributes.before_text %>\\r\\n            <\\/div>\\r\\n        <%            \\r\\n        } %>\\r\\n        \\r\\n        <div class=\\\"clsDivBktSignupFormInputCheckboxContainer\\\">\\r\\n            <div class=\\\"clsDivBktSignupFormInputCheckboxInput\\\">\\r\\n                <input id=\\\"idIptBkt<%= attributes.input_text %>\\\" type=\\\"checkbox\\\" value=\\\"1\\\" name=\\\"<%= attributes.input_text %>\\\" \\/>\\r\\n                <label for=\\\"idIptBkt<%= attributes.input_text %>\\\">\\r\\n            <\\/div>\\r\\n\\r\\n            <div class=\\\"clsDivBktSignupFormInputCheckboxLabel\\\">\\r\\n                <%= sShowText %>\\r\\n            <\\/div>\\r\\n        <\\/div>\\r\\n        \\r\\n        <div id=\\\"idDivBktFieldError<%= attributes.input_text %>\\\" class=\\\"clsDivBktDefaultFieldError\\\"><\\/div>\\r\\n        \\r\\n        <%\\r\\n        if(typeof attributes.after_text !== 'undefined'){ %>\\r\\n            <div id=\\\"idBktDefaultSignUpTextAfterFieldCheckbox<%= attributes.input_text %>\\\">\\r\\n                <%= attributes.after_text %>\\r\\n            <\\/div>\\r\\n        <%            \\r\\n        } %>        \\r\\n    <\\/div>\\r\\n<\\/script>\\r\\n\\r\\n<script type=\\\"text\\/template\\\" id=\\\"idTemSignupInputFieldsDrop\\\">\\r\\n    <div class=\\\"clsDivBktSignupFormInput\\\">\\r\\n        <%\\r\\n        if(typeof attributes.before_text !== 'undefined'){ %>\\r\\n            <div id=\\\"idBktDefaultSignUpTextBeforeFieldDrop<%= attributes.input_text %>\\\">\\r\\n                <%= attributes.before_text %>\\r\\n            <\\/div>\\r\\n        <%            \\r\\n        } %>    \\r\\n    \\r\\n        <div class=\\\"clsDivBktSignupFormInputDropContainer\\\">\\r\\n            <select id=\\\"idIptBkt<%= attributes.input_text %>\\\" onChange=\\\"this.blur()\\\" name=\\\"<%= attributes.input_text %>\\\">\\r\\n                <option value=\\\"-1\\\"><%= sShowText %><\\/option>\\r\\n            <\\/select>\\r\\n        <\\/div>\\r\\n        \\r\\n        <div id=\\\"idDivBktFieldError<%= attributes.input_text %>\\\" class=\\\"clsDivBktDefaultFieldError\\\"><\\/div>\\r\\n        \\r\\n        <%\\r\\n        if(typeof attributes.after_text !== 'undefined'){ %>\\r\\n            <div id=\\\"idBktDefaultSignUpTextAfterFieldDrop<%= attributes.input_text %>\\\">\\r\\n                <%= attributes.after_text %>\\r\\n            <\\/div>\\r\\n        <%            \\r\\n        } %>        \\r\\n    <\\/div>\\r\\n<\\/script>\\r\\n\\r\\n<script type=\\\"text\\/template\\\" id=\\\"idTemSignupInputFieldsDropAndText\\\">\\r\\n    <div class=\\\"clsDivBktSignupFormInput\\\">\\r\\n        <%\\r\\n        if(typeof attributes.before_text !== 'undefined'){ %>\\r\\n            <div id=\\\"idBktDefaultSignUpTextBeforeFieldText<%= attributes.input_text %>\\\">\\r\\n                <%= attributes.before_text %>\\r\\n            <\\/div>\\r\\n        <%            \\r\\n        } %>    \\r\\n    \\r\\n        <div class=\\\"clsDivBktSignupFormInputDropAndTextContainer\\\">\\r\\n            <div class=\\\"clsDivBktSignupFormInputDropAndTextField clsDivBktSignupFormInputDropAndTextFieldSelect\\\">\\r\\n                <select id=\\\"idIptBktInternationalCode<%= attributes.input_text %>\\\" onChange=\\\"this.blur()\\\" name=\\\"<%= attributes.input_text %>_countries_id\\\"><\\/select>\\r\\n            <\\/div>\\r\\n            \\r\\n            <div class=\\\"clsDivBktSignupFormInputDropAndTextField clsDivBktSignupFormInputDropAndTextFieldInput\\\">\\r\\n                <input id=\\\"idIptBkt<%= attributes.input_text %>\\\" type=\\\"tel\\\" name=\\\"<%= attributes.input_text %>\\\" placeholder=\\\"<%= sShowText %>\\\" value=\\\"<%= sValue %>\\\" \\/>\\r\\n            <\\/div>\\r\\n        <\\/div>\\r\\n        \\r\\n        <div id=\\\"idDivBktFieldError<%= attributes.input_text %>\\\" class=\\\"clsDivBktDefaultFieldError\\\"><\\/div>\\r\\n    <\\/div>\\r\\n<\\/script>\\r\\n\\r\\n<script type=\\\"text\\/template\\\" id=\\\"idTemSignupVoucherInputField\\\">\\r\\n    <div id=\\\"idBktDefaultSignUpRowVoucher\\\" class=\\\"clsDivBktDefaultSignUpRow\\\">\\r\\n        <div class=\\\"clsDivBktSignupFormInput\\\">\\r\\n            <input id=\\\"idIptBktvoucher\\\" type=\\\"text\\\" name=\\\"voucher\\\" placeholder=\\\"C\\u00f3digo de bono\\\" value=\\\"\\\" \\/>\\r\\n        <\\/div>\\r\\n    <\\/div>\\r\\n\\t\\r\\n\\t<div id=\\\"idDivBktFieldErrorvoucher\\\" class=\\\"clsDivBktDefaultFieldError\\\"><\\/div>\\r\\n<\\/script>\\r\\n\\r\\n<div id=\\\"idBktDefaultSignUpContainer\\\" class=\\\"clsBktDefaultWindow\\\" style=\\\"display:none;\\\">\\r\\n    <div class=\\\"clsDivSubHeader\\\">\\r\\n        <a href=\\\"#datetime\\\">\\r\\n            <div class=\\\"clsDivSubHeaderBackButton\\\"><\\/div>\\r\\n        <\\/a>\\r\\n        \\r\\n        <div class=\\\"clsDivSubHeaderBreadcrumbs\\\">\\r\\n            <div class=\\\"clsDivSubHeaderBreadcrumbsText\\\"><\\/div>\\r\\n        <\\/div>\\r\\n        \\r\\n        <div class=\\\"clsCB\\\"><\\/div>\\r\\n    <\\/div>\\r\\n    \\r\\n    <div id=\\\"idDivBktSignUpSubHeader\\\" class=\\\"clsDivBktSubHeaderExtra\\\">\\r\\n        <div id=\\\"idDivBktSignUpSubHeaderNewAccount\\\" class=\\\"clsDivBktSubHeaderExtraOption\\\">\\r\\n            <div class=\\\"clsDivBktSubHeaderExtraOptionIconText\\\">\\r\\n                Soy usuario nuevo            <\\/div>\\r\\n            \\r\\n            <div class=\\\"clsCB\\\"><\\/div>\\r\\n        <\\/div>\\r\\n        \\r\\n        <div id=\\\"idDivBktSignUpSubHeaderAccount\\\" class=\\\"clsDivBktSubHeaderExtraOption\\\">\\r\\n            <div class=\\\"clsDivBktSubHeaderExtraOptionIconText\\\">\\r\\n                Ya tengo cuenta              \\r\\n            <\\/div>\\r\\n            \\r\\n            <div class=\\\"clsCB\\\"><\\/div>\\r\\n        <\\/div>\\r\\n        \\r\\n        <div class=\\\"clsCB\\\"><\\/div>\\r\\n    <\\/div>\\r\\n       \\r\\n    <div id=\\\"idDivBktSignUpContainer\\\">\\r\\n        <div id=\\\"idBktDefaultSignUpErrorContainer\\\" class=\\\"clsBktDefaultErrorContainer\\\" style=\\\"display:none\\\">\\r\\n            <div id=\\\"idDivBktDefaultErrorSignUpLoadingData\\\" class=\\\"clsBktDefaultErrorText\\\">\\r\\n                Se ha producido un error al cargar los datos            <\\/div>\\r\\n\\r\\n            <a href=\\\"#services\\\">\\r\\n                <div class=\\\"clsDivContinueButton clsDivBackErrorButton clsHPR\\\">\\r\\n                    Volver                   \\r\\n                <\\/div>\\r\\n            <\\/a>\\r\\n\\r\\n            <div class=\\\"clsCB\\\"><\\/div>\\r\\n        <\\/div>\\r\\n        \\r\\n        <div id=\\\"idBktDefaultSignUpTextBeforeFields\\\">\\r\\n                    <\\/div>        \\r\\n        \\r\\n        <form id=\\\"idFormSignUpContainer\\\">\\r\\n            <div id=\\\"idBktDefaultSignUpContainerFields\\\"><\\/div>\\r\\n            \\r\\n            <div id=\\\"idBktDefaultSignUpTextBeforeComments\\\">\\r\\n                            <\\/div>\\r\\n            \\r\\n                        \\r\\n            <div id=\\\"idBktDefaultSignUpTextAfterComments\\\">\\r\\n                            <\\/div>            \\r\\n            \\r\\n            <div id=\\\"idBktDefaultSignUpSubFooterContainer\\\">\\r\\n                <div id=\\\"idBktDefaultSignUpAccept\\\">\\r\\n                    <div id=\\\"idBktDefaultSignUpAcceptInput\\\">\\r\\n                        <input id=\\\"idIptBktAcceptCondtions\\\" type=\\\"checkbox\\\" name=\\\"accept_conditions\\\" value=\\\"1\\\"><\\/input>\\r\\n                        <label for=\\\"idIptBktAcceptCondtions\\\" \\/>\\r\\n                    <\\/div>\\r\\n\\r\\n                                            <div id=\\\"idBktDefaultSignUpAcceptText\\\">\\r\\n                            Declaro conocer y entender la\\r\\n                            <span id=\\\"idSpanBktDefaultSignUpLinkAccept\\\">pol\\u00edtica de privacidad<\\/span>\\r\\n                        <\\/div>\\r\\n                                        \\r\\n                    <div class=\\\"clsCB\\\"><\\/div>\\r\\n                    \\r\\n                    <div id=\\\"idDivBktFieldErroraccept_conditions\\\" class=\\\"clsDivBktDefaultFieldError\\\"><\\/div>\\r\\n                <\\/div>\\r\\n                \\r\\n                <div id=\\\"idBktDefaultSignUpConfirmButtonContainer\\\">\\r\\n                                            <div id=\\\"idBktDefaultSignUpConfirmButton\\\" class=\\\"clsDivContinueButton clsHPR\\\">Confirmar<\\/div>\\r\\n                                            \\r\\n                    <div class=\\\"clsCB\\\"><\\/div>\\r\\n                <\\/div>            \\r\\n                \\r\\n                <div class=\\\"clsCB\\\"><\\/div>\\r\\n            <\\/div>\\r\\n        <\\/form>\\r\\n    <\\/div>\\r\\n<\\/div><script type=\\\"text\\/template\\\" id=\\\"idTemSignInInputSelectOption\\\">\\r\\n    <option value='<%= iOptionValue %>'><%= sOptionText %><\\/option>\\r\\n<\\/script>\\r\\n\\r\\n<script type=\\\"text\\/template\\\" id=\\\"idTemSignInInputFieldsText\\\">\\r\\n    <div class='clsDivBktDefaultSignInRow'>\\r\\n        <div class='clsDivBktSignInFormInput'>\\r\\n            <%\\r\\n            if(typeof attributes.before_text !== 'undefined'){ %>\\r\\n                <div id=\\\"idBktDefaultSignInTextBeforeFieldText<%= attributes.input_text %>\\\">\\r\\n                    <%= attributes.before_text %>\\r\\n                <\\/div>\\r\\n            <%            \\r\\n            } %>        \\r\\n            \\r\\n            <input id='idIptBktSignIn<%= attributes.input_text %>' type='text' name='<%= attributes.input_text %>' placeholder='<%= sShowText %>' value='<%= sValue %>' \\/>\\r\\n            \\r\\n            <%\\r\\n            if(typeof attributes.after_text !== 'undefined'){ %>\\r\\n                <div id=\\\"idBktDefaultSignInTextAfterFieldText<%= attributes.input_text %>\\\">\\r\\n                    <%= attributes.after_text %>\\r\\n                <\\/div>\\r\\n            <%            \\r\\n            } %>            \\r\\n        <\\/div>\\r\\n    <\\/div>\\r\\n<\\/script>\\r\\n\\r\\n<script type=\\\"text\\/template\\\" id=\\\"idTemSignInInputFieldsCheckBox\\\">\\r\\n    <div class='clsDivBktDefaultSignInRow'>\\r\\n        <div class='clsDivBktSignInFormInput'>\\r\\n            <%\\r\\n            if(typeof attributes.before_text !== 'undefined'){ %>\\r\\n                <div id=\\\"idBktDefaultSignInTextBeforeFieldCheckbox<%= attributes.input_text %>\\\">\\r\\n                    <%= attributes.before_text %>\\r\\n                <\\/div>\\r\\n            <%            \\r\\n            } %>        \\r\\n            \\r\\n            <div class='clsDivBktSignInFormInputCheckboxContainer'>\\r\\n                <div class='clsDivBktSignInFormInputCheckboxInput'>\\r\\n                    <input id='idIptBktSignIn<%= attributes.input_text %>' type='checkbox' value='1' name='<%= attributes.input_text %>' \\/>\\r\\n                    <label for='idIptBktSignIn<%= attributes.input_text %>'>\\r\\n                <\\/div>\\r\\n\\r\\n                <div class='clsDivBktSignInFormInputCheckboxLabel'>\\r\\n                    <%= sShowText %>\\r\\n                <\\/div>\\r\\n            <\\/div>\\r\\n\\r\\n            <div id='idDivBktSignInFieldError<%= attributes.input_text %>' class=\\\"clsDivBktDefaultFieldError\\\"><\\/div>\\r\\n            \\r\\n            <%\\r\\n            if(typeof attributes.after_text !== 'undefined'){ %>\\r\\n                <div id=\\\"idBktDefaultSignInTextAfterFieldCheckbox<%= attributes.input_text %>\\\">\\r\\n                    <%= attributes.after_text %>\\r\\n                <\\/div>\\r\\n            <%            \\r\\n            } %>            \\r\\n        <\\/div>\\r\\n    <\\/div>\\r\\n<\\/script>\\r\\n\\r\\n<script type=\\\"text\\/template\\\" id=\\\"idTemSignInInputFieldsDrop\\\">\\r\\n    <div class='clsDivBktDefaultSignInRow'>\\r\\n        <div class='clsDivBktSignInFormInput'>\\r\\n            <%\\r\\n            if(typeof attributes.before_text !== 'undefined'){ %>\\r\\n                <div id=\\\"idBktDefaultSignInTextBeforeFieldDrop<%= attributes.input_text %>\\\">\\r\\n                    <%= attributes.before_text %>\\r\\n                <\\/div>\\r\\n            <%            \\r\\n            } %>         \\r\\n        \\r\\n            <div clas