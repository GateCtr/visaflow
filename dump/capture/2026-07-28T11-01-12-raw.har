iv id=\\\"idBktDefaultSignInRowVoucher\\\" class=\\\"clsDivBktDefaultSignInRow\\\">\\r\\n        <div class='clsDivBktSignInFormInput'>\\r\\n            <input id='idIptBktSignInvoucher' type='text' name='voucher' placeholder='C\\u00f3digo de bono' value='' \\/>\\r\\n        <\\/div>\\r\\n    <\\/div>\\r\\n\\t\\r\\n\\t<div id=\\\"idDivBktSignInFieldErrorvoucher\\\" class=\\\"clsDivBktDefaultFieldError\\\"><\\/div>\\r\\n<\\/script>\\r\\n\\r\\n\\r\\n<div id=\\\"idBktDefaultSignInContainer\\\" class=\\\"clsBktDefaultWindow\\\" style=\\\"display:none;\\\">\\r\\n    <div class=\\\"clsDivSubHeader\\\">\\r\\n        <a href=\\\"#datetime\\\">\\r\\n            <div class=\\\"clsDivSubHeaderBackButton\\\"><\\/div>\\r\\n        <\\/a>\\r\\n        \\r\\n         <div class=\\\"clsDivSubHeaderBreadcrumbs\\\">\\r\\n            <div class=\\\"clsDivSubHeaderBreadcrumbsText\\\"><\\/div>\\r\\n        <\\/div>\\r\\n        \\r\\n        <div class='clsCB'><\\/div>\\r\\n    <\\/div>\\r\\n    \\r\\n    <div id=\\\"idDivBktSignInSubHeader\\\" class=\\\"clsDivBktSubHeaderExtra\\\">\\r\\n        <div id=\\\"idDivBktSignInSubHeaderNewAccount\\\" class=\\\"clsDivBktSubHeaderExtraOption\\\">\\r\\n            <div class=\\\"clsDivBktSubHeaderExtraOptionIconText\\\">\\r\\n                Soy usuario nuevo            <\\/div>\\r\\n            \\r\\n            <div class='clsCB'><\\/div>\\r\\n        <\\/div>\\r\\n        \\r\\n        <div id=\\\"idDivBktSignInSubHeaderAccount\\\" class=\\\"clsDivBktSubHeaderExtraOption\\\">\\r\\n            <div class=\\\"clsDivBktSubHeaderExtraOptionIconText\\\">\\r\\n                Ya tengo cuenta            <\\/div>\\r\\n            \\r\\n            <div class='clsCB'><\\/div>\\r\\n        <\\/div>\\r\\n        \\r\\n        <div class='clsCB'><\\/div>\\r\\n    <\\/div>\\r\\n    \\r\\n    <div id=\\\"idDivBktSignInContainer\\\">\\r\\n         <div id='idBktDefaultSignInErrorContainer' class=\\\"clsBktDefaultErrorContainer\\\" style='display:none'>\\r\\n            <div id=\\\"idDivBktDefaultErrorSignInLoadingData\\\" class=\\\"clsBktDefaultErrorText\\\">\\r\\n                Se ha producido un error al cargar los datos            <\\/div>\\r\\n\\r\\n            <a href='#services'>\\r\\n                <div class='clsDivContinueButton clsDivBackErrorButton clsHPR'>\\r\\n                    Volver                <\\/div>\\r\\n            <\\/a>\\r\\n\\r\\n            <div class='clsCB'><\\/div>\\r\\n        <\\/div>\\r\\n        \\r\\n        <div id=\\\"idBktDefaultSignInTextBeforeFields\\\">\\r\\n                    <\\/div>        \\r\\n        \\r\\n                \\r\\n        \\r\\n        <form id=\\\"idFormSignInContainer\\\">\\r\\n            <div id=\\\"idBktDefaultSignInContainerFields\\\">\\r\\n                <div id=\\\"idBktDefaultSignInClientFields\\\">              \\r\\n                    <div class=\\\"clsDivBktDefaultSignInHalvedRow\\\">\\r\\n                        <div class=\\\"clsDivBktSignInFormInput\\\">\\r\\n                            <div class=\\\"clsDivBktSignInFormInputDropAndTextContainer\\\">\\r\\n                                <div class=\\\"clsDivBktSignInFormInputDropAndTextField clsDivBktSignInFormInputDropAndTextFieldSelect\\\">\\r\\n                                    <select id=\\\"idSelBktSignInLoginType\\\" onchange=\\\"this.blur()\\\"><\\/select>\\r\\n                                <\\/div>\\r\\n\\r\\n                                <div class=\\\"clsDivBktSignInFormInputDropAndTextField clsDivBktSignInFormInputDropAndTextFieldInput\\\">\\r\\n                                    <input id=\\\"idIptBktSignInlogin\\\" type=\\\"text\\\" placeholder=\\\"Email\\\" name=\\\"login\\\">\\r\\n                                <\\/div>\\r\\n                            <\\/div>\\r\\n                        <\\/div>\\r\\n\\r\\n                        <div class=\\\"clsDivBktSignInFormInput\\\">\\r\\n                            <input id=\\\"idIptBktSignInpassword\\\" type=\\\"password\\\" placeholder=\\\"* Contrase\\u00f1a\\\" name=\\\"password\\\">\\r\\n                        <\\/div>\\r\\n                    <\\/div>\\r\\n                    \\r\\n                    <div id='idDivBktSignInFieldErrorlogin' class=\\\"clsDivBktDefaultFieldError\\\"><\\/div>\\r\\n                <\\/div>\\r\\n\\r\\n                <div id=\\\"idBktDefaultSignInEventFields\\\"><\\/div>            \\r\\n                \\r\\n                <div id=\\\"idBktDefaultSignInVoucherFields\\\"><\\/div>            \\r\\n            <\\/div>\\r\\n            \\r\\n            <div id=\\\"idBktDefaultSignInTextBeforeComments\\\">\\r\\n                            <\\/div>\\r\\n            \\r\\n                        \\r\\n\\r\\n            <div id=\\\"idBktDefaultSignInTextAfterComments\\\">\\r\\n                            <\\/div>            \\r\\n            \\r\\n            <div id=\\\"idBktDefaultSignInSubFooterContainer\\\">\\r\\n                <div id=\\\"idBktDefaultSignInConfirmButtonContainer\\\">\\r\\n                                            <div id=\\\"idBktDefaultSignInConfirmButton\\\" class=\\\"clsDivContinueButton clsHPR\\\">Confirmar<\\/div>\\r\\n                        <div id=\\\"idBktDefaultSignedInConfirmButton\\\" class=\\\"clsDivContinueButton clsHPR\\\" style=\\\"display: none;\\\">Confirmar<\\/div>\\r\\n                                        \\r\\n                    \\r\\n                    <div class=\\\"clsCB\\\"><\\/div>\\r\\n                <\\/div>   \\r\\n                \\r\\n                <div id=\\\"idBktDefaultSignInRecoveryPasswordContainer\\\">\\r\\n                    <a href=\\\"#recoverpassword\\\">\\r\\n                        <div id=\\\"idDivBktDefaultSignInRecoveryPassword\\\">\\r\\n                            Recuperar contrase\\u00f1a                        <\\/div>\\r\\n                    <\\/a>\\r\\n                    \\r\\n                    <div class=\\\"clsCB\\\"><\\/div>\\r\\n                <\\/div>                \\r\\n                \\r\\n                <div class='clsCB'><\\/div>\\r\\n            <\\/div>\\r\\n        <\\/form>\\r\\n    <\\/div>\\r\\n<\\/div><div id=\\\"idBktDefaultConfirmClientContainer\\\" class=\\\"clsBktDefaultWindow\\\"  style=\\\"display:none;\\\">\\n    <div id=\\\"idBktDefaultConfirmClientBreadCrumb\\\" class=\\\"clsDivSubHeader\\\">\\n        <div id=\\\"idBktDefaultConfirmClientBackButton\\\">\\n            <div class=\\\"clsDivSubHeaderBackButton\\\"><\\/div>\\n        <\\/div>\\n\\n        <div class=\\\"clsDivSubHeaderBreadcrumbs\\\">\\n            <div class=\\\"clsDivSubHeaderBreadcrumbsText\\\"><\\/div>\\n        <\\/div>\\n\\n        <div class='clsCB'><\\/div>\\n    <\\/div>\\n        \\n    <div id=\\\"idDivBktConfirmClientContainer\\\">        \\n        <div id='idDivBktConfirmClientInfo'>\\n            <div id='idDivBktConfirmClientInfoSms'>\\n                Se ha enviado un SMS con un c\\u00f3digo para validar el tel\\u00e9fono indicado. Cuando el tel\\u00e9fono sea validado la cita quedar\\u00e1 confirmada.            <\\/div>\\n            \\n            <div id='idDivBktConfirmClientInfoEmail'>\\n                Se ha enviado un email con un c\\u00f3digo para validar la direcci\\u00f3n de email indicada. Cuando el email sea validado la cita quedar\\u00e1 confirmada.            <\\/div>\\n        <\\/div>\\n        \\n        <div id='idDivBktConfirmClientContent'>\\n            <div id='idDivBktConfirmClientCodeInput'>\\n                <input id=\\\"idIptBktValidateCode\\\" type=\\\"tel\\\" name=\\\"validatecode\\\" placeholder=\\\"C\\u00f3digo\\\" \\/>\\n            <\\/div>\\n    \\n            <div id='idDivBktConfirmClientValidateButton'>\\n                <div class='clsDivContinueButton'>\\n                    Continuar                <\\/div>\\n            <\\/div>\\n        <\\/div>\\n                        \\n        <div id='idDivBktValidateCodeError' style=\\\"display: none\\\">\\n            C\\u00f3digo err\\u00f3neo        <\\/div>\\n    <\\/div>\\n<\\/div><div id=\\\"idBktDefaultCCCStrContainer\\\" class=\\\"clsBktDefaultWindow\\\"  style=\\\"display:none;\\\">\\n    <div id=\\\"idBktDefaultCCCStrBreadCrumb\\\" class=\\\"clsDivSubHeader\\\">\\n        <div id=\\\"idBktDefaultCCCBackButton\\\">\\n            <div class=\\\"clsDivSubHeaderBackButton\\\"><\\/div>\\n        <\\/div>\\n\\n        <div class=\\\"clsDivSubHeaderBreadcrumbs\\\">\\n            <div class=\\\"clsDivSubHeaderBreadcrumbsText\\\"><\\/div>\\n        <\\/div>\\n\\n        <div class='clsCB'><\\/div>\\n    <\\/div>\\n        \\n    <div id=\\\"idDivBktCCCStrContainer\\\">        \\n        <div id='idDivBktCCCStrInfo'>\\n            <div id='idDivBktCCCStrInfoDetail'>                \\n                <div>\\n                    <div class='clsHPR'>\\n                        <div class='clsDivBktCCCStrInfoTable' id='idDivBktCCCStrInfoTableDetail'>\\n                            <div class='clsDivBktCCCStrInfoTableRow'>\\n                                <div class='clsDivBktCCCStrInfoTableCell'>Importe que adelantar\\u00e1s en la reserva online<\\/div>\\n                                <div class='clsDivBktCCCStrInfoTableCellEmpty'><\\/div>\\n                                <div id='idDivBktCCCStrAmountOnline' class='clsDivBktCCCStrInfoTableCell clsTextOrange clsTextRight'><\\/div>\\n                                <div class='clsDivBktCCCStrInfoTableCellEmpty'><\\/div>\\n                            <\\/div>\\n                            \\n                            <div class='clsDivBktCCCStrInfoTableRow'>\\n                                <div class='clsDivBktCCCStrInfoTableCell' style='line-height: 1.5em'>Importe que abonar\\u00e1s al llegar al centro<\\/div>\\n                                <div class='clsDivBktCCCStrInfoTableCellEmpty'><\\/div>\\n                                <div id='idDivBktCCCStrAmountOffline' class='clsDivBktCCCStrInfoTableCell clsTextOrange clsTextRight'><\\/div>\\n                                <div class='clsDivBktCCCStrInfoTableCellEmpty'><\\/div>\\n                            <\\/div>\\n                        <\\/div>\\n                    <\\/div>\\n                    \\n                    <div class='clsCB'><\\/div>\\n                <\\/div>\\n                \\n                <div id='idDivBktCCCStrInfoLine'><\\/div>\\n                \\n                <div>\\n                    <div class='clsHPR'>\\n                        <div class='clsDivBktCCCStrInfoTable' id='idDivBktCCCStrInfoTableTotal'>\\n                            <div class='clsDivBktCCCStrInfoTableRow'>\\n                                <div class='clsDivBktCCCStrInfoTableCell clsTextBold'>Importe total<\\/div>\\n                                <div class='clsDivBktCCCStrInfoTableCellEmpty'><\\/div>\\n                                <div id='idDivBktCCCStrAmountTotal' class='clsDivBktCCCStrInfoTableCell clsTextOrange clsTextBold clsTextRight'><\\/div>\\n                                <div class='clsDivBktCCCStrInfoTableCellEmpty'><\\/div>\\n                            <\\/div>\\n                        <\\/div>\\n                    <\\/div>\\n                    \\n                    <div class='clsCB'><\\/div>\\n                <\\/div>\\n            <\\/div>\\n        <\\/div>\\n        \\n        <div id='idDivBktBanksErrorContainer' style=\\\"display: none\\\">\\n            <div id='idDivBktBanksErrorContent'>\\n                La pasarela de pago no se encuentra habilitada            <\\/div>\\n        <\\/div>\\n        \\n        <div id=\\\"idDivBktPaymentsGatewaysContainer\\\" style=\\\"display: none\\\">\\n            <div id=\\\"idDivBktPaymentsGatewaysStripe\\\" style=\\\"display: none\\\">\\n                <div class=\\\"clsDivBktPaymentText\\\">\\n                    Pagar con tarjeta                <\\/div>\\n                \\n                <div class=\\\"clsDivBktPaymentIconCard\\\">\\n                    \\n                <\\/div>\\n            <\\/div>\\n            \\n            <div id=\\\"idDivBktPaymentsGatewaysRedsys\\\" style=\\\"display: none\\\">\\n                <div class=\\\"clsDivBktPaymentText\\\">\\n                    Pagar con tarjeta                <\\/div>\\n                \\n                <div class=\\\"clsDivBktPaymentIconCard\\\">\\n                    \\n                <\\/div>\\n            <\\/div>            \\n            \\n            <div id=\\\"idDivBktPaymentsGatewaysPaypal\\\" style=\\\"display: none\\\">\\n                <div class=\\\"clsDivBktPaymentText\\\">\\n                    Pagar con                <\\/div>\\n                \\n                <div class=\\\"clsDivBktPaymentIconPaypal\\\">\\n                    \\n                <\\/div>\\n            <\\/div>\\n\\n            <div id=\\\"idDivBktPaymentsGatewaysNiubiz\\\" style=\\\"display: none\\\">\\n                <div class=\\\"clsDivBktPaymentText\\\">\\n                    Pagar con tarjeta                <\\/div>\\n\\n                <div class=\\\"clsDivBktPaymentIconCard\\\">\\n\\n                <\\/div>\\n            <\\/div>\\n        <\\/div>\\n        \\n        <div id=\\\"idDivBktPaymentsGatewaysBackContainer\\\" style=\\\"display: none\\\">\\n            Cambiar m\\u00e9todo de pago        <\\/div>\\n        \\n        <div id=\\\"idDivBktPaymentGatewayStripeContainer\\\" style=\\\"display: none\\\">\\n            \\n<div id=\\\"idBktDefaultCCCStrKey\\\" style=\\\"display:none;\\\"><\\/div>    \\n       \\n<div id='idDivBktCCCStr'>\\n    <div id='idDivBktCCCStrTitle' class='clsTextBold'>Datos de la tarjeta de cr\\u00e9dito<\\/div>            \\n\\n    <form id=\\\"idFrmBktCCCStr\\\" action=\\\"#\\\" method=\\\"POST\\\" name=\\\"payment_form\\\" autocomplete=\\\"off\\\">\\n        <div id='idDivBktCCCStrBody'>  \\n            <div class=\\\"clsDivBktRow\\\">\\n                <div class=\\\"clsDivBktRowData\\\" style=\\\"padding-right: 20px;\\\">\\n                    <input id=\\\"idInpHolderName\\\" class=\\\"card-holdername\\\" autocomplete=\\\"off\\\" data-stripe=\\\"name\\\" name=\\\"cardholderName\\\" type=\\\"text\\\" value=\\\"\\\" placeholder='Titular de la tarjeta' \\/>\\n                <\\/div>\\n                \\n                <div class=\\\"clsDivBktRowData\\\" style=\\\"padding-left: 10px; background-color: #FFF;\\\">\\n                    <div id=\\\"idStripeCreditCardContainer\\\"><\\/div>\\n                <\\/div>\\n            <\\/div>\\n            \\n            <div class=\\\"clsDivBktRow\\\">\\n                <div class=\\\"clsDivBktRowData\\\" style=\\\"padding-right: 20px; text-align: right; padding-top: 20px;\\\">\\n                    *Fecha de caducidad                <\\/div>\\n                \\n                <div class=\\\"clsDivBktRowData\\\" style=\\\"padding-top: 20px;\\\">\\n                    <div class=\\\"clsDivBktTable\\\">\\n                        <div class=\\\"clsDivBktRowData\\\" style=\\\"padding-left: 10px; background-color: #FFF;\\\">\\n                            <div id=\\\"idStripeExpiryContainer\\\"><\\/div>\\n                        <\\/div>\\n                        \\n                        <div class=\\\"clsDivBktRowData\\\" style=\\\"padding-left: 10px; width: 0px;\\\"><\\/div>\\n                        \\n                        <div class=\\\"clsDivBktRowData\\\" style=\\\"padding-left: 10px; background-color: #FFF;\\\">\\n                            <div id=\\\"idStripeCvcContainer\\\"><\\/div>\\n                        <\\/div>\\n                    <\\/div>\\n                <\\/div>\\n            <\\/div>\\n            \\n            <div class=\\\"clsDivBktRow\\\">\\n                <div class=\\\"clsDivBktRowData\\\"><\\/div>\\n                \\n                <div class=\\\"clsDivBktRowData\\\">\\n                    <div class='clsTextOrange' id='idDivBktCCCStrWhatsThis'>\\u00bfQu\\u00e9 es esto?<\\/div>\\n                <\\/div>\\n            <\\/div>\\n        <\\/div>\\n        \\n        <div id=\\\"idDivBktStripeError\\\" class='clsTextOrange'><\\/div>\\n        \\n<!--        <div id='idDivBktCCCStrBody'>                \\n            <div class='clsDivBktCCCStrInfoTable' id='idDivBktCCCStrCapture'>\\n                <div class='clsDivBktCCCStrInfoTableRow'>\\n                    <div class='clsDivBktCCCStrInfoTableCell' style='width:48%'>\\n                        <input id=\\\"idInpHolderName\\\" class=\\\"card-holdername\\\" autocomplete=\\\"off\\\" data-stripe=\\\"name\\\" name=\\\"cardholderName\\\" type=\\\"text\\\" value=\\\"\\\" placeholder='Titular de la tarjeta' \\/>\\n                    <\\/div>\\n\\n                    <div class='clsDivBktCCCStrInfoTableCellEmpty clsTextCenter' style='width:10px'><\\/div>\\n\\n                    <div id=\\\"idStripeCreditCardContainer\\\" class='clsDivBktCCCStrInfoTableCell' style='width:48%'>\\n                        <input id=\\\"idInpCreditCard\\\" class=\\\"card-number\\\" autocomplete=\\\"off\\\" data-stripe=\\\"number\\\" type=\\\"text\\\" placeholder=Numero de tarjeta \\/>\\n                    <\\/div>\\n                <\\/div>\\n            <\\/div>\\n\\n            <div style='height: 10px'><\\/div>\\n\\n            <div class='clsDivBktCCCStrInfoTable' style='width:100%'>\\n                <div class='clsDivBktCCCStrInfoTableRow'>\\n                    <div class='clsDivBktCCCStrInfoTableCell' style='width:28%; text-align: right;'>                            \\n                        *Fecha de caducidad                    <\\/div>\\n\\n                    <div class='clsDivBktCCCStrInfoTableCellEmpty' style='width: 10px'><\\/div>\\n\\n                    <div id=\\\"idStripeExpiryContainer\\\" class='clsDivBktCCCStrInfoTableCell' style='width:18%'>    \\n                        <input id=\\\"idInpExpiryMonth\\\" class=\\\"card-expiry-month\\\" autocomplete=\\\"off\\\" name=\\\"expiration_month\\\" data-stripe=\\\"exp-month\\\" type=\\\"text\\\" value=\\\"\\\" placeholder='mes' \\/>\\n                    <\\/div>\\n\\n                    <div class='clsDivBktCCCStrInfoTableCellEmpty' style='width: 17px; text-align: center;'>\\/<\\/div>\\n\\n                    <div class='clsDivBktCCCStrInfoTableCell' style='width:24%'>\\n                        <input id=\\\"idInpExpiryYear\\\" class=\\\"card-expiry-year\\\" autocomplete=\\\"off\\\" name=\\\"expiration_year\\\" data-stripe=\\\"exp-year\\\" type=\\\"text\\\" value=\\\"\\\" placeholder='a\\u00f1o'\\/>\\n                    <\\/div>\\n\\n                    <div class='clsDivBktCCCStrInfoTableCellEmpty' style='width: 10px;'><\\/div>\\n\\n                    <div id=\\\"idStripeCvcContainer\\\" class='clsDivBktCCCStrInfoTableCell' style='width:22%'>\\n                        <input id=\\\"idInpCvc\\\" class=\\\"card-cvc \\\" autocomplete=\\\"off\\\" data-stripe=\\\"cvc\\\" type=\\\"text\\\" placeholder='CVC'\\/>\\n                    <\\/div>\\n                <\\/div>                     \\n            <\\/div>\\n\\n            <div class='clsHPR clsTextOrange' id='idDivBktCCCStrWhatsThis'>\\u00bfQu\\u00e9 es esto?<\\/div>\\n\\n            <div class='clsCB'><\\/div>\\n        <\\/div>    -->\\n    <\\/form>\\n\\n<!--    <form action=\\\"#\\\" method=\\\"post\\\" id=\\\"payment-form\\\">\\n        <div class=\\\"form-row\\\">\\n            <div id=\\\"card-element\\\">\\n            \\n            <\\/div>\\n\\n            <div id=\\\"card-errors\\\" role=\\\"alert\\\"><\\/div>\\n        <\\/div>\\n\\n        <input type=\\\"submit\\\" class=\\\"submit\\\" value=\\\"Submit Payment\\\">\\n    <\\/form>-->\\n\\n    <div id=\\\"idBktDefaultCCCStrSubmitContainer\\\">\\n        <div id=\\\"idBktDefaultCCCStrSubmitButton\\\" class=\\\"clsDivContinueButton clsHPR\\\">Pagar<\\/div>\\n        \\n        <div class=\\\"clsCB\\\"><\\/div>\\n    <\\/div>\\n\\n    <div class=\\\"clsCB\\\"><\\/div>\\n\\n    \\n    <div id=\\\"idDivBktCCCStrServiceProvided\\\" class='clsHPR'>\\n        <span>Servicio de pagos provisto por <a href=\\\"https:\\/\\/stripe.com\\/es\\/terms\\\" target=\\\"_blank\\\">Stripe<\\/a> y <a href=\\\"https:\\/\\/www.bookitit.com\\/politica-de-privacidad\\/#0.13_payments\\\" target=\\\"_blank\\\">Bookitit<\\/a><\\/span>.\\n    <\\/div>\\n\\n    <div class=\\\"clsCB\\\"><\\/div>\\n\\n    <div id=\\\"idDivBktCCCStrCardInfo\\\" style=\\\"display:none;\\\">\\n        <div id=\\\"idDivBktCCCStrCardClose\\\" class=\\\"clsHPR\\\">\\n            <img src='https:\\/\\/www.citaconsular.es\\/images\\/widgets\\/default\\/creditcard\\/close.png' alt='c' title='Cerrar' width='10'     \\/>        <\\/div>\\n\\n        <div class=\\\"clsCB\\\"><\\/div>\\n\\n        <div id=\\\"idDivBktCCCStrCardInfoContent\\\">                \\n            <div id=\\\"idDivBktCCCStrCardInfoCard\\\" class=\\\"clsHP\\\">\\n                <img src='https:\\/\\/www.citaconsular.es\\/images\\/widgets\\/default\\/creditcard\\/card.png' alt='Card' title='Card' width='75'     \\/>            <\\/div>\\n\\n            <div id=\\\"idDivBktCCCStrCardInfoText\\\" class=\\\"clsHP\\\">\\n                En MasterCard, Visa o Discover son los tres \\u00faltimos d\\u00edgitos que aparecen en el \\u00e1rea de firma del reverso de la tarjeta.                            \\n            <\\/div>                \\n\\n            <div class=\\\"clsCB\\\"><\\/div>\\n        <\\/div>\\n    <\\/div>\\n\\n    <div id=\\\"idDivBktCCCStrError\\\" style=\\\"display:none;\\\">\\n        <div id=\\\"idDivBktCCCStrErrorClose\\\" class=\\\"clsHPR\\\">\\n            <img src='https:\\/\\/www.citaconsular.es\\/images\\/widgets\\/default\\/creditcard\\/close.png' alt='c' title='Cerrar' width='10'     \\/>        <\\/div>\\n\\n        <div class=\\\"clsCB\\\"><\\/div>\\n\\n        <div id=\\\"idDivBktCCCStrErrorContent\\\">                                    \\n            <div id=\\\"idDivBktCCCStrErrorText\\\">\\n                Hay errores en los datos de la tarjeta, por favor vuelva a insertarlos o pruebe con otra tarjeta                           \\n            <\\/div>                                    \\n        <\\/div>\\n    <\\/div>\\n<\\/div>            \\n        <\\/div>    \\n        \\n        <div id=\\\"idDivBktPaymentGatewayPaypalContainer\\\" style=\\\"display: none\\\">\\n            \\n<script type=\\\"text\\/javascript\\\">\\n    var sPaypalGatewayEnv = 'production';\\n<\\/script>\\n\\n<div id=\\\"idDivBktPaypalButtonContainer\\\"><\\/div>\\n\\n<div id=\\\"idDivBktPaypalErrorContainer\\\" style=\\\"display: none\\\">\\n    <div id=\\\"idDivBktPaypalErrorContent\\\">\\n        Se ha producido un error en el proceso de pago                           \\n    <\\/div>                                    \\n<\\/div>               \\n        <\\/div>\\n        \\n        <div id=\\\"idDivBktPaymentGatewayRedsysContainer\\\" style=\\\"display: none\\\">\\n            <div id=\\\"idDivBktRedsysErrorContainer\\\" style=\\\"display: none\\\">\\n    <div id=\\\"idDivBktRedsysErrorContent\\\">\\n        Se ha producido un error en el proceso de pago                           \\n    <\\/div>                                    \\n<\\/div>\\n\\n<form id=\\\"idFormBktRedsys\\\" name=\\\"payment\\\" method=\\\"POST\\\" action=\\\"https:\\/\\/sis.redsys.es\\/sis\\/realizarPago\\\" style=\\\"display: none\\\">\\n    <input type=\\\"text\\\" name=\\\"Ds_SignatureVersion\\\" value=\\\"HMAC_SHA256_V1\\\"\\/>\\n    <input type=\\\"text\\\" id=\\\"idDsMerchantParameters\\\" name=\\\"Ds_MerchantParameters\\\" value=\\\"\\\"\\/>\\n    <input type=\\\"text\\\" id=\\\"idDsSignature\\\" name=\\\"Ds_Signature\\\" value=\\\"\\\"\\/>\\n<\\/form>               \\n        <\\/div>\\n\\n        <div id=\\\"idDivBktPaymentGatewayNiubizContainer\\\" style=\\\"display: none\\\">\\n            <link type='text\\/css'href='https:\\/\\/pocpaymentserve.s3.amazonaws.com\\/payform.min.css' rel='stylesheet'  \\/>\\n<br>\\n\\n\\n<script type=\\\"text\\/javascript\\\">\\n    var niubizBaseAuthURL = \\\"https:\\/\\/apiprod.vnforapps.com\\/api.authorization\\/v3\\/authorization\\/ecommerce\\/\\\";\\n    var niubizBaseCardTokenURL = \\\"https:\\/\\/apiprod.vnforapps.com\\/api.ecommerce\\/v2\\/ecommerce\\/token\\/card\\/\\\";\\n<\\/script>\\n<div id=\\\"idDivBktNiubizCCCContainer\\\">\\n    <div id='idDivBktNiubizCCCTitle' class='clsTextBold'>Datos de la tarjeta de cr\\u00e9dito<\\/div>\\n    <div id='idDivBktNiubizCCCBody'>\\n        <div class=\\\"clsDivBktRow\\\">\\n            <div class=\\\"clsDivBktRowData\\\" style=\\\"padding-right: 20px;\\\">\\n                <input id=\\\"idInpHolderName\\\" class=\\\"card-holdername\\\" autocomplete=\\\"off\\\" name=\\\"cardholderName\\\" type=\\\"text\\\" value=\\\"\\\" placeholder='Titular de la tarjeta' \\/>\\n            <\\/div>\\n\\n            <div class=\\\"clsDivBktRowData\\\" style=\\\"padding-left: 10px; background-color: #FFF;\\\">\\n                <div id='idBktNiubizCardNumber' class='form-control'><\\/div>\\n            <\\/div>\\n        <\\/div>\\n        <div class=\\\"clsDivBktRow\\\">\\n            <div class=\\\"clsDivBktRowData\\\" style=\\\"padding-right: 20px; text-align: right; padding-top: 20px;\\\">\\n                *Fecha de caducidad            <\\/div>\\n\\n            <div class=\\\"clsDivBktRowData\\\" style=\\\"padding-top: 20px;\\\">\\n                <div class=\\\"clsDivBktTable\\\">\\n                    <div class=\\\"clsDivBktRowData\\\" style=\\\"padding-left: 10px; background-color: #FFF;\\\">\\n                        <div id='idBktNiubizExpirationDate' class='form-control'><\\/div>\\n                    <\\/div>\\n\\n                    <div class=\\\"clsDivBktRowData\\\" style=\\\"padding-left: 10px; width: 0px;\\\"><\\/div>\\n\\n                    <div class=\\\"clsDivBktRowData\\\" style=\\\"padding-left: 10px; background-color: #FFF;\\\">\\n                        <div id='idBktNiubizCvv' class='form-control'><\\/div>\\n                    <\\/div>\\n                <\\/div>\\n            <\\/div>\\n        <\\/div>\\n    <\\/div>\\n    <div id=\\\"idBktNiubizSubmitContainer\\\">\\n            <div id=\\\"idNiubizPayButton\\\" class=\\\"clsDivContinueButton clsHPR\\\">Pagar<\\/div>\\n            <div class=\\\"clsCB\\\"><\\/div>\\n    <\\/div>\\n\\n    <div class=\\\"clsCB\\\"><\\/div>\\n<\\/div>\\n\\n<div id=\\\"idDivBktNiubizErrorContainer\\\" style=\\\"display:none;padding-top: 15px;\\\">\\n    <div id=\\\"idDivBktNiubizErrorContent\\\">\\n        Hay errores en los datos de la tarjeta, por favor vuelva a insertarlos o pruebe con otra tarjeta    <\\/div>\\n<\\/div>\\n\\n<!--<script src='--><!--'><\\/script>-->\\n        <\\/div>\\n    <\\/div>\\n<\\/div><script type='text\\/template' id='idTemSummaryHeader'>\\n    <div id=\\\"idDivBktSummaryHeader\\\">\\n        Su reserva se ha realizado con \\u00e9xito    \\n        <% \\n        if(parseInt(iState) === 2){ %>\\n            <br>\\n            Y est\\u00e1 pendiente de confirmaci\\u00f3n        <% \\n        } %>\\n\\n        <%\\n        if(typeof sEmail !== 'undefined' && sEmail.length > 0){ %>\\n            <div style=\\\"text-align: center; margin-top: 15px;\\\">\\n                <div style=\\\"text-align: center; color: #e7522d; text-transform: initial;\\\">Recibir\\u00e1 un email con los detalles de su reserva<\\/div>\\n                <div style=\\\"text-align: center; color: #e7522d; text-transform: uppercase; font-weight: bold; margin-top: 5px;\\\">Revise la carpeta de spam o correo no deseado<\\/div>\\n            <\\/div>\\n        <%\\n        } %>\\n    <\\/div>\\n<\\/script>\\n\\n<script type='text\\/template' id='idTemSummaryInfo'>\\n    <% \\n    if(sInfo.length > 0){ %>\\n        <span class=\\\"clsTextOrange\\\">Informaci\\u00f3n<\\/span><br>\\n        <%= sInfo %>\\n    <% \\n    } %>\\n<\\/script>\\n\\n<script type='text\\/template' id='idTemSummaryAccess'>\\n    <%\\n    if(typeof sLogin !== 'undefined' && sLogin.length > 0){ %>\\n        <div id=\\\"idDivBktSummaryBodyTopLeft\\\">\\n            <span id=\\\"idSpanBktBodyTopLeftLabel\\\" class=\\\"clsTextOrange\\\">Login<\\/span>\\n            <span id=\\\"idSpanBktBodyTopLeftLabelText\\\"><%= sLogin %><\\/span>\\n        <\\/div>\\n    <%\\n    } %>\\n\\n    <% \\n    if(sPassword.length > 0){ %>\\n        <div id=\\\"idDivBktSummaryBodyRight\\\">\\n            <span id=\\\"idSpanBktBodyTopRightLabel\\\" class=\\\"clsTextOrange\\\">Contrase\\u00f1a<\\/span> \\n            <span id=\\\"idSpanBktBodyTopRightLabelText\\\"><%= sPassword %><\\/span>\\n        <\\/div>\\n    <% \\n    } %>\\n    \\n    <div class='clsCB'><\\/div>\\n<\\/script>\\n\\n<script type='text\\/template' id='idTemSummaryClient'>\\n    <% \\n    if((sName.length > 0) || (typeof sDocument !== 'undefined' && sDocument.length > 0)){ %>    \\n        <div class=\\\"clsDivBktSummaryAppointmentsContent\\\">\\n            <% \\n            if(sName.length > 0){ %>\\n                <div id=\\\"idTemSummaryClientName\\\" class=\\\"clsDivBktSummaryAppointmentRow\\\">\\n                    <span class=\\\"clsTextOrange\\\">Nombre<\\/span> <%= sName %>\\n                <\\/div>\\n            <% \\n            } %>\\n\\n            <% \\n            if(typeof sDocument !== 'undefined' && sDocument.length > 0){ %>\\n                <div id=\\\"idTemSummaryClientDocument\\\">\\n                    <span class=\\\"clsTextOrange\\\">Documento<\\/span> <%= sDocument %>\\n                <\\/div>\\n            <% \\n            } %>\\n        <\\/div>            \\n    <% \\n    } %>        \\n<\\/script>\\n\\n<script type='text\\/template' id='idTemSummaryAppointment'>\\n    <div class=\\\"clsDivBktSummaryAppointmentsContent <%= sFirstClass %>\\\">\\n        <div class=\\\"clsDivBktSummaryAppointmentRow\\\"><span class=\\\"clsTextOrange\\\">Fecha<\\/span> <%= sDate %><\\/div>\\n        <div id=\\\"idTemSummaryAgendaName\\\" class=\\\"clsDivBktSummaryAppointmentRow\\\"><span class=\\\"clsTextOrange\\\">Agenda<\\/span> <%= sAgenda %><\\/div>\\n        \\n        <div class=\\\"clsDivBktSummaryAppointmentRow\\\">\\n            <span class=\\\"clsTextOrange\\\">Servicio<\\/span> <%= sService %>\\n        <\\/div>\\n        \\n        <% \\n        if(sPeople > 1){ %>\\n            <div class=\\\"clsDivBktSummaryAppointmentRow clsDivBktSummaryAppointmentRowPeople\\\"><span class=\\\"clsTextOrange\\\">Personas<\\/span> <%= sPeople %><\\/div>\\n        <% \\n        } %>\\n        \\n        <% \\n        if(sLocator.length > 0){ %>\\n            <div class=\\\"clsDivBktSummaryAppointmentRow\\\"><span class=\\\"clsTextOrange\\\">Localizador<\\/span> <%= sLocator %><\\/div>\\n        <% \\n        } %>\\n        \\n        <% \\n        if(typeof sCustomList !== 'undefined' && sCustomList.length > 0){ \\n            _.each(sCustomList, function(custom){ %>\\n                <div class=\\\"clsDivBktSummaryAppointmentRow\\\">\\n                    <span class=\\\"clsTextOrange\\\"><%= custom.label %><\\/span> <%= custom.value %>\\n                <\\/div>                \\n            <%\\n            });\\n        } %>        \\n    <\\/div>\\n<\\/script>\\n\\n<script type='text\\/template' id='idTemSummaryMultiselectAppointment'>\\n    <div class=\\\"clsDivBktSummaryAppointmentsContent\\\">\\n        <div class=\\\"clsDivBktSummaryAppointmentRow\\\">\\n            <div class=\\\"clsDivBktSummaryAppointmentRowInlineBlockData clsDivBktSummaryAppointmentRowMarginRightData\\\">\\n                <span class=\\\"clsTextOrange\\\">Fecha<\\/span> <%= sDate %>\\n            <\\/div>\\n\\n            <div class=\\\"clsDivBktSummaryAppointmentRowInlineBlockData clsDivBktSummaryAppointmentRowMarginRightData\\\">\\n                <span class=\\\"clsTextOrange\\\">Hora<\\/span> <%= sTime %>\\n            <\\/div>\\n\\n            <% \\n            if(sLocator.length > 0){ %>\\n                <div class=\\\"clsDivBktSummaryAppointmentRowInlineBlockData clsDivBktSummaryAppointmentRowMarginRightData\\\">\\n                    <span class=\\\"clsTextOrange\\\">Localizador<\\/span> <%= sLocator %>\\n                <\\/div>\\n            <% \\n            } %>\\n                \\n            <% \\n            if(sPeople > 1){ %>\\n                <div class=\\\"clsDivBktSummaryAppointmentRowInlineBlockData\\\">\\n                    <span class=\\\"clsTextOrange\\\">Personas<\\/span> <%= sPeople %>\\n                <\\/div>\\n            <% \\n            } %>\\n        <\\/div>\\n\\n        <div>\\n            <span id=\\\"idTemSummaryAgendaName\\\" class=\\\"clsTextOrange\\\">Agenda<\\/span> <%= sAgenda %>\\n        <\\/div>\\n    <\\/div>\\n    \\n    <div id=\\\"idDivBktSummaryMultiselectAppointmentContainer\\\" class=\\\"clsDivBktSummaryAppointmentsContent\\\">\\n        <% \\n        var bFirstRow = true;\\n            \\n        _.each(serviceList, function(service){ %>\\n            <div <%= (bFirstRow === false) ? 'class=\\\"clsDivBktSummaryAppointmentNextRow\\\"' : '' %>>\\n                <span class=\\\"clsTextOrange\\\"><%= service.title %><\\/span>\\n                    \\n                <% \\n                if(service.duration !== null){ %>\\n                    &nbsp;\\u00b7 <%= service.duration %>\\n                <% \\n                } %>\\n            <\\/div>\\n            \\n            <% \\n            if(typeof service.extraList !== 'undefined' && service.extraList.length > 0){ %>\\n                <div class=\\\"clsDivBktSummaryAppointmentRowMarginLeftData\\\">\\n                    <% \\n                    _.each(service.extraList, function(extra){ %>\\n                        <div class=\\\"clsDivBktSummaryAppointmentNextRow\\\">\\n                            <%= extra.title %>\\n                                \\n                            <% \\n                            if(extra.duration !== null){ %>\\n                                &nbsp; \\u00b7 <%= extra.duration %>\\n                            <% \\n                            } %>                                \\n                        <\\/div>                                \\n                    <% \\n                    }); %>\\n                <\\/div>\\n            <% \\n            } \\n            \\n            bFirstRow = false; %>\\n        <% \\n        }); %>\\n    <\\/div>\\n<\\/script>\\n\\n<div id=\\\"idBktDefaultSummaryContainer\\\" class=\\\"clsBktDefaultWindow\\\" style=\\\"display:none;\\\">\\n    <div id=\\\"idDivBktSummaryContainer\\\">\\n        <div id='idDivBktDefaultSummaryErrorContainer' class=\\\"clsBktDefaultErrorContainer\\\" style='display:none'>\\n            <div id=\\\"idDivBktDefaultErrorSummaryLoadingData\\\" class=\\\"clsBktDefaultErrorText\\\">\\n                Se ha producido un error al cargar los datos            <\\/div>\\n\\n            <a href='#services'>\\n                <div class='clsDivContinueButton clsDivBackErrorButton clsHPR'>\\n                    Volver                <\\/div>\\n            <\\/a>\\n\\n            <div class='clsCB'><\\/div>\\n        <\\/div>\\n        \\n        <div id=\\\"idDivBktSummaryContent\\\">\\n            <div id=\\\"idDivBktSummaryHeaderContainer\\\"><\\/div>\\n        \\n            <div id=\\\"idDivBktSummaryBodyContainer\\\">\\n                <div id=\\\"idDivBktSummaryAppointmentsInfoTop\\\" style=\\\"display: none;\\\"><\\/div>\\n\\n                <div id=\\\"idDivBktSummaryBodyTop\\\"><\\/div>\\n\\n                <div id=\\\"idDivBktSummaryBodyContent\\\">\\n                    <div id=\\\"idDivBktSummaryAppointmentsContainer\\\">\\n                        <div id=\\\"idDivBktSummaryAppointmentsInfoMiddle\\\" style=\\\"display: none;\\\"><\\/div>\\n\\n                        <div id=\\\"idDivBktSummaryAppointmentsContent\\\"><\\/div>\\n\\n                        <div id=\\\"idDivBktSummaryAppointmentsInfoBottom\\\" style=\\\"display: none;\\\"><\\/div>\\n                    <\\/div>\\n\\n                    <div id=\\\"idDivBktSummaryPrinterContainer\\\">\\n                                                    <div id=\\\"idDivBktSummaryPrinter\\\"><\\/div>\\n                                            <\\/div>\\n                    <div class='clsCB'><\\/div>                    \\n                <\\/div>\\n                <div id=\\\"idDivBktSummaryPayment\\\" style=\\\"display:none;\\\">\\n                    <div id=\\\"idDivBktSummaryPaymentContent\\\" class=\\\"clsHPR\\\">\\n                        <div id=\\\"idDivBktSummaryPaymentContentTotal\\\" class=\\\"clsBktSummaryPaymentContentRow\\\">\\n                            <div id=\\\"idDivBktSummaryPaymentContentTotalLabel\\\" class=\\\"clsBktSummaryPaymentContentCell clsTextRight\\\">Importe Total<\\/div>\\n                            <div class=\\\"clsBktSummaryPaymentContentCellEmpty clsBktSummaryPaymentContentCell\\\"><\\/div>\\n                            <div id=\\\"idDivBktSummaryPaymentContentTotalAmount\\\" class=\\\"clsTextOrange clsBktSummaryPaymentContentCell\\\"><\\/div>                            \\n                        <\\/div>\\n                        <div id=\\\"idDivBktSummaryPaymentContentPaid\\\" class=\\\"clsBktSummaryPaymentContentRow\\\">\\n                            <div id=\\\"idDivBktSummaryPaymentContentPaidLabel\\\" class=\\\"clsBktSummaryPaymentContentCell clsTextRight\\\">Pagado<\\/div>\\n                            <div class=\\\"clsBktSummaryPaymentContentCellEmpty clsBktSummaryPaymentContentCell\\\"><\\/div>\\n                            <div id=\\\"idDivBktSummaryPaymentContentPaidAmount\\\" class=\\\"clsTextOrange clsBktSummaryPaymentContentCell\\\"><\\/div>                            \\n                        <\\/div>\\n                        <div id=\\\"idDivBktSummaryPaymentContentPending\\\" class=\\\"clsBktSummaryPaymentContentRow\\\">\\n                            <div id=\\\"idDivBktSummaryPaymentContentPendingLabel\\\" class=\\\"clsTextBold clsBktSummaryPaymentContentCell clsTextRight\\\">Pendiente<\\/div>\\n                            <div class=\\\"clsBktSummaryPaymentContentCellEmpty clsBktSummaryPaymentContentCell\\\"><\\/div>\\n                            <div id=\\\"idDivBktSummaryPaymentContentPendingAmount\\\" class=\\\"clsTextOrange clsBktSummaryPaymentContentCell\\\"><\\/div>                                                        \\n                        <\\/div>\\n                    <\\/div>\\n                    <div class='clsCB'><\\/div>\\n                <\\/div>\\n                \\n                <div id=\\\"idBktSummaryFooterLeft\\\">\\n                    Recibir\\u00e1 los detalles de su cuenta y su contrase\\u00f1a en la direcci\\u00f3n Email.<br>\\n                    Si no recibe el correo electr\\u00f3nico <span class='clsTextOrange'>revise<\\/span> la <span class='clsTextOrange'>carpeta spam<\\/span> o <span class='clsTextOrange'>correo no deseado<\\/span>.\\n                <\\/div>\\n            <\\/div>\\n\\n            <div id=\\\"idBktSummaryFooter\\\">\\n                <div id=\\\"idDivBktSummaryBodyCancel\\\">\\n                    Si desea <span id='idSpanBktSummaryCancelAppointment' class='clsTextOrange'>cancelar la cita<\\/span>, deber\\u00e1 hacerlo al menos 3 d\\u00edas antes del d\\u00eda de visita                    .\\n                <\\/div>\\n                \\n                <div id=\\\"idBktSummaryFooterRight\\\">                    \\n                    <div id=\\\"idDivBktSummaryBackButton\\\" class='clsDivContinueButton'>\\n                        Volver al inicio\\r\\n<script type='text\\/javascript'>\\r\\n$(document).ready(function() {\\r\\n    $('#idDivBktSummaryBackButton').attr('href', 'https:\\/\\/www.exteriores.gob.es\\/es\\/Paginas\\/index.aspx');\\r\\n  \\r\\n    $('#idDivBktSummaryBackButton').on('click', function(event) {\\r\\n        event.preventDefault(); \\/\\/ previene la acci\\u00f3n predeterminada del enlace\\r\\n        window.location.href = $(this).attr('href'); \\/\\/ redirige a la URL especificada en el atributo href\\r\\n    });\\r\\n});\\r\\n<\\/script>\\r\\n                    <\\/div>                    \\n                <\\/div>\\n            <\\/div>\\n        <\\/div>\\n    <\\/div>\\n<\\/div><div id=\\\"idBktDefaultLegalNoticeContainer\\\" class=\\\"clsBktDefaultWindow\\\" style=\\\"display:none;\\\">\\n    <div id=\\\"idBktDefaultLegalNoticeContent\\\">\\n        <div id=\\\"idBktDefaultLegalNoticeHeader\\\">\\n            <div id=\\\"idBktDefaultLegalNoticeHeaderCloseContainer\\\">\\n                <div id=\\\"idBktDefaultLegalNoticeHeaderClose\\\"><\\/div>\\n\\n                <div class='clsCB'><\\/div>\\n            <\\/div>\\n\\n            <div id=\\\"idBktDefaultLegalNoticeHeaderTitle\\\">\\n                pol\\u00edtica de privacidad            <\\/div>\\n        <\\/div>\\n\\n        <div id=\\\"idBktDefaultLegalNoticeBody\\\">\\n            <p>De conformidad con lo dispuesto en la normativa vigente sobre protecci\\u00f3n de datos personales y en el Reglamento (UE) 2016\\/679 de 27 de abril de 2016 (GDPR), los datos personales que introduzca en este formulario, ser\\u00e1n incluidos en un fichero automatizado de datos de car\\u00e1cter personal creado y mantenido bajo la responsabilidad de Embajada de Espa\\u00f1a en Kinshasa - VISADOS, con la finalidad de gestionar la cita concertada, as\\u00ed como realizar el mantenimiento y la gesti\\u00f3n de la relaci\\u00f3n contractual establecida con el Cliente. Ser\\u00e1n tratados bajo la responsabilidad de Embajada de Espa\\u00f1a en Kinshasa - VISADOS. La plataforma Bookitit (Nubesis S.L.) mediante la cual se realiza la cita ser\\u00e1 la encargada del tratamiento de los datos introducidos y solo los utilizar\\u00e1 con la finalidad de gesti\\u00f3n de la cita por parte de Embajada de Espa\\u00f1a en Kinshasa - VISADOS. Bookitit no contestar\\u00e1 consultas dirigidas a esta que tengan relaci\\u00f3n con la cita y los servicios proporcionados y deber\\u00e1 dirigir todas sus consultas a Embajada de Espa\\u00f1a en Kinshasa - VISADOS.<\\/p><p>&nbsp;<\\/p><p><span style='font-weight: bold;'>Finalidad:<\\/span> env\\u00edo de comunicaciones transaccionales relacionadas con la gesti\\u00f3n de las citas, as\\u00ed como sobre productos y servicios de Embajada de Espa\\u00f1a en Kinshasa - VISADOS. El Cliente consiente expresamente que sus datos aqu\\u00ed recabados puedan ser utilizados para el env\\u00edo, incluso por medios electr\\u00f3nicos, de informaci\\u00f3n comercial de Embajada de Espa\\u00f1a en Kinshasa - VISADOS. Realizar estudios de mercado o estad\\u00edsticos para uso interno y totalmente an\\u00f3nimo, segmentando por localizaci\\u00f3n geogr\\u00e1fica. Todos los datos solicitados a trav\\u00e9s del sitio web y marcados con (*) son obligatorios ya que son necesarios para la prestaci\\u00f3n de un servicio \\u00f3ptimo al Cliente. El resto de campos, aunque introducirlos resulte facultativo, pueden ser necesarios para disponer de toda la informaci\\u00f3n necesaria para que Embajada de Espa\\u00f1a en Kinshasa - VISADOS pueda realizar los servicios adecuadamente. En caso de que no sean facilitados todos los datos, no se garantiza que la informaci\\u00f3n y servicios que Embajada de Espa\\u00f1a en Kinshasa - VISADOS le facilite, sean completamente ajustados a sus necesidades.<\\/p><p>&nbsp;<\\/p><p><span style='font-weight: bold;'>Conservaci\\u00f3n:<\\/span> mientras exista un inter\\u00e9s mutuo para ello, en funci\\u00f3n de los plazos legales aplicables.<\\/p><p>&nbsp;<\\/p><p><span style='font-weight: bold;'>Legitimaci\\u00f3n:<\\/span> consentimiento del interesado.<\\/p><p>&nbsp;<\\/p><p><span style='font-weight: bold;'>Destinatarios:<\\/span> los datos no ser\\u00e1n comunicados a terceros, salvo obligaci\\u00f3n legal.<\\/p><p>&nbsp;<\\/p><p><span style='font-weight: bold;'>Derechos:<\\/span> de acceso, rectificaci\\u00f3n y supresi\\u00f3n de sus datos, as\\u00ed como los de limitaci\\u00f3n, portabilidad y oposici\\u00f3n a su tratamiento, dirigiendo escrito firmado y acompa\\u00f1ado de fotocopia de DNI a la siguiente direcci\\u00f3n: Embajada de Espa\\u00f1a en Kinshasa - VISADOS, https:\\/\\/www.exteriores.gob.es\\/Embajadas\\/kinshasa\\/es\\/Paginas\\/index.aspx,  Kinshasa (Congo), indicando en el sobre (Protecci\\u00f3n de Datos) o enviando un mensaje al correo electr\\u00f3nico de contacto de Embajada de Espa\\u00f1a en Kinshasa - VISADOS. Sin menoscabo de lo aqu\\u00ed expuesto, le informamos que alguna informaci\\u00f3n podr\\u00e1 ser conservada de forma bloqueada por parte de Embajada de Espa\\u00f1a en Kinshasa - VISADOS para el cumplimiento de sus obligaciones legales, tales como responsabilidades contractuales u obligaciones fiscales y tributarias.<\\/p><p>&nbsp;<\\/p><p><span style='font-weight: bold;'>Pol\\u00edtica de Cookies:<\\/span><br \\/>Este sitio web, al igual que la mayor\\u00eda de los sitios en Internet, usa Cookies para mejorar y optimizar la experiencia del Cliente. Informaci\\u00f3n detallada sobre las 'Cookies' que utiliza este sitio web:<\\/p><p>&nbsp;<\\/p><p>Tipo de cookie: ANAL\\u00cdTICAS<br \\/>Descripci\\u00f3n: Estas Cookies recopilan informaci\\u00f3n de tu experiencia de navegaci\\u00f3n en nuestros portales web de forma totalmente an\\u00f3nima. &ndash; Podemos contabilizar el n\\u00famero de visitantes de la p\\u00e1gina o los contenidos m\\u00e1s vistos.<br \\/>Ejemplos de uso:<br \\/>&bull; Podemos saber si el Cliente que est\\u00e1 accediendo es nuevo o repite visita.<br \\/>&bull; Esa informaci\\u00f3n puede ayudarnos a mejorar la navegaci\\u00f3n y darte un mejor servicio.<br \\/>Servicios de terceros: Google Analytics (http:\\/\\/www.google.com\\/intl\\/es\\/policies\\/technologies\\/cookies\\/)<\\/p><p>&nbsp;<\\/p>        <\\/div>\\n    <\\/div>\\n<\\/div><script type='text\\/template' id='idTemTicketClient'>\\n    <% \\n    if(sName.length > 0){ %>\\n        <table cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" style=\\\"margin-left: 15px; margin-right: 15px;\\\">\\n            <tr>\\n                <td style=\\\"font-weight: bold; padding-bottom: 2px; padding-right: 15px; font-size: 13px;\\\">Nombre<\\/td>\\n                <td style=\\\"padding-bottom: 2px; font-size: 13px;\\\"><%= sName %><\\/td>\\n            <\\/tr>\\n        <\\/table>\\n        <\\/br>\\n    <% \\n    } %>\\n        \\n    <% \\n    if(typeof sDocument !== 'undefined' && sDocument.length > 0){ %>\\n        <table cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" style=\\\"margin-left: 15px; margin-right: 15px;\\\">\\n            <tr>\\n                <td style=\\\"font-weight: bold; padding-bottom: 2px; padding-right: 15px; font-size: 13px;\\\">Documento<\\/td>\\n                <td style=\\\"padding-bottom: 2px; font-size: 13px;\\\"><%= sDocument %><\\/td>\\n            <\\/tr>\\n        <\\/table>\\n        <\\/br>\\n    <% \\n    } %>\\n<\\/script>\\n\\n<script type='text\\/template' id='idTemTicketAppointment'>\\n    <table cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" style=\\\"margin-left: 15px; margin-right: 15px;\\\">\\n        <tr>\\n            <td style=\\\"font-weight: bold; padding-bottom: 2px; padding-right: 15px; font-size: 13px;\\\">Fecha<\\/td>\\n            <td style=\\\"padding-bottom: 2px; font-size: 13px;\\\"><%= sDate %><\\/td>\\n        <\\/tr>\\n\\n        <tr>\\n            <td style=\\\"font-weight: bold; padding-bottom: 2px; padding-right: 15px; font-size: 13px;\\\">Agenda<\\/td>\\n            <td style=\\\"padding-bottom: 2px; font-size: 13px;\\\"><%= sAgenda %><\\/td>\\n        <\\/tr>\\n\\n        <tr>\\n            <td style=\\\"font-weight: bold; padding-bottom: 2px; padding-right: 15px; font-size: 13px;\\\">Servicio<\\/td>\\n            <td style=\\\"padding-bottom: 2px; font-size: 13px;\\\"><%= sService %><\\/td>\\n        <\\/tr>\\n        \\n        <% \\n        if(sPeople > 1){ %>\\n            <tr>\\n                <td style=\\\"font-weight: bold; padding-bottom: 2px; padding-right: 15px; font-size: 13px;\\\">Personas<\\/td>\\n                <td style=\\\"padding-bottom: 2px; font-size: 13px;\\\"><%= sPeople %><\\/td>\\n            <\\/tr>\\n        <% \\n        } %>\\n        \\n        <% \\n        if(sLocator.length > 0){ %>\\n            <tr>\\n                <td style=\\\"font-weight: bold; padding-bottom: 2px; padding-right: 15px; font-size: 13px;\\\">Localizador<\\/td>\\n                <td style=\\\"padding-bottom: 2px; font-size: 13px;\\\"><%= sLocator %><\\/td>\\n            <\\/tr>\\n        <% \\n        } %>\\n        \\n        <% \\n        if(typeof sCustomList !== 'undefined' && sCustomList.length > 0){ \\n            _.each(sCustomList, function(custom){ %>\\n                <tr>\\n                    <td style=\\\"font-weight: bold; padding-bottom: 2px; padding-right: 15px; font-size: 13px;\\\"><%= custom.label %><\\/td>\\n                    <td style=\\\"padding-bottom: 2px; font-size: 13px;\\\"><%= custom.value %><\\/td>\\n                <\\/tr>\\n            <%\\n            });\\n        } %>          \\n    <\\/table>\\n    \\n    <\\/br>\\n<\\/script>\\n\\n<script type='text\\/template' id='idTemTicketAppointmentPayment'>\\n    <br\\/>\\n    <table style=\\\"width: 100%; padding-right: 15px;\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\">\\n        <tr>\\n            <td style=\\\"width: 97%; text-align:right; font-weight: bold; padding-bottom: 2px; padding-right: 15px; font-size: 13px;\\\">Importe Total<\\/td>\\n            <td style=\\\"width: 3%; text-align:left; padding-bottom: 2px; font-size: 13px;\\\"><%= sTotal %><\\/td>\\n        <\\/tr>\\n        <tr>\\n            <td style=\\\"width: 97%; text-align:right; font-weight: bold; padding-bottom: 2px; padding-right: 15px; font-size: 13px;\\\">Pagado<\\/td>\\n            <td style=\\\"width: 3%; text-align:left; padding-bottom: 2px; font-size: 13px; \\\"><%= sPaid %><\\/td>\\n        <\\/tr>\\n        <tr>\\n            <td style=\\\"width: 97%; text-align:right; font-weight: bold; padding-bottom: 2px; padding-right: 15px; font-size: 13px;\\\">Pendiente<\\/td>\\n            <td style=\\\"width: 3%; text-align:left; padding-bottom: 2px; font-size: 13px; \\\"><%= sPending %><\\/td>\\n        <\\/tr>\\n    <\\/table>    \\n<\\/script>\\n\\n<script type='text\\/template' id='idTemTicketInfo'>\\n    <div style=\\\"margin-top: 20px; margin-bottom: 2px; margin-left: 15px; margin-right: 15px;\\\">\\n        <span style=\\\"font-weight: bold;\\\">Informaci\\u00f3n<\\/span><br\\/>\\n        <%= sInfo %>\\n    <\\/div>\\n<\\/script>\\n\\n<script type='text\\/template' id='idTemSummaryTicketClient'>\\n    <% \\n    if((sName.length > 0) || (typeof sDocument !== 'undefined' && sDocument.length > 0)){ %>\\n        <table cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" style=\\\"margin-left: 15px; margin-right: 15px;\\\">\\n            <% \\n            if(sName.length > 0){ %>\\n                <tr>\\n                    <td style=\\\"font-weight: bold; font-size: 13px;\\\">Nombre<\\/td>\\n                    <td style=\\\"font-size: 13px; padding-left: 15px;\\\"><%= sName %><\\/td>\\n                <\\/tr>\\n            <%\\n            } \\n\\n            if(typeof sDocument !== 'undefined' && sDocument.length > 0){ %>\\n                <tr>\\n                    <td style=\\\"font-weight: bold; font-size: 13px;\\\">Documento<\\/td>\\n                    <td style=\\\"font-size: 13px; padding-left: 15px;\\\"><%= sDocument %><\\/td>\\n                <\\/tr>        \\n            <%\\n            } %>\\n        <\\/table>\\n    <%\\n    } %>        \\n<\\/script>\\n\\n<script type='text\\/template' id='idTemSummaryTicketAppointment'>\\n    <\\/br>\\n    \\n    <table cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" style=\\\"margin-left: 15px; margin-right: 15px;\\\">\\n        <tr>\\n            <td style=\\\"font-size: 13px;\\\">\\n                <span style=\\\"font-weight: bold;\\\">Fecha<\\/span> <%= sDate %>\\n            <\\/td>\\n            \\n            <td style=\\\"padding-left: 15px; font-size: 13px;\\\">\\n                <span style=\\\"font-weight: bold;\\\">Hora<\\/span> <%= sTime %>\\n            <\\/td>\\n            \\n            <% \\n            if(sLocator.length > 0){ %>\\n                <td style=\\\"padding-left: 15px; font-size: 13px;\\\">\\n                    <span style=\\\"font-weight: bold;\\\">Localizador<\\/span> <%= sLocator %>\\n                <\\/td>\\n            <% \\n            } \\n            \\n            if(sPeople > 1){ %>\\n                <td style=\\\"padding-left: 15px; font-size: 13px;\\\">\\n                    <span style=\\\"font-weight: bold;\\\">Personas<\\/span> <%= sPeople %>\\n                <\\/td>\\n            <% \\n            } %>       \\n            \\n            <% \\n            if(typeof sCustomList !== 'undefined' && sCustomList.length > 0){ \\n                _.each(sCustomList, function(custom){ %>\\n                    <tr>\\n                        <td style=\\\"font-weight: bold; padding-bottom: 2px; padding-right: 15px; font-size: 13px;\\\"><%= custom.label %><\\/td>\\n                        <td style=\\\"padding-bottom: 2px; font-size: 13px;\\\"><%= custom.value %><\\/td>\\n                    <\\/tr>\\n                <%\\n                });\\n            } %>            \\n        <\\/tr>\\n    <\\/table>\\n    \\n    <table cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" style=\\\"margin-left: 15px; margin-right: 15px;\\\">\\n        <tr>\\n            <td style=\\\"font-size: 13px;\\\">\\n                <span style=\\\"font-weight: bold;\\\">Agenda<\\/span> <%= sAgenda %>\\n            <\\/td>\\n        <\\/tr>\\n    <\\/table>\\n    \\n    <\\/br>\\n    \\n    <table cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" style=\\\"margin-left: 15px; margin-right: 15px;\\\">\\n        <% \\n        _.each(serviceList, function(service){ %>\\n            <tr>\\n                <td style=\\\"font-size: 13px;\\\">\\n                    <span style=\\\"font-weight: bold;\\\"><%= service.title %><\\/span>\\n                        \\n                    <% \\n                    if(service.duration !== null){ %>\\n                        &nbsp;\\u00b7 <%= service.duration %>\\n                    <% \\n                    } %>                        \\n                <\\/td>\\n            <\\/tr>\\n            \\n            <% \\n            if(typeof service.extraList !== 'undefined' && service.extraList.length > 0){\\n                _.each(service.extraList, function(extra){ %>                    \\n                    <tr>\\n                        <td style=\\\"padding-left: 15px; font-size: 13px;\\\">\\n                            <%= extra.title %>\\n\\n                            <% \\n                            if(extra.duration !== null){ %>\\n                                &nbsp;\\u00b7 <%= extra.duration %>\\n                            <% \\n                            } %>                        \\n                        <\\/td>\\n                    <\\/tr>                \\n                <% \\n                });\\n            }\\n        }); %>\\n    <\\/table>\\n<\\/script>\\n\\n<div id=\\\"idBktDefaultTicketContainer\\\" style=\\\"display: none\\\">\\n    <div style=\\\"margin: 30px; display: inline-block; border: 2px dashed #494949; font-family: Arial,Helvetica,Verdana; max-width: 900px;\\\">\\n        <div style=\\\"margin-top: 10px; font-size: 15px;\\\">\\n            <div style=\\\"float: left; width: 102px; height: 34px;\\\">\\n                <img src=\\\"https:\\/\\/www.citaconsular.es\\/images\\/widgets\\/default\\/ticket\\/band.png\\\" alt=\\\"Bookitit\\\" height=\\\"34px\\\" width=\\\"102px\\\" \\/>\\n            <\\/div>\\n\\n            <div style=\\\"border-bottom: 1px solid #494949; height: 34px; line-height: 34px; margin-left: 115px; margin-right: 15px; font-weight: bold;\\\">\\n                Embajada de Espa\\u00f1a en Kinshasa - VISADOS            <\\/div>\\n\\n            <div style=\\\"clear: both\\\"><\\/div>\\n        <\\/div>\\n\\n        <div style=\\\"margin-top: 20px; font-size: 13px; margin-bottom: 30px;\\\">\\n            <div id=\\\"idDivBktDefaultTicketClient\\\"><\\/div>\\n            \\n            <div id=\\\"idDivBktDefaultTicketData\\\"><\\/div>\\n            \\n            <div id=\\\"idDivBktDefaultTicketInfo\\\"><\\/div>\\n        <\\/div>\\n\\n        <div style=\\\"border-top: 2px dashed #494949; font-size: 10px; padding-bottom: 15px; padding-top: 15px;\\\">\\n            <table cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" style=\\\"margin-left: 15px; margin-right: 15px; font-size: 10px;\\\">\\n                <tr>\\n                    <td>\\n                        Si desea cancelar la cita <span id='idSpanBktTicketCreated'><\\/span>, deber\\u00e1 hacerlo al menos 3 d\\u00edas antes del d\\u00eda de visita                    <\\/td>\\n\\n                    <td style=\\\"padding-left: 15px;\\\">\\n                                                    <img src=\\\"https:\\/\\/www.citaconsular.es\\/images\\/widgets\\/default\\/ticket\\/logo.png\\\" alt=\\\"Bookitit\\\" height=\\\"18px\\\" width=\\\"85px\\\" \\/>\\n                                            \\n                    <\\/td>\\n                <\\/tr>\\n            <\\/table>\\n        <\\/div>\\n        \\n<!--        <div style=\\\"border-top: 2px dashed #494949; font-size: 10px; height: 18px; line-height: 18px; padding-bottom: 15px; padding-left: 15px; padding-top: 15px; padding-right: 15px;\\\">\\n            <div style=\\\"float: left;\\\">\\n                Si desea cancelar la cita <span id='idSpanBktTicketCreated'><\\/span>, deber\\u00e1 hacerlo al menos 3 d\\u00edas antes del d\\u00eda de visita            <\\/div>\\n\\n            <div style=\\\"float: right; height: 18px; width: 85px; margin-left: 15px;\\\">\\n                                    <img src=\\\"https:\\/\\/www.citaconsular.es\\/images\\/widgets\\/default\\/ticket\\/logo.png\\\" alt=\\\"Bookitit\\\" height=\\\"18px\\\" width=\\\"85px\\\" \\/>\\n                            <\\/div>\\n\\n            <div style=\\\"clear: both\\\"><\\/div>\\n        <\\/div>-->\\n    <\\/div>\\n<\\/div><div id=\\\"idBktDefaultCancelAppointmentContainer\\\" class=\\\"clsBktDefaultWindow\\\" style=\\\"display:none;\\\">\\n    <div id=\\\"idBktDefaultCancelAppointmentHeader\\\">\\n        <div id=\\\"idBktDefaultCancelAppointmentHeaderCloseContainer\\\">\\n            <div id=\\\"idBktDefaultCancelAppointmentHeaderClose\\\"><\\/div>\\n            \\n            <div class='clsCB'><\\/div>\\n        <\\/div>\\n        \\n        <div id=\\\"idBktDefaultCancelAppointmentHeaderTitle\\\">\\n            Cancelar cita        <\\/div>\\n    <\\/div>\\n    \\n    <div id=\\\"idBktDefaulCancelAppointmentBody\\\">\\n\\n    <\\/div>\\n<\\/div><script type=\\\"text\\/template\\\" id=\\\"idTemAccountLoginInputSelectOption\\\">\\n    <option value='<%= iOptionValue %>'><%= sOptionText %><\\/option>\\n<\\/script>\\n\\n<div id=\\\"idBktDefaultAccountLoginContainer\\\" class=\\\"clsBktDefaultWindow\\\" style=\\\"display:none;\\\">\\n    <div class=\\\"clsDivSubHeader\\\">\\n        <a href=\\\"#services\\\">\\n            <div class=\\\"clsDivSubHeaderBackButton\\\"><\\/div>\\n        <\\/a>\\n        \\n        <div class=\\\"clsDivSubHeaderAccountLogin\\\">\\n            Accede a tu cuenta de usuario  \\n        <\\/div>\\n        \\n        <div class='clsCB'><\\/div>\\n    <\\/div>\\n    \\n    <div id=\\\"idDivBktAccountLoginContainer\\\">\\n        <div id='idBktDefaultAccountLoginErrorContainer' class=\\\"clsBktDefaultErrorContainer\\\" style='display:none'>\\n            <div id=\\\"idDivBktDefaultErrorAccountLoginLoadingData\\\" class=\\\"clsBktDefaultErrorText\\\">\\n                Se ha producido un error al cargar los datos            <\\/div>\\n\\n            <a href='#services'>\\n                <div class='clsDivContinueButton clsDivBackErrorButton clsHPR'>\\n                    Volver                <\\/div>\\n            <\\/a>\\n\\n            <div class='clsCB'><\\/div>\\n        <\\/div>\\n\\n        <div id=\\\"idBktDefaultAccountLoginTextBeforeLoginFields\\\">\\n                    <\\/div>        \\n        \\n        <div id=\\\"idDivBktAccountLoginContent\\\">\\n             <div class=\\\"clsDivBktDefaultAccountLoginHalvedRow\\\">\\n                <div class=\\\"clsDivBktAccountLoginFormInput clsDivBktAccountLoginFormInputLoginType\\\">\\n                    <div class=\\\"clsDivBktAccountLoginFormInputDropAndTextContainer\\\">\\n                        <div class=\\\"clsDivBktAccountLoginFormInputDropAndTextField clsDivBktAccountLoginFormInputDropAndTextFieldSelect\\\">\\n                            <select id=\\\"idSelBktAccountLoginType\\\" onchange=\\\"this.blur()\\\"><\\/select>\\n                        <\\/div>\\n\\n                        <div class=\\\"clsDivBktAccountLoginFormInputDropAndTextField clsDivBktAccountLoginFormInputDropAndTextFieldInput\\\">\\n                            <input id=\\\"idIptBktAccountLoginlogin\\\" type=\\\"text\\\" placeholder=\\\"\\\" name=\\\"login\\\">\\n                        <\\/div>\\n                    <\\/div>\\n                <\\/div>\\n\\n                <div class=\\\"clsDivBktAccountLoginFormInput clsDivBktAccountLoginFormInputLoginPassword\\\">\\n                    <input id=\\\"idIptBktAccountLoginpassword\\\" type=\\\"password\\\" placeholder=\\\"* Contrase\\u00f1a\\\" name=\\\"password\\\">\\n                <\\/div>\\n            <\\/div>\\n            \\n            <div id='idIptBktAccountLoginErrorlogin' class=\\\"clsDivBktDefaultFieldError\\\"><\\/div>\\n    \\n            <div id=\\\"idBktDefaultAccountLoginSubFooterContainer\\\">\\n                <div id=\\\"idBktDefaultAccountLoginConfirmButtonContainer\\\">\\n                    <div id=\\\"idBktDefaultAccountLoginConfirmButton\\\" class=\\\"clsDivContinueButton clsHPR\\\">Acceder<\\/div>\\n                    <div class=\\\"clsCB\\\"><\\/div>\\n                <\\/div>                \\n                \\n                <div class='clsCB'><\\/div>\\n\\n                <a href=\\\"#recoverpassword\\\">\\n                    <div id=\\\"idDivBktAccountLoginRecoveryPassword\\\">\\n                        Recuperar contrase\\u00f1a                    <\\/div>\\n                <\\/a>\\n                \\n                <div class='clsCB'><\\/div>\\n            <\\/div>\\n            \\n            <div id='idBktDefaultAccountLoginErrorDataContainer' class=\\\"clsBktDefaultErrorContainer\\\" style='display:none'>\\n                <div id=\\\"idDivBktDefaultErrorDataAccountLogin\\\" class=\\\"clsBktDefaultErrorText\\\"><\\/div>\\n            <\\/div>\\n        <\\/div>\\n    <\\/div>\\n<\\/div><div id=\\\"idBktDefaultRecoverPasswordContainer\\\" class=\\\"clsBktDefaultWindow\\\" style=\\\"display:none;\\\">\\n    <div class=\\\"clsDivSubHeader\\\">\\n        <a href=\\\"#signinaccount\\\">\\n            <div class=\\\"clsDivSubHeaderBackButton\\\"><\\/div>\\n        <\\/a>\\n        \\n        <div class=\\\"clsDivSubHeaderAccountLogin\\\">\\n            Accede a tu cuenta de usuario  \\n        <\\/div>\\n        \\n        <div class='clsCB'><\\/div>\\n    <\\/div>\\n    \\n    <div id=\\\"idDivBktRecoverPasswordContainer\\\">\\n        <div id='idBktDefaultRecoverPasswordErrorContainer' class=\\\"clsBktDefaultErrorContainer\\\" style='display:none'>\\n            <div id=\\\"idDivBktDefaultErrorRecoverPasswordLoadingData\\\" class=\\\"clsBktDefaultErrorText\\\" style='display:none'>\\n                Hubo un error, por favor int\\u00e9ntelo de nuevo            <\\/div>\\n            \\n            <div id=\\\"idDivBktDefaultErrorRecoverPasswordGeneral\\\" class=\\\"clsBktDefaultErrorText\\\" style='display:none'>\\n                Se ha producido un error al recuperar la contrase\\u00f1a, por favor int\\u00e9ntelo de nuevo            <\\/div>\\n\\n            <a href='#signinaccount'>\\n                <div class='clsDivContinueButton clsDivBackErrorButton clsHPR'>\\n                    Volver                <\\/div>\\n            <\\/a>\\n\\n            <div class='clsCB'><\\/div>\\n        <\\/div>\\n        \\n        <div id='idBktDefaultRecoverPasswordOkContainer' class=\\\"clsBktDefaultOkContainer\\\" style='display:none'>\\n            <div id=\\\"idDivBktDefaultRecoverPasswordOk\\\" class=\\\"clsBktDefaultOkText\\\">\\n                En unos minutos recibir\\u00e1 una nueva contrase\\u00f1a en su correo<br>\\n                Recuerde comprobar la carpeta de Spam o Correo no deseado            <\\/div>\\n\\n            <a href='#services'>\\n                <div class='clsDivContinueButton clsDivBackErrorButton clsHPR'>\\n                    Volver                <\\/div>\\n            <\\/a>\\n\\n            <div class='clsCB'><\\/div>\\n        <\\/div>\\n        \\n        <div id=\\\"idDivBktRecoverPasswordContent\\\">\\n            <div id=\\\"idDivBktRecoverPasswordExplain\\\">\\n                Introduzca el dato solicitado de su cuenta, y recibir\\u00e1 la contrase\\u00f1a en el email asociado a esa cuenta<br>\\n                <span class=\\\"clsOrangeText\\\">Si no la recibe, compruebe su carpeta de spam o correo no deseado<\\/span>\\n            <\\/div>\\n            \\n<!--            <div class=\\\"clsDivBktDefaultRecoverPasswordRow\\\">\\n                <div class=\\\"clsDivBktRecoverPasswordFormInput clsDivBktRecoverPasswordFormInputLoginPassword\\\">\\n                    <input id=\\\"idIptBktRecoverPasswordemail\\\" type=\\\"text\\\" placeholder=\\\"* \\\" name=\\\"email\\\">\\n                <\\/div>\\n                \\n                <div class='clsCB'><\\/div>\\n            <\\/div>-->\\n    \\n            <div id=\\\"idDivBktRecoverPasswordFieldsContainer\\\">\\n                <div id=\\\"idDivBktRecoverPasswordFieldsContent\\\">\\n                    <div class=\\\"clsDivBktRecoverPasswordFormInputContainer\\\">\\n                        <select id=\\\"idSelBktRecoverPasswordField\\\" onchange=\\\"this.blur()\\\" name=\\\"field\\\">\\n                                                                <option value=\\\"document\\\">Pasaporte<\\/option>\\n                                                        <\\/select>\\n                    <\\/div>\\n\\n                    <div class=\\\"clsDivBktRecoverPasswordFormInputContainer\\\">\\n                        <input id=\\\"idIptBktRecoverPasswordemail\\\" type=\\\"text\\\" placeholder=\\\"\\\" name=\\\"email\\\">\\n                    <\\/div>\\n                <\\/div>\\n            <\\/div>\\n\\n            <div id=\\\"idBktDefaultRecoverPasswordSubFooterContainer\\\">\\n                <div id=\\\"idBktDefaultRecoverPasswordConfirmButtonContainer\\\">\\n                    <div id=\\\"idBktDefaultRecoverPasswordConfirmButton\\\" class=\\\"clsDivContinueButton clsHPR\\\">Enviar<\\/div>\\n                    <div class=\\\"clsCB\\\"><\\/div>\\n                <\\/div>                \\n                \\n                <div class='clsCB'><\\/div>\\n            <\\/div>\\n        <\\/div>\\n        \\n        <div id='idBktDefaultRecoverPasswordDataErrorContainer' class=\\\"clsBktDefaultErrorContainer\\\" style='display:none'>\\n            <div id=\\\"idDivBktDefaultDataErrorRecoverPasswordLoadingData\\\" class=\\\"clsBktDefaultDataErrorText\\\"><\\/div>\\n        <\\/div>\\n    <\\/div>\\n<\\/div><script type='text\\/template' id='idTemEventData'>\\n    <div id=\\\"<%= event %>\\\" class=\\\"clsDivBktAccountHistoryContentRow clsDivBktAccountHistoryContainerDataRow\\\">\\n        <div class=\\\"clsDivBktAccountHistoryContentData\\\">\\n            <div class=\\\"clsDivBktAccountHistoryService\\\"><%= title %><\\/div>\\n\\n            <%\\n            if(typeof extraList !== 'undefined' && extraList.length > 0){\\n                _.each(extraList, function(extra){ %>\\n                    <div class=\\\"clsDivBktAccountHistoryExtraService\\\"><%= extra %><\\/div>\\n                <% \\n                });\\n            } %>\\n            \\n            <div class=\\\"clsDivBktAccountHistoryContentDataMobile\\\">\\n                <div class=\\\"clsDivBktAccountHistoryContentDataPrintContainer\\\">\\n                    <% \\n                    if(print == true){ %>\\n                        <div class=\\\"clsDivBktAccountHistoryContentDataPrintIcon\\\"><\\/div>\\n                    <% \\n                    } %>\\n                <\\/div>\\n\\n                <div class=\\\"clsDivBktAccountHistoryContentDataDeleteContainer\\\">\\n                    <% \\n                    if(cancel == true){ %>\\n                        <div class=\\\"clsDivBktAccountHistoryContentDataDeleteIcon\\\"><\\/div>\\n                    <% \\n                    } %>\\n                <\\/div>\\n\\n                <div class=\\\"clsDivBktAccountHistoryContentDataVideocallContainer\\\">\\n                    <% \\n                    if(typeof videocall !== 'undefined' && videocall.length > 0){ %>\\n                        <a href=\\\"<%= videocall %>\\\" target=\\\"_blank\\\"><div class=\\\"clsDivBktAccountHistoryContentDataVideocallIcon\\\"><\\/div><\\/a>\\n                    <% \\n                    } %>\\n                <\\/div>\\n\\n                <div class=\\\"clsDivBktAccountHistoryContentDataPollContainer\\\">\\n                    <% \\n                    if(typeof poll !== 'undefined' && poll.length > 0){ %>\\n                        <a href=\\\"<%= poll %>\\\" target=\\\"_blank\\\"><div class=\\\"clsDivBktAccountHistoryContentDataPollIcon\\\"><\\/div><\\/a>\\n                    <%      \\n                    } %>\\n                <\\/div>\\n\\n                <div class='clsCB'><\\/div>\\n            <\\/div>            \\n        <\\/div>\\n        \\n        <div class=\\\