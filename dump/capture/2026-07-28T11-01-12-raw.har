tChangePasswordSaveMessageOkText\\\" class=\\\"clsTextGreen clsTextBold\\\">Tu contrase\\u00f1a se ha guardado correctamente<\\/div>\\n            <\\/div>\\n\\n             <div id=\\\"idBktChangePasswordSaveMessageFail\\\" style=\\\"display:none;\\\">\\n                <div id=\\\"idBktChangePasswordSaveMessageFailText\\\" class=\\\"clsBktDefaultErrorText\\\">Ha ocurrido un error guardando la contrase\\u00f1a<\\/div>\\n            <\\/div>\\n            \\n            <div id='idBktChangePasswordSaveMessageError'style='display:none'>\\n                <div id=\\\"idBktChangePasswordSaveMessageErrorText\\\" class=\\\"clsBktDefaultErrorText\\\"><\\/div>\\n            <\\/div>            \\n        <\\/form>\\n    <\\/div>\\n    \\n    \\n    \\n    \\n<\\/div><div id=\\\"idBktDefaultRedsysContainer\\\" class=\\\"clsBktDefaultWindow\\\" style=\\\"display:none;\\\">\\n    <div id=\\\"idDivBktRedsysContainer\\\">\\n        <div id='idDivBktDefaultRedsysErrorContainer' class=\\\"clsBktDefaultErrorContainer\\\" style='display:none'>\\n            <div class=\\\"clsBktDefaultErrorText\\\">\\n                Se ha cancelado el pago del servicio            <\\/div>\\n\\n            <a href='#services'>\\n                <div class='clsDivContinueButton clsDivBackErrorButton clsHPR'>\\n                    Volver                <\\/div>\\n            <\\/a>\\n\\n            <div class='clsCB'><\\/div>\\n        <\\/div>\\n        \\n        <div id='idDivBktDefaultRedsysOkContainer' class=\\\"clsBktDefaultErrorContainer\\\" style='display:none'>\\n            <div class=\\\"clsBktDefaultOkText\\\">\\n                El pago del servicio ha sido correcto            <\\/div>\\n        <\\/div>\\n    <\\/div>\\n<\\/div><div id=\\\"idBktDefaultWaitingListSummaryContainer\\\" class=\\\"clsBktDefaultWindow\\\" style=\\\"display:none;\\\">\\n    <div id=\\\"idDivBktWaitingListSummaryContainer\\\">\\n        <div id='idDivBktDefaultWaitingListSummaryErrorContainer' class=\\\"clsBktDe